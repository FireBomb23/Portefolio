---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rodrigo Albuquerque — Portfólio',
  description = 'Portfólio de Rodrigo Albuquerque, estudante de Tecnologias e Design de Multimédia na ESTGV. Sites, apps, mods e 3D.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-PT" data-motion="live">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EDEDEA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/motion/motion.css" />
    <link rel="stylesheet" href="/assets/scenes/scenes.css" />
    <link rel="stylesheet" href="/assets/scenes/letter-bar-floods-the-ground/scene.css" />
    <link rel="stylesheet" href="/assets/moments/word-highlight/moment.css" />
    <link rel="stylesheet" href="/assets/moments/letters-assemble/moment.css" />
    <script is:inline>
      document.documentElement.classList.add('m-enter', 'sc-js', 'mo-js');
      setTimeout(function () {
        document.documentElement.classList.add('m-enter-done', 'sc-safe', 'mo-safe');
      }, 1800);
    </script>
  </head>
  <body id="topo">
    <a
      href="#conteudo-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#0E0E0E] focus:text-[#EDEDEA] mono"
    >
      Saltar para o conteúdo
    </a>

    <slot />

    <script is:inline type="module" src="/assets/motion/motion.js"></script>
    <script is:inline type="module" src="/assets/moments/moments.js"></script>
    <script is:inline type="module" src="/assets/scenes/scenes.js"></script>
  </body>
</html>
