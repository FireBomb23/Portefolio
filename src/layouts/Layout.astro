---
import '../styles/global.css';
import { withBase } from '../utils/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rodrigo Albuquerque — Portfólio',
  description = 'Portfólio de Rodrigo Albuquerque, estudante de Tecnologias e Design de Multimédia na ESTGV. Sites, apps, mods e 3D.',
} = Astro.props;

const basePrefix = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-PT" data-motion="live" data-radius="soft" data-ground="sand" data-base={basePrefix}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="site-kind" content="software" />
    <meta name="page-type" content="software" />
    <meta name="theme-color" content="#070709" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={withBase('/assets/motion/motion.css')} />
    <link rel="stylesheet" href={withBase('/assets/ui/base.css')} />
    <link rel="stylesheet" href={withBase('/assets/ui/cards.css')} />
    <link rel="stylesheet" href={withBase('/assets/diagrams/diagram.css')} />
    <link rel="stylesheet" href={withBase('/assets/icons/icon.css')} />
    <link rel="stylesheet" href={withBase('/assets/scenes/scenes.css')} />
    <link rel="stylesheet" href={withBase('/assets/scenes/fixed-hero-object/scene.css')} />
    <link rel="stylesheet" href={withBase('/assets/scenes/letter-bar-floods-the-ground/scene.css')} />
    <link rel="stylesheet" href={withBase('/assets/scenes/object-through-giant-type/scene.css')} />
    <link rel="stylesheet" href={withBase('/assets/scenes/parts-lock-into-the-whole/scene.css')} />
    <link rel="stylesheet" href={withBase('/assets/moments/word-highlight/moment.css')} />
    <link rel="stylesheet" href={withBase('/assets/moments/letters-assemble/moment.css')} />
    <link rel="stylesheet" href={withBase('/assets/moments/pinned-chapters/moment.css')} />
    <link rel="stylesheet" href={withBase('/assets/moments/cursor-spotlight/moment.css')} />
    <script is:inline>
      document.documentElement.classList.add('m-enter', 'sc-js', 'mo-js');
      setTimeout(function () {
        document.documentElement.classList.add('m-enter-done', 'sc-safe', 'mo-safe');
      }, 1800);
    </script>
  </head>
  <body id="topo">
    <a
      href="#conteudo-principal"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#0E0E0E] focus:text-[#EDEDEA] mono"
    >
      Saltar para o conteúdo
    </a>

    <slot />

    <script is:inline type="module" src={withBase('/assets/motion/motion.js')}></script>
    <script is:inline type="module" src={withBase('/assets/moments/moments.js')}></script>
    <script is:inline type="module" src={withBase('/assets/scenes/scenes.js')}></script>
    <script is:inline type="module">
      const base = document.documentElement.dataset.base || '';

      async function bootTasteKit() {
        try {
          const [{ default: fx }, { default: ui }, { default: dg }] = await Promise.all([
            import(`${base}/assets/effects/fx.js`),
            import(`${base}/assets/ui/ui.js`),
            import(`${base}/assets/diagrams/diagram.js`),
          ]);
          const heroNodes = document.querySelectorAll('[data-fx-hero]');
          for (const el of heroNodes) {
            const id = el.dataset.fxHero;
            if (!id) continue;
            try {
              const palette = el.dataset.fxPalette ? JSON.parse(el.dataset.fxPalette) : fx.readPalette(el);
              const params = el.dataset.fxParams ? JSON.parse(el.dataset.fxParams) : {};
              await fx.mount(el, id, { palette, params, seed: +(el.dataset.fxSeed || 7) });
            } catch (err) {
              console.warn('fx-hero:', err);
            }
          }

          for (const el of document.querySelectorAll('[data-glow]')) {
            let busy = false;
            const lap = async () => {
              if (busy || ui.reduced()) return;
              busy = true;
              try {
                const palette = el.dataset.fxPalette ? JSON.parse(el.dataset.fxPalette) : fx.readPalette(el);
                const params = JSON.parse(el.dataset.glowParams || '{}');
                const c = await fx.mount(el, el.dataset.glow, { palette, params, seed: 2 });
                const r = el.getBoundingClientRect();
                const per = 2 * (r.width + r.height);
                const spd = Math.min(c.params.speed || 400, per / 4);
                await new Promise((res) => setTimeout(res, Math.min(4500, (per / Math.max(40, spd)) * 1000)));
                el.classList.add('is-fading');
                await new Promise((res) => setTimeout(res, 650));
                c.destroy();
              } catch (err) {
                console.warn('glow:', err);
              }
              el.classList.remove('is-fading');
              busy = false;
            };
            el.addEventListener('pointerenter', lap);
            el.addEventListener('focusin', lap);
            fx.load(el.dataset.glow).catch(() => {});
          }

          await Promise.all([
            ui.loadAll(document),
            ui.startAll(document),
            ui.grounds(document, fx),
          ]);
          dg.auto(document);
        } catch (err) {
          console.warn('taste-kit boot:', err);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bootTasteKit, { once: true });
      } else {
        bootTasteKit();
      }
    </script>
  </body>
</html>
