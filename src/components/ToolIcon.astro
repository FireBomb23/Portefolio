---
import { withBase } from '../utils/paths';

interface Props {
  name: string;
  size?: number;
  showLabel?: boolean;
}

const { name, size = 36, showLabel = false } = Astro.props;

const n = name.toLowerCase();

interface IconSpec {
  file: string;
  extra?: string;
}

let spec: IconSpec = { file: 'ui-boxes.svg' };

if (n.includes('java') && !n.includes('script')) spec = { file: 'java.svg' };
else if (n.includes('python')) spec = { file: 'python.svg' };
else if (n.includes('django')) spec = { file: 'django.svg' };
else if (n.includes('typescript')) spec = { file: 'typescript.svg' };
else if (n.includes('javascript') || n === 'js') spec = { file: 'javascript.svg' };
else if (n.includes('html')) spec = { file: 'html.svg' };
else if (n.includes('css')) spec = { file: 'css.svg' };
else if (n.includes('react')) spec = { file: 'react.svg' };
else if (n.includes('vite')) spec = { file: 'vitejs.svg' };
else if (n.includes('flutter')) spec = { file: 'flutter.svg' };
else if (n.includes('dart')) spec = { file: 'dart.svg' };
else if (n.includes('sqlite')) spec = { file: 'sqlite.svg' };
else if (n.includes('postgres') || n.includes('pl/pgsql') || n.includes('sql')) spec = { file: 'postgres.svg' };
else if (n.includes('three') || n.includes('webgl')) spec = { file: 'threejs.svg' };
else if (n.includes('blender')) spec = { file: 'blender.svg' };
else if (n.includes('blockbench') || n.includes('geckolib') || n.includes('neoforge')) spec = { file: 'ui-box.svg' };
else if (n.includes('node') || n.includes('express') || n.includes('sequelize')) spec = { file: 'nodejs.svg' };
else if (n.includes('figma')) spec = { file: 'figma.svg', extra: 'ic-tall' };
else if (n.includes('github')) spec = { file: 'github.svg' };
else if (n.includes('modrinth')) spec = { file: 'modrinth.svg' };
else if (n.includes('curseforge')) spec = { file: 'curseforge.svg' };
else if (n.includes('astro')) spec = { file: 'astro.svg' };
else if (n.includes('tailwind')) spec = { file: 'tailwindcss.svg', extra: 'ic-land' };
---

<span class="inline-flex flex-col items-center gap-1.5 select-none" title={name}>
  <span
    class="ic-tile transition-transform duration-200 hover:-translate-y-0.5"
    style={`--tile:${size}px; --tile-bg:#FFFFFF; --tile-line:rgba(14,14,14,0.12);`}
  >
    <img
      src={withBase(`/assets/icons/${spec.file}`)}
      alt={name}
      width={Math.round(size * 0.6)}
      height={Math.round(size * 0.6)}
      class:list={['ic', spec.extra]}
      loading="lazy"
    />
  </span>

  {showLabel && (
    <span class="text-[11px] leading-tight text-[var(--muted)] text-center max-w-[74px] truncate">
      {name}
    </span>
  )}
</span>
