---
interface Props {
  name: string;
  size?: number;
  showLabel?: boolean;
}

const { name, size = 36, showLabel = false } = Astro.props;

const n = name.toLowerCase();

type IconKind =
  | 'java'
  | 'python'
  | 'django'
  | 'ts'
  | 'js'
  | 'html'
  | 'css'
  | 'react'
  | 'vite'
  | 'flutter'
  | 'dart'
  | 'postgres'
  | 'sqlite'
  | 'threejs'
  | 'blender'
  | 'blockbench'
  | 'node'
  | 'figma'
  | 'default';

let kind: IconKind = 'default';
if (n.includes('java') && !n.includes('script')) kind = 'java';
else if (n.includes('python')) kind = 'python';
else if (n.includes('django')) kind = 'django';
else if (n.includes('typescript')) kind = 'ts';
else if (n.includes('javascript') || n === 'js') kind = 'js';
else if (n.includes('html')) kind = 'html';
else if (n.includes('css')) kind = 'css';
else if (n.includes('react')) kind = 'react';
else if (n.includes('vite')) kind = 'vite';
else if (n.includes('flutter')) kind = 'flutter';
else if (n.includes('dart')) kind = 'dart';
else if (n.includes('sqlite')) kind = 'sqlite';
else if (n.includes('postgres') || n.includes('pl/pgsql') || n.includes('sql')) kind = 'postgres';
else if (n.includes('three') || n.includes('webgl')) kind = 'threejs';
else if (n.includes('blender')) kind = 'blender';
else if (n.includes('blockbench') || n.includes('geckolib') || n.includes('neoforge')) kind = 'blockbench';
else if (n.includes('node') || n.includes('express') || n.includes('sequelize')) kind = 'node';
else if (n.includes('figma')) kind = 'figma';

const bgMap: Record<IconKind, string> = {
  java: '#151518',
  python: '#111827',
  django: '#092E20',
  ts: '#3178C6',
  js: '#F7DF1E',
  html: '#E34F26',
  css: '#1572B6',
  react: '#0B132B',
  vite: '#1E1B4B',
  flutter: '#071A2F',
  dart: '#01579B',
  postgres: '#102338',
  sqlite: '#0C3547',
  threejs: '#0E0E0E',
  blender: '#1F140E',
  blockbench: '#101A24',
  node: '#0F1F14',
  figma: '#18181B',
  default: '#18181B',
};
---

<span
  class="inline-flex flex-col items-center gap-1 select-none"
  title={name}
>
  <span
    class="inline-flex items-center justify-center rounded-lg border border-black/15 shrink-0 transition-transform duration-200 hover:-translate-y-0.5"
    style={`width:${size}px; height:${size}px; background:${bgMap[kind]};`}
  >
    {kind === 'java' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <path d="M12 20c3 .8 7.5.5 9.5-.8-1.4.4-4.8.6-7.8.1-2-.3-3-1.2-1.7-1.9-3.2.8-2.2 2.1 0 2.6z" fill="#5382A1"/>
        <path d="M10.5 23.2c4.4 1.1 10.6.6 12-1.1-1.3.7-6.8 1.2-10.3.3-1.7-.4-2.4-1.1-1.2-1.7-2.6.6-2.2 2 .5 2.5z" fill="#5382A1"/>
        <path d="M17.4 5c1.5 2.2-1.3 4.2-2.2 6-.9 1.8.6 3.1 2.2 4.3-1.6-1.5-.8-2.9.6-4.4 1.3-1.4 2-3.5-.6-5.9z" fill="#F89820"/>
        <path d="M13.5 9.2c1.1 1.6-1 3-1.6 4.3-.6 1.3.4 2.3 1.5 3.1-1.1-1-.5-2 .5-3 .9-1 1.4-2.5-.4-4.4z" fill="#F89820"/>
        <path d="M22.2 17.5c1.6 0 2.4.9 2.4 2 0 1.4-1.5 2.3-3.1 2.3" fill="none" stroke="#5382A1" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    )}

    {kind === 'python' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <path d="M15.8 5c-4.4 0-4.2 1.9-4.2 1.9v2h4.3v.6H9.9S6 9.1 6 14.3c0 5.2 3.3 5 3.3 5h2v-2.4s-.1-3.3 3.2-3.3h5.5s3.1.1 3.1-3V6.9S23.6 5 15.8 5zm-2.3 1.8a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" fill="#3776AB"/>
        <path d="M16.2 27c4.4 0 4.2-1.9 4.2-1.9v-2h-4.3v-.6h6s3.9.4 3.9-4.8c0-5.2-3.3-5-3.3-5h-2v2.4s.1 3.3-3.2 3.3H12s-3.1-.1-3.1 3v3.7S8.4 27 16.2 27zm2.3-1.8a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" fill="#FFD43B"/>
      </svg>
    )}

    {kind === 'django' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <path d="M14.2 6h3.4v14.8c-1.8.3-3 .5-4.4.5-4.1 0-6.2-1.8-6.2-5.4 0-3.4 2.2-5.6 5.7-5.6.6 0 1 .1 1.5.2V6zm0 7.1c-.4-.1-.8-.2-1.3-.2-1.7 0-2.7 1.1-2.7 3 0 1.8 1 2.9 2.7 2.9.4 0 .8 0 1.3-.1v-5.6z" fill="#44B78B"/>
        <path d="M23.5 10.6v7.6c0 2.7-.2 4-.8 5.1-.6 1.1-1.3 1.8-2.9 2.6l-3.1-1.5c1.5-.7 2.3-1.3 2.8-2.3.5-.9.6-2 .6-4.9v-6.6h3.4zM20.1 6h3.4v3.4h-3.4V6z" fill="#44B78B"/>
      </svg>
    )}

    {kind === 'ts' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <path d="M7 14h9.5v2.4h-3.4V26h-2.8v-9.6H7V14zm10.8 8.9c.9.6 2 1 3.1 1 1.2 0 1.9-.5 1.9-1.2 0-.8-.6-1.1-2-1.6-2-.7-3.2-1.7-3.2-3.5 0-2 1.6-3.5 4.2-3.5 1.2 0 2.3.3 3.2.8l-.8 2.2c-.8-.4-1.6-.7-2.4-.7-1 0-1.6.4-1.6 1 0 .7.6 1 2.1 1.6 2.1.8 3.2 1.8 3.2 3.6 0 2.2-1.7 3.7-4.5 3.7-1.4 0-2.7-.4-3.7-1l.5-2.4z" fill="#FFFFFF"/>
      </svg>
    )}

    {kind === 'js' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <path d="M12.5 14v8.2c0 2.6-1.3 4-3.7 4-1.1 0-2-.3-2.8-.9l1.2-2.2c.5.4 1 .7 1.6.7.9 0 1.2-.5 1.2-1.7V14h2.5zm3.3 8.8c.9.7 2.1 1.2 3.3 1.2 1.2 0 1.9-.5 1.9-1.3 0-.8-.6-1.2-2.1-1.7-2-.7-3.3-1.7-3.3-3.6 0-2.1 1.6-3.6 4.2-3.6 1.3 0 2.4.3 3.3.9l-.9 2.2c-.8-.4-1.6-.7-2.4-.7-1 0-1.6.4-1.6 1 0 .7.6 1 2.2 1.6 2.1.8 3.2 1.8 3.2 3.7 0 2.2-1.7 3.7-4.6 3.7-1.4 0-2.8-.4-3.8-1.1l.6-2.3z" fill="#0E0E0E"/>
      </svg>
    )}

    {kind === 'html' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="7,6 25,6 23.2,23.5 16,26 8.8,23.5" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round"/>
        <path d="M11.5 11.5h9l-.4 3.5h-6l.3 2.5h5.2l-.6 4.5-3 1-3-1-.2-2" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}

    {kind === 'css' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="7,6 25,6 23.2,23.5 16,26 8.8,23.5" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round"/>
        <path d="M11 11.5h10l-.8 9.5-4.2 1.5-4.2-1.5-.3-2.5M12 15.8h7.5" fill="none" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    )}

    {kind === 'react' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <circle cx="16" cy="16" r="2.2" fill="#61DAFB"/>
        <g fill="none" stroke="#61DAFB" stroke-width="1.4">
          <ellipse cx="16" cy="16" rx="11" ry="4.2"/>
          <ellipse cx="16" cy="16" rx="11" ry="4.2" transform="rotate(60 16 16)"/>
          <ellipse cx="16" cy="16" rx="11" ry="4.2" transform="rotate(120 16 16)"/>
        </g>
      </svg>
    )}

    {kind === 'vite' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="6,7 26,7 16,26" fill="none" stroke="#BD34FE" stroke-width="2" stroke-linejoin="round"/>
        <polygon points="15,8 21,8 16.5,14.5 20,14.5 13,22 14.8,15.8 11.5,15.8" fill="#FFD43B"/>
      </svg>
    )}

    {kind === 'flutter' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="18,4 7,15 10.5,18.5 25,4" fill="#47C5FB"/>
        <polygon points="18,14 12.2,19.8 15.7,23.3 25,14" fill="#47C5FB"/>
        <polygon points="15.7,23.3 18.5,26.1 25,26.1 19.2,20.3" fill="#00569E"/>
        <polygon points="12.2,19.8 15.7,16.3 19.2,19.8 15.7,23.3" fill="#00B5F8"/>
      </svg>
    )}

    {kind === 'dart' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="9,12 19,6 26,13 24,25 13,25 6,18" fill="#40C4FF"/>
        <polygon points="9,12 19,6 21,19 13,25" fill="#00B0FF"/>
      </svg>
    )}

    {kind === 'postgres' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <ellipse cx="16" cy="9" rx="8.5" ry="3.2" fill="#699ECA"/>
        <path d="M7.5 9v6c0 1.8 3.8 3.2 8.5 3.2s8.5-1.4 8.5-3.2V9c0 1.8-3.8 3.2-8.5 3.2S7.5 10.8 7.5 9z" fill="#336791"/>
        <path d="M7.5 16.5v6c0 1.8 3.8 3.2 8.5 3.2s8.5-1.4 8.5-3.2v-6c0 1.8-3.8 3.2-8.5 3.2s-8.5-1.4-8.5-3.2z" fill="#4A86B8"/>
      </svg>
    )}

    {kind === 'sqlite' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <path d="M9 6h14v20H9z" fill="none" stroke="#7AD3F0" stroke-width="1.8"/>
        <path d="M12 22c2-7 5-12 9-14-3 5-5 10-6 14h-3z" fill="#7AD3F0"/>
      </svg>
    )}

    {kind === 'threejs' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="6,7 26,13 11,26" fill="none" stroke="#FFFFFF" stroke-width="1.6" stroke-linejoin="round"/>
        <polygon points="10,11 21,14.5 13,22" fill="none" stroke="#00F0FF" stroke-width="1.4" stroke-linejoin="round"/>
        <line x1="16" y1="10" x2="12" y2="18" stroke="#FFFFFF" stroke-width="1.2"/>
        <line x1="11" y1="15" x2="21" y2="14.5" stroke="#FFFFFF" stroke-width="1.2"/>
      </svg>
    )}

    {kind === 'blender' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <circle cx="17.5" cy="18" r="7.5" fill="none" stroke="#EA7600" stroke-width="3.2"/>
        <circle cx="17.5" cy="18" r="2.8" fill="#265787"/>
        <path d="M12.5 8l7 4.2M7 13.5l6.8 1.5M8.2 21l4.8-2.2" stroke="#EA7600" stroke-width="3" stroke-linecap="round"/>
      </svg>
    )}

    {kind === 'blockbench' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="16,5 26,10.5 16,16 6,10.5" fill="#5CC4FF"/>
        <polygon points="6,10.5 16,16 16,27 6,21.5" fill="#1E88E5"/>
        <polygon points="26,10.5 16,16 16,27 26,21.5" fill="#1565C0"/>
      </svg>
    )}

    {kind === 'node' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <polygon points="16,4.5 26,10.2 26,21.8 16,27.5 6,21.8 6,10.2" fill="none" stroke="#68A063" stroke-width="2.4"/>
        <polygon points="16,9.5 21.5,12.7 21.5,19.3 16,22.5 10.5,19.3 10.5,12.7" fill="#68A063"/>
      </svg>
    )}

    {kind === 'figma' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <path d="M12.5 5a3.5 3.5 0 0 0 0 7H16V5h-3.5z" fill="#F24E1E"/>
        <path d="M16 5v7h3.5a3.5 3.5 0 1 0 0-7H16z" fill="#FF7262"/>
        <path d="M12.5 12a3.5 3.5 0 0 0 0 7H16v-7h-3.5z" fill="#A259FF"/>
        <circle cx="19.5" cy="15.5" r="3.5" fill="#1ABCFE"/>
        <path d="M12.5 19a3.5 3.5 0 1 0 3.5 3.5V19h-3.5z" fill="#0ACF83"/>
      </svg>
    )}

    {kind === 'default' && (
      <svg viewBox="0 0 32 32" width={Math.round(size * 0.68)} height={Math.round(size * 0.68)} aria-hidden="true">
        <rect x="8" y="8" width="16" height="16" rx="2" fill="none" stroke="#EDEDEA" stroke-width="2"/>
        <circle cx="16" cy="16" r="3" fill="#0047FF"/>
      </svg>
    )}
  </span>

  {showLabel && (
    <span class="text-[10px] leading-tight text-[var(--muted)] text-center max-w-[68px] truncate">
      {name}
    </span>
  )}
</span>
