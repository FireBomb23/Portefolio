---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ToolIcon from './ToolIcon.astro';
import SceneTransition from './SceneTransition.astro';
import { PROFILE } from '../data/portfolio';
import { withBase } from '../utils/paths';

const candidateFiles = ['rodrigo.jpg', 'rodrigo.jpeg', 'rodrigo.png', 'rodrigo.webp'];
const foundFile = candidateFiles.find((name) => existsSync(join(process.cwd(), 'public', name)));
const portraitSrc = foundFile ? withBase(`/${foundFile}`) : null;

const careerSteps = [
  { year: '2026', title: 'Infinity Nova', note: 'Mod Java 21 + site 3D em Three.js (715+ downloads)' },
  { year: '2026', title: 'LabCD', note: 'App Flutter offline-first + Django REST (Lab. Catarina Domingos)' },
  { year: '2025/26', title: 'Cyrix', note: 'Portal NIS2 em React, Express e Django' },
  { year: '2025', title: 'EcoGo', note: 'Identidade, UI Figma e calculadora de CO₂ (ESTGV)' },
];

const personalTools = [
  'Java 21',
  'Python',
  'Django',
  'TypeScript',
  'React',
  'Flutter',
  'PostgreSQL',
  'Three.js',
  'Blender',
  'Figma',
];

const projectPreviews = [
  {
    href: '#projeto-01',
    num: '01',
    title: 'Infinity Nova',
    src: withBase('/infinity-nova/assets/banner.png'),
    alt: 'Banner Infinity Nova em pixel art',
    pixel: true,
  },
  {
    href: '#projeto-03',
    num: '03',
    title: 'Cyrix NIS2',
    src: withBase('/projetos/cyrix/home.png'),
    alt: 'Página inicial da Cyrix Cybersecurity',
    pixel: false,
  },
  {
    href: '#projeto-04',
    num: '04',
    title: 'Mapas UV 64×64',
    src: withBase('/infinity-nova/textures/manopla_3d.png'),
    alt: 'Mapa UV da Manopla 3D',
    pixel: true,
  },
];

const counters = [
  { num: '715+', label: 'Downloads reais do mod no Modrinth e CurseForge' },
  { num: '08', label: 'Modelos 3D do jogo a correr direto no browser' },
  { num: '15', label: 'Tabelas PostgreSQL com histórico clínico no LabCD' },
  { num: '05', label: 'Projetos desenhados e programados de ponta a ponta' },
];

const hubDiagramSpec = JSON.stringify({
  layout: 'hub',
  shape: 'radial',
  types: ['software'],
  alt: 'Stack de Rodrigo Albuquerque ligada em tempo real: React, Django, Flutter, PostgreSQL, Blender, Three.js, Java 21 e Figma.',
  center: { label: 'Rodrigo', icon: 'github' },
  spokes: [
    {
      label: 'Web & API',
      children: [
        { label: 'React', icon: 'react' },
        { label: 'Django', icon: 'django' },
      ],
    },
    {
      label: 'Mobile & BD',
      children: [
        { label: 'Flutter', icon: 'flutter' },
        { label: 'PostgreSQL', icon: 'postgres' },
      ],
    },
    {
      label: '3D WebGL',
      children: [
        { label: 'Blender', icon: 'blender' },
        { label: 'Three.js', icon: 'threejs' },
      ],
    },
    {
      label: 'Mod & UI',
      children: [
        { label: 'Java 21', icon: 'java' },
        { label: 'Figma', icon: 'figma' },
      ],
    },
  ],
});
---

<section id="sobre-mim" data-enter aria-labelledby="hero-nome" class="hero overflow-x-clip">
  <!-- ACT 1A: Full-Screen Dark Hero with Live Shader Canvas & Radial Hub Architecture -->
  <div
    class="world-dark relative isolate min-h-[calc(100svh-56px)] flex items-center pt-20 pb-16 sm:py-20 border-b border-white/10"
    data-fx-hero="aurora-curtains"
    data-fx-seed="19"
    data-fx-palette='{"bg":"#070709","surface":"#121216","ink":"#F2F2EF","muted":"#9A9B9F","accent":"#FF6B2C"}'
    data-fx-params='{"speed":0.22,"calm":0.55,"calmX":0.28,"calmY":0.5,"intensity":0.32}'
  >
    <div class="wrap relative z-10 w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left 6 Columns: Headline, Clear Offer & Primary Actions -->
      <div class="lg:col-span-6 space-y-7">
        <div class="flex flex-wrap items-center gap-3">
          {portraitSrc && (
            <img
              src={portraitSrc}
              alt="Rodrigo Albuquerque"
              width="48"
              height="48"
              class="w-12 h-12 rounded-full object-cover object-[50%_20%] border border-white/25 shrink-0"
            />
          )}
          <div class="inline-flex flex-wrap items-center gap-2.5 mono text-[11px] text-[#E2E2DC]">
            <span class="px-2.5 py-1 border border-white/15 bg-black/50 text-[#FF6B2C] font-medium">
              ESTÁGIO CURRICULAR 2026/27
            </span>
            <span class="text-[#A8AAB3]">3.º ANO L-TDM · ESTGV VISEU</span>
          </div>
        </div>

        <h1 id="hero-nome" class="display text-[clamp(2.75rem,6.4vw,5.75rem)] text-[#F2F2EF]">
          Rodrigo Albuquerque
        </h1>

        <p class="text-base sm:text-lg text-[#D8D8D2] leading-relaxed max-w-[54ch]">
          Desenho interfaces no Figma, modelo peças 3D no Blender e no Blockbench e programo o sistema inteiro — de mods em Java 21 a apps Flutter offline e APIs em Django, Node e PostgreSQL.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="#projetos"
            class="px-5 py-3 bg-[#FF6B2C] text-[#070709] hover:bg-[#FF8149] transition-colors font-semibold text-sm inline-flex items-center gap-2"
          >
            <span>Explorar os 5 projetos</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a
            href={PROFILE.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-3 border border-white/20 bg-black/40 text-[#F2F2EF] hover:border-white/50 transition-colors mono text-xs"
          >
            LinkedIn ↗
          </a>
          <a
            href={withBase(PROFILE.curriculo)}
            class="px-4 py-3 border border-white/20 bg-black/40 text-[#F2F2EF] hover:border-white/50 transition-colors mono text-xs"
          >
            Currículo ↗
          </a>
          <a
            href={PROFILE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-3 border border-white/20 bg-black/40 text-[#F2F2EF] hover:border-white/50 transition-colors mono text-xs"
          >
            GitHub ↗
          </a>
          <a
            href={PROFILE.modrinth}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-3 border border-white/20 bg-black/40 text-[#F2F2EF] hover:border-white/50 transition-colors mono text-xs"
          >
            Modrinth ↗
          </a>
        </div>

        <div class="pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 mono text-xs text-[#9A9B9F]">
          <a href={`mailto:${PROFILE.email}`} class="link text-[#F2F2EF]">{PROFILE.email}</a>
          <span>Viseu, Portugal</span>
        </div>
      </div>

      <!-- Right 6 Columns: Flagship Card + Lit Dusk Shader Panel + Live Radial Hub Diagram -->
      <div class="lg:col-span-6" data-enter-media>
        <article
          class="card"
          data-glow="edge-glow"
          data-glow-params='{"radius":20,"width":1.4,"glow":12,"bloom":0.35,"segment":0.28,"speed":380,"idle":0.25,"wash":0,"fill":1}'
          style="--c-pad: 28px;"
        >
          <div class="flex items-center justify-between gap-3">
            <h3>Sistema completo, sem atalhos</h3>
            <span class="mono text-[11px] text-[#9A9B9F]">@FireBomb23</span>
          </div>
          <p>Do protótipo ao código em produção — Web, Mobile offline-first e 3D.</p>

          <div
            class="panel"
            data-fx="painterly-landscape"
            data-fx-seed="12"
            data-fx-palette='{"bg":"#162030","surface":"#223047","ink":"#F2F2EF","muted":"#A3B1C6","accent":"#E88B44"}'
            data-fx-params='{"blur":1,"brush":0.35,"slope":-0.2,"hillY":0.28,"horizon":0.62,"calm":0.22,"calmX":0.5,"calmY":0.5,"drift":0,"side":1}'
            style="--p-h: 360px; --calm-k: 0%;"
          >
            <div class="dg" data-diagram set:html={`<script type="application/json">${hubDiagramSpec}</script>`}></div>
          </div>
        </article>
      </div>
    </div>
  </div>

  <!-- TRANSIÇÃO 00 → 01: Hero Aurora Dark abre horizonte horizontal para Apresentação Pessoal -->
  <SceneTransition
    id="hero-to-about"
    kind="horizon-slit"
    fromBg="#070709"
    toBg="#F3F3F1"
    accent="#FF6B2C"
    fromInk="#F2F2EF"
    fromMuted="#9A9B9F"
    toInk="#0D131A"
    toMuted="#4A5568"
    fromLabel="00 · ABERTURA"
    toLabel="01 · APRESENTAÇÃO PESSOAL"
    stepNum="00 → 01"
    headline="QUEM ESTÁ POR TRÁS DO CÓDIGO."
    subline="Antes de veres os 5 projetos, deixa-me mostrar-te de onde venho, como trabalho e o que procuro."
    tags={['Viseu · ESTGV', 'Design + Engenharia', 'Estágio 2026/27']}
  />

  <!-- ACT 1B: Cena Específica de Apresentação Pessoal (fixed-hero-object) -->
  <section
    id="apresentacao-pessoal"
    class="sc world-light border-b border-black/10"
    data-big-scene="fixed-hero-object"
    data-big-scene-opts='{"hold": 1.35, "turns": 1}'
    style="--h: 2"
    aria-labelledby="apresentacao-h"
  >
    <div class="sc__stage">
      <div class="fho__object" data-move>
        <div class="rodrigo-dossier-stage">
          <div class="rds__head mono">
            <span>RODRIGO ALBUQUERQUE · @FIREBOMB23</span>
            <span class="rds__badge">VISEU, PT</span>
          </div>

          {portraitSrc ? (
            <div class="rds__portrait">
              <img
                src={portraitSrc}
                alt="Fotografia de Rodrigo Albuquerque"
                class="w-full h-full object-cover object-[50%_22%]"
              />
            </div>
          ) : (
            <div class="rds__rig" aria-hidden="true">
              <svg viewBox="0 0 240 160" class="rds__svg" fill="none">
                <circle cx="120" cy="80" r="64" stroke="rgba(255,255,255,0.12)" stroke-dasharray="4 4" />
                <circle cx="120" cy="80" r="46" stroke="rgba(255,107,44,0.45)" stroke-width="1.2" />
                <line x1="20" y1="80" x2="220" y2="80" stroke="rgba(255,255,255,0.08)" />
                <line x1="120" y1="12" x2="120" y2="148" stroke="rgba(255,255,255,0.08)" />
                <rect x="82" y="48" width="76" height="64" rx="10" fill="#171B26" stroke="rgba(255,255,255,0.22)" />
                <text x="120" y="88" text-anchor="middle" fill="#F2F2EF" font-family="Archivo, sans-serif" font-weight="800" font-size="28" letter-spacing="-1">
                  RA
                </text>
              </svg>
              <div class="rds__coords mono">40.6566° N, 7.9125° W · ESTGV</div>
            </div>
          )}

          <div class="rds__pills">
            <div class="rds__pill mono" data-dossier-pill="0">
              <span>01 · Origem</span>
              <b>Viseu &amp; Mods Java</b>
            </div>
            <div class="rds__pill mono" data-dossier-pill="1">
              <span>02 · Método</span>
              <b>Figma + 3D + Backend</b>
            </div>
            <div class="rds__pill mono" data-dossier-pill="2">
              <span>03 · Futuro</span>
              <b>Estágio 2026/27</b>
            </div>
          </div>

          <div class="rds__foot mono">
            <span>L-TDM · ESTGV (2024—2027)</span>
            <span>715+ DOWNLOADS</span>
          </div>
        </div>
      </div>

      <div class="fho__track">
        <!-- Capítulo 01 (esquerda, objeto à direita) -->
        <article class="fho__panel fho__panel--hero">
          <div class="fho__copy">
            <div class="fho__eyebrow mono">CAPÍTULO PESSOAL 01 / 03 · QUEM SOU</div>
            <h2 id="apresentacao-h" class="display text-[clamp(2.1rem,4vw,3.5rem)] leading-[0.98] text-[var(--ink)]">
              Olá! Sou o Rodrigo.
            </h2>
            <p class="t-lead">
              Estou no 3.º ano de Tecnologias e Design de Multimédia na ESTGV, em Viseu. Comecei por desmontar mods de Minecraft para perceber como funcionavam por dentro e hoje gosto tanto de desenhar um ecrã limpo como de programar o servidor que está por trás.
            </p>
            <dl class="fho__specs">
              <div><dt class="mono text-xs">Base</dt><dd>Viseu, Portugal</dd></div>
              <div><dt class="mono text-xs">Curso</dt><dd>Licenciatura L-TDM · ESTGV</dd></div>
              <div><dt class="mono text-xs">Período</dt><dd>2024 — 2027 (3.º ano)</dd></div>
            </dl>
          </div>
        </article>

        <!-- Capítulo 02 (direita, objeto desliza para a esquerda) -->
        <article class="fho__panel">
          <div class="fho__copy">
            <div class="fho__eyebrow mono">CAPÍTULO PESSOAL 02 / 03 · COMO TRABALHO</div>
            <h3>Do Figma e do Blender até à base de dados.</h3>
            <p>
              Não gosto de ficar só pelo protótipo. Desenho a interface no Figma, modelo e pinto texturas UV no Blender e no Blockbench, e programo o sistema inteiro em Java 21, Flutter, React, Django e PostgreSQL.
            </p>
            <dl class="fho__specs">
              <div><dt class="mono text-xs">Frontend &amp; 3D</dt><dd>React · Astro · Three.js · Blender</dd></div>
              <div><dt class="mono text-xs">Mobile Offline</dt><dd>Flutter · Dart · SQLite</dd></div>
              <div><dt class="mono text-xs">Backend &amp; Mods</dt><dd>Django REST · Node · PostgreSQL · Java 21</dd></div>
            </dl>
          </div>
        </article>

        <!-- Capítulo 03 (esquerda, objeto volta à direita e chão passa a escuro) -->
        <article class="fho__panel is-dark">
          <div class="fho__copy">
            <div class="fho__eyebrow mono" style="color: #FF6B2C;">CAPÍTULO PESSOAL 03 / 03 · O QUE PROCURO</div>
            <h3>Procuro estágio curricular para 2026/27.</h3>
            <p>
              Fora das aulas criei o Infinity Nova — que já passou os 715 downloads no Modrinth e CurseForge — e desenvolvi projetos reais para clínica dentária, cibersegurança NIS2 e sustentabilidade. Quero integrar uma equipa onde possa construir produtos em web, mobile ou 3D.
            </p>
            <dl class="fho__specs">
              <div><dt class="mono text-xs">Disponibilidade</dt><dd>Estágio Curricular 2026/27</dd></div>
              <div><dt class="mono text-xs">Modalidade</dt><dd>Viseu · Híbrido · Remoto</dd></div>
              <div><dt class="mono text-xs">Contacto</dt><dd><a href={`mailto:${PROFILE.email}`} class="link">{PROFILE.email}</a></dd></div>
            </dl>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ACT 1C: Ferramentas Oficiais, Pré-visualizações Reais & Contadores -->
  <div class="world-light py-16 sm:py-24 border-b border-black/10">
    <div class="wrap space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
        <!-- Bento Card 1 (5 cols): Resumo Percurso & Projetos -->
        <article class="card lg:col-span-5 justify-between" style="--c-pad: 32px;">
          <div class="space-y-4">
            <div class="flex items-center justify-between mono text-[11px] text-[#62625D]">
              <span>PERCURSO &amp; MARCOS</span>
              <span>2024—2027</span>
            </div>
            <h3>Quatro entregas principais do laboratório à web</h3>
            <ul class="divide-y divide-black/10">
              {careerSteps.map((step) => (
                <li class="py-2.5 flex items-baseline gap-3 text-sm leading-snug">
                  <span class="mono text-xs font-semibold text-[#0047FF] shrink-0 w-16">{step.year}</span>
                  <span>
                    <strong class="font-semibold text-[#0D131A]">{step.title}</strong> —{' '}
                    <span class="text-[#4A5568]">{step.note}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-5 mt-5 border-t border-black/10 flex flex-wrap items-center justify-between gap-3">
            <span class="mono text-xs text-[#4A5568]">Licenciatura L-TDM · IPV Viseu</span>
            <a href={`mailto:${PROFILE.email}`} class="link mono text-xs font-medium text-[#0047FF]">
              Enviar email ↗
            </a>
          </div>
        </article>

        <!-- Bento Card 2 (7 cols): Official Brand Icons + Lit Grain Panel with Real Project Windows -->
        <article class="card lg:col-span-7 justify-between" style="--c-pad: 32px;">
          <div class="space-y-5">
            <div class="space-y-2">
              <h3>Ferramentas reais que uso nos projetos</h3>
              <p>Sem stacks decorativas: cada projeto abaixo corre sobre estas linguagens, motores 3D e bases de dados.</p>
            </div>

            <div class="grid grid-cols-5 sm:grid-cols-10 gap-3 pt-1">
              {personalTools.map((tool) => (
                <ToolIcon name={tool} size={38} showLabel={true} />
              ))}
            </div>
          </div>

          <!-- Lit Shader Panel holding Real Project Thumbnail Windows -->
          <div
            class="panel panel--inset"
            data-fx="grain-gradient"
            data-fx-seed="31"
            data-fx-palette='{"bg":"#d9ccb7","surface":"#e9e0d2","ink":"#2a2622","muted":"#6f675c","accent":"#a8794a"}'
            data-fx-params='{"speed":0,"grainMotion":0,"calm":0.2,"calmX":0.5,"calmY":0.5,"tint":0.55,"contrast":0.55}'
            style="--p-h: 260px; --calm-k: 0%;"
          >
            <div class="relative z-10 p-5 sm:p-6 grid grid-cols-1 sm:grid-cols-3 gap-4 items-center h-full">
              {projectPreviews.map((item) => (
                <a
                  href={item.href}
                  class="group block bg-white rounded-xl border border-black/10 shadow-sm overflow-hidden transition-transform duration-300 hover:-translate-y-1"
                >
                  <div class="px-3 py-2 border-b border-black/10 flex items-center justify-between mono text-[10px] text-[#0D131A]">
                    <span class="font-semibold">{item.title}</span>
                    <span class="text-[#62625D]">{item.num} ↗</span>
                  </div>
                  <div class="aspect-[16/10] bg-[#0B0C10] overflow-hidden">
                    <img
                      src={item.src}
                      alt={item.alt}
                      class:list={[
                        'w-full h-full object-cover transition-transform duration-500 group-hover:scale-105',
                        item.pixel ? 'pixel' : 'object-top',
                      ]}
                    />
                  </div>
                </a>
              ))}
            </div>
          </div>
        </article>
      </div>

      <!-- 4 Live Counter Stat Cards powered by motion.js [data-m-count] -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {counters.map((c) => (
          <div class="card" style="--c-pad: 24px;">
            <div class="display text-[clamp(2rem,3.4vw,3.15rem)] text-[#0D131A]">
              <span data-m-count>{c.num}</span>
            </div>
            <p class="mt-2 text-xs sm:text-sm text-[#4A5568] leading-snug">{c.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .rodrigo-dossier-stage {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: clamp(18px, 2.2vw, 24px);
    border-radius: 18px;
    background: #101218;
    color: #F2F2EF;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 64px -20px rgba(8, 9, 15, 0.48), 0 0 0 1px rgba(255, 107, 44, 0.18);
  }

  @media (min-width: 768px) {
    .rodrigo-dossier-stage {
      aspect-ratio: 1 / 1;
    }
  }

  .rds__head,
  .rds__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 10px;
    color: #9A9B9F;
  }

  .rds__badge {
    padding: 3px 8px;
    border: 1px solid rgba(255, 107, 44, 0.45);
    color: #FF6B2C;
    font-weight: 600;
  }

  .rds__portrait {
    flex: 1 1 auto;
    min-height: 150px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #08090F;
  }

  .rds__rig {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 12px;
    background: radial-gradient(circle at 50% 45%, rgba(0, 71, 255, 0.16), rgba(8, 9, 15, 0.9) 70%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 10px;
  }

  .rds__svg {
    width: min(100%, 210px);
    height: auto;
  }

  .rds__coords {
    font-size: 10px;
    color: #9A9B9F;
    letter-spacing: 0.06em;
  }

  .rds__pills {
    display: grid;
    gap: 6px;
  }

  @media (min-width: 768px) {
    .rds__pills {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .rds__pill {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding: 6px 8px;
    }
  }

  .rds__pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 7px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 10.5px;
    color: #A8AAB3;
  }

  .rds__pill b {
    font-weight: 600;
    color: #F2F2EF;
  }

  :global([data-big-scene="fixed-hero-object"][data-fho-step="0"]) [data-dossier-pill="0"],
  :global([data-big-scene="fixed-hero-object"][data-fho-step="1"]) [data-dossier-pill="1"],
  :global([data-big-scene="fixed-hero-object"][data-fho-step="2"]) [data-dossier-pill="2"] {
    border-color: rgba(255, 107, 44, 0.68);
    background: rgba(255, 107, 44, 0.14);
    color: #FF6B2C;
