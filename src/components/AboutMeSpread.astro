---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ToolIcon from './ToolIcon.astro';
import { PROFILE } from '../data/portfolio';

const candidateFiles = ['rodrigo.jpg', 'rodrigo.jpeg', 'rodrigo.png', 'rodrigo.webp'];
const foundFile = candidateFiles.find((name) => existsSync(join(process.cwd(), 'public', name)));
const portraitSrc = foundFile ? `/${foundFile}` : null;

const careerSteps = [
  { year: '2026', title: 'Infinity Nova', note: 'Mod Java 21 + site 3D em Three.js (715+ downloads)' },
  { year: '2026', title: 'LabCD', note: 'App Flutter offline-first + Django REST (Lab. Catarina Domingos)' },
  { year: '2025/26', title: 'Cyrix', note: 'Portal NIS2 em React, Express e Django' },
  { year: '2025', title: 'EcoGo', note: 'Identidade, UI Figma e calculadora de CO₂ (ESTGV)' },
];

const personalTools = [
  'Java 21',
  'Python',
  'Django',
  'TypeScript',
  'React',
  'Flutter',
  'PostgreSQL',
  'Three.js',
  'Blender',
  'Figma',
];

const projectPreviews = [
  {
    href: '#projeto-01',
    num: '01',
    title: 'Infinity Nova',
    src: '/infinity-nova/assets/banner.png',
    alt: 'Banner Infinity Nova em pixel art',
    pixel: true,
  },
  {
    href: '#projeto-03',
    num: '03',
    title: 'Cyrix NIS2',
    src: '/projetos/cyrix/home.png',
    alt: 'Página inicial da Cyrix Cybersecurity',
    pixel: false,
  },
  {
    href: '#projeto-04',
    num: '04',
    title: 'Mapas UV 64×64',
    src: '/infinity-nova/textures/manopla_3d.png',
    alt: 'Mapa UV da Manopla 3D',
    pixel: true,
  },
];

const counters = [
  { num: '715+', label: 'Downloads reais do mod no Modrinth e CurseForge' },
  { num: '08', label: 'Modelos 3D do jogo a correr direto no browser' },
  { num: '15', label: 'Tabelas PostgreSQL com histórico clínico no LabCD' },
  { num: '05', label: 'Projetos desenhados e programados de ponta a ponta' },
];

const hubDiagramSpec = JSON.stringify({
  layout: 'hub',
  shape: 'radial',
  types: ['software'],
  alt: 'Stack de Rodrigo Albuquerque ligada em tempo real: React, Django, Flutter, PostgreSQL, Blender, Three.js, Java 21 e Figma.',
  center: { label: 'Rodrigo', icon: 'github' },
  spokes: [
    {
      label: 'Web & API',
      children: [
        { label: 'React', icon: 'react' },
        { label: 'Django', icon: 'django' },
      ],
    },
    {
      label: 'Mobile & BD',
      children: [
        { label: 'Flutter', icon: 'flutter' },
        { label: 'PostgreSQL', icon: 'postgres' },
      ],
    },
    {
      label: '3D WebGL',
      children: [
        { label: 'Blender', icon: 'blender' },
        { label: 'Three.js', icon: 'threejs' },
      ],
    },
    {
      label: 'Mod & UI',
      children: [
        { label: 'Java 21', icon: 'java' },
        { label: 'Figma', icon: 'figma' },
      ],
    },
  ],
});
---

<section id="sobre-mim" data-enter aria-labelledby="hero-nome" class="hero overflow-x-clip">
  <!-- ACT 1A: Full-Screen Dark Hero with Live Shader Canvas & Radial Hub Architecture -->
  <div
    class="world-dark relative isolate min-h-[calc(100svh-56px)] flex items-center pt-20 pb-16 sm:py-20 border-b border-white/10"
    data-fx-hero="aurora-curtains"
    data-fx-seed="19"
    data-fx-palette='{"bg":"#070709","surface":"#121216","ink":"#F2F2EF","muted":"#9A9B9F","accent":"#FF6B2C"}'
    data-fx-params='{"speed":0.22,"calm":0.55,"calmX":0.28,"calmY":0.5,"intensity":0.32}'
  >
    <div class="wrap relative z-10 w-full grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left 6 Columns: Headline, Clear Offer & Primary Actions -->
      <div class="lg:col-span-6 space-y-7">
        <div class="inline-flex flex-wrap items-center gap-2.5 mono text-[11px] text-[#E2E2DC]">
          <span class="px-2.5 py-1 border border-white/15 bg-black/50 text-[#FF6B2C] font-medium">
            ESTÁGIO CURRICULAR 2026/27
          </span>
          <span class="text-[#A8AAB3]">3.º ANO L-TDM · ESTGV VISEU</span>
        </div>

        <h1 id="hero-nome" class="display text-[clamp(2.75rem,6.4vw,5.75rem)] text-[#F2F2EF]">
          Rodrigo Albuquerque
        </h1>

        <p class="text-base sm:text-lg text-[#D8D8D2] leading-relaxed max-w-[54ch]">
          Desenho interfaces no Figma, modelo peças 3D no Blender e no Blockbench e programo o sistema inteiro — de mods em Java 21 a apps Flutter offline e APIs em Django, Node e PostgreSQL.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="#projetos"
            class="px-5 py-3 bg-[#FF6B2C] text-[#070709] hover:bg-[#FF8149] transition-colors font-semibold text-sm inline-flex items-center gap-2"
          >
            <span>Explorar os 5 projetos</span>
            <span aria-hidden="true">↓</span>
          </a>
          <a
            href={PROFILE.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-3 border border-white/20 bg-black/40 text-[#F2F2EF] hover:border-white/50 transition-colors mono text-xs"
          >
            GitHub ↗
          </a>
          <a
            href={PROFILE.modrinth}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-3 border border-white/20 bg-black/40 text-[#F2F2EF] hover:border-white/50 transition-colors mono text-xs"
          >
            Modrinth ↗
          </a>
        </div>

        <div class="pt-3 border-t border-white/10 flex flex-wrap items-center justify-between gap-3 mono text-xs text-[#9A9B9F]">
          <a href={`mailto:${PROFILE.email}`} class="link text-[#F2F2EF]">{PROFILE.email}</a>
          <span>Viseu, Portugal</span>
        </div>
      </div>

      <!-- Right 6 Columns: Flagship Card + Lit Dusk Shader Panel + Live Radial Hub Diagram -->
      <div class="lg:col-span-6" data-enter-media>
        <article
          class="card"
          data-glow="edge-glow"
          data-glow-params='{"radius":20,"width":1.4,"glow":12,"bloom":0.35,"segment":0.28,"speed":380,"idle":0.25,"wash":0,"fill":1}'
          style="--c-pad: 28px;"
        >
          <div class="flex items-center justify-between gap-3">
            <h3>Sistema completo, sem atalhos</h3>
            <span class="mono text-[11px] text-[#9A9B9F]">@FireBomb23</span>
          </div>
          <p>Do protótipo ao código em produção — Web, Mobile offline-first e 3D.</p>

          <div
            class="panel"
            data-fx="painterly-landscape"
            data-fx-seed="12"
            data-fx-palette='{"bg":"#162030","surface":"#223047","ink":"#F2F2EF","muted":"#A3B1C6","accent":"#E88B44"}'
            data-fx-params='{"blur":1,"brush":0.35,"slope":-0.2,"hillY":0.28,"horizon":0.62,"calm":0.22,"calmX":0.5,"calmY":0.5,"drift":0,"side":1}'
            style="--p-h: 360px; --calm-k: 0%;"
          >
            <div class="dg" data-diagram set:html={`<script type="application/json">${hubDiagramSpec}</script>`}></div>
          </div>
        </article>
      </div>
    </div>
  </div>

  <!-- ACT 1B: Light Editorial Bento Board (Bio, Percurso, Official Tools, Real Previews & Counters) -->
  <div class="world-light py-16 sm:py-24 border-b border-black/10">
    <div class="wrap space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
        <!-- Bento Card 1 (5 cols): Quem Sou, Bio, Foto (se fornecida) & Percurso -->
        <article class="card lg:col-span-5 justify-between" style="--c-pad: 32px;">
          <div class="space-y-6">
            {portraitSrc && (
              <div class="aspect-[16/9] overflow-hidden rounded-xl border border-black/10 bg-[#111217]">
                <img
                  src={portraitSrc}
                  alt="Fotografia de Rodrigo Albuquerque"
                  class="w-full h-full object-cover object-top"
                />
              </div>
            )}

            <div class="space-y-3">
              <div class="flex items-center justify-between mono text-[11px] text-[#62625D]">
                <span>ESTGV · VISEU</span>
                <span>2024—2027</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#0D131A]">
                Olá! Sou o Rodrigo.
              </h2>
              <div class="space-y-3 text-[15px] leading-relaxed text-[#2D3748]">
                <p>
                  Estou no 3.º ano de Tecnologias e Design de Multimédia na ESTGV, em Viseu. Comecei por desmontar mods de Minecraft para perceber como funcionavam e hoje gosto tanto de desenhar um ecrã limpo como de programar o servidor que está por trás.
                </p>
                <p>
                  Fora das aulas criei o Infinity Nova — um mod em Java 21 com site 3D em Three.js que já passou os 715 downloads. Procuro estágio para 2026/27 onde possa construir produtos em web, mobile ou 3D.
                </p>
              </div>
            </div>

            <div class="pt-4 border-t border-black/10 space-y-3">
              <div class="mono text-[11px] text-[#62625D]">PERCURSO &amp; PROJETOS</div>
              <ul class="divide-y divide-black/10">
                {careerSteps.map((step) => (
                  <li class="py-2.5 flex items-baseline gap-3 text-sm leading-snug">
                    <span class="mono text-xs font-semibold text-[#0047FF] shrink-0 w-16">{step.year}</span>
                    <span>
                      <strong class="font-semibold text-[#0D131A]">{step.title}</strong> —{' '}
                      <span class="text-[#4A5568]">{step.note}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-5 mt-5 border-t border-black/10 flex flex-wrap items-center justify-between gap-3">
            <span class="mono text-xs text-[#4A5568]">Licenciatura L-TDM · IPV Viseu</span>
            <a href={`mailto:${PROFILE.email}`} class="link mono text-xs font-medium text-[#0047FF]">
              Enviar email ↗
            </a>
          </div>
        </article>

        <!-- Bento Card 2 (7 cols): Official Brand Icons + Lit Grain Panel with Real Project Windows -->
        <article class="card lg:col-span-7 justify-between" style="--c-pad: 32px;">
          <div class="space-y-5">
            <div class="space-y-2">
              <h3>Ferramentas reais que uso nos projetos</h3>
              <p>Sem stacks decorativas: cada projeto abaixo corre sobre estas linguagens, motores 3D e bases de dados.</p>
            </div>

            <div class="grid grid-cols-5 sm:grid-cols-10 gap-3 pt-1">
              {personalTools.map((tool) => (
                <ToolIcon name={tool} size={38} showLabel={true} />
              ))}
            </div>
          </div>

          <!-- Lit Shader Panel holding Real Project Thumbnail Windows -->
          <div
            class="panel panel--inset"
            data-fx="grain-gradient"
            data-fx-seed="31"
            data-fx-palette='{"bg":"#d9ccb7","surface":"#e9e0d2","ink":"#2a2622","muted":"#6f675c","accent":"#a8794a"}'
            data-fx-params='{"speed":0,"grainMotion":0,"calm":0.2,"calmX":0.5,"calmY":0.5,"tint":0.55,"contrast":0.55}'
            style="--p-h: 260px; --calm-k: 0%;"
          >
            <div class="relative z-10 p-5 sm:p-6 grid grid-cols-1 sm:grid-cols-3 gap-4 items-center h-full">
              {projectPreviews.map((item) => (
                <a
                  href={item.href}
                  class="group block bg-white rounded-xl border border-black/10 shadow-sm overflow-hidden transition-transform duration-300 hover:-translate-y-1"
                >
                  <div class="px-3 py-2 border-b border-black/10 flex items-center justify-between mono text-[10px] text-[#0D131A]">
                    <span class="font-semibold">{item.title}</span>
                    <span class="text-[#62625D]">{item.num} ↗</span>
                  </div>
                  <div class="aspect-[16/10] bg-[#0B0C10] overflow-hidden">
                    <img
                      src={item.src}
                      alt={item.alt}
                      class:list={[
                        'w-full h-full object-cover transition-transform duration-500 group-hover:scale-105',
                        item.pixel ? 'pixel' : 'object-top',
                      ]}
                    />
                  </div>
                </a>
              ))}
            </div>
          </div>
        </article>
      </div>

      <!-- 4 Live Counter Stat Cards powered by motion.js [data-m-count] -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {counters.map((c) => (
          <div class="card" style="--c-pad: 24px;">
            <div class="display text-[clamp(2rem,3.4vw,3.15rem)] text-[#0D131A]">
              <span data-m-count>{c.num}</span>
            </div>
            <p class="mt-2 text-xs sm:text-sm text-[#4A5568] leading-snug">{c.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
