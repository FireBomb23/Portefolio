---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ToolIcon from './ToolIcon.astro';
import { PROFILE } from '../data/portfolio';

const candidateFiles = ['rodrigo.jpg', 'rodrigo.jpeg', 'rodrigo.png', 'rodrigo.webp'];
const foundFile = candidateFiles.find((name) => existsSync(join(process.cwd(), 'public', name)));
const portraitSrc = foundFile ? `/${foundFile}` : null;

const focusAreas = [
  { title: 'Sites & APIs', desc: 'React, Astro, Django e Node.js' },
  { title: 'Apps Mobile', desc: 'Flutter e SQLite que funcionam sem rede' },
  { title: '3D no Browser', desc: 'Blender, Blockbench e Three.js' },
  { title: 'Design & Dados', desc: 'Protótipos em Figma e PostgreSQL' },
];

const careerSteps = [
  { year: '2026', title: 'Infinity Nova', note: 'Mod Java 21 + site 3D em Three.js (715+ downloads)' },
  { year: '2026', title: 'LabCD', note: 'App Flutter offline-first para laboratório de próteses' },
  { year: '2025/26', title: 'Cyrix', note: 'Portal NIS2 em React, Express e Django' },
  { year: '2025', title: 'EcoGo', note: 'Identidade, UI Figma e calculadora de CO₂ (ESTGV)' },
];

const polaroids = [
  { src: '/infinity-nova/assets/banner.png', alt: 'Banner pixel-art Infinity Nova', label: '01 Manopla', pixel: true, tilt: '-rotate-2' },
  { src: '/projetos/cyrix/home.png', alt: 'Portal Cyrix Cybersecurity', label: '03 Cyrix', pixel: false, tilt: 'rotate-1' },
  { src: '/infinity-nova/textures/manopla_3d.png', alt: 'Mapa UV Manopla 3D', label: '04 Mapas UV', pixel: true, tilt: '-rotate-1' },
];

const counters = [
  { num: '715+', label: 'Downloads reais do mod no Modrinth e CurseForge' },
  { num: '08', label: 'Modelos 3D do jogo a correr direto no browser' },
  { num: '15', label: 'Tabelas PostgreSQL com histórico clínico no LabCD' },
  { num: '05', label: 'Projetos desenhados e programados de ponta a ponta' },
];

const personalTools = [
  'Java 21',
  'Python',
  'Django',
  'TypeScript',
  'React',
  'Flutter',
  'PostgreSQL',
  'Three.js',
  'Blender',
  'Figma',
];
---

<section id="sobre-mim" data-enter aria-labelledby="hero-nome" class="hero paper-grid pt-6 pb-14 sm:pb-20">
  <div class="wrap space-y-10 sm:space-y-12">
    <!-- Top meta strip -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pb-4 border-b border-[var(--line)] mono text-[var(--muted)]">
      <span>3.º ANO · ESTGV, VISEU</span>
      <span>ESTÁGIO CURRICULAR 2026/27</span>
      <span class="sm:text-right">
        <a href={`mailto:${PROFILE.email}`} class="link text-[var(--ink)]">{PROFILE.email}</a>
      </span>
    </div>

    <!-- Hero headline -->
    <div class="space-y-3">
      <h1 id="hero-nome" class="display text-[clamp(2.25rem,10.5vw,11.5rem)]">
        Rodrigo<br />Albuquerque
      </h1>
      <p class="text-sm sm:text-base text-[var(--ink)]/80 pt-2 max-w-[58ch] leading-relaxed">
        Faço sites, apps mobile e modelos 3D — do protótipo no Figma até à base de dados.
      </p>
    </div>

    <!-- Personal Spread Board -->
    <div class="border border-[var(--line)] bg-[var(--surface)]/55 p-5 sm:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
      <!-- Left Column: Refined Architectural Portrait Frame + Resumo & Links Diretos -->
      <div class="lg:col-span-4 flex flex-col justify-between gap-4">
        <div
          data-enter-media
          data-tilt-card
          class="p-2 border border-[var(--ink)] bg-[var(--bg)] shadow-[0_18px_40px_-15px_rgba(14,14,14,0.22)] will-change-transform"
        >
          <div
            data-photo-slot="public/rodrigo.jpg"
            class="aspect-[4/5] w-full bg-[#111113] text-[#EDEDEA] dark-grid relative overflow-hidden flex flex-col justify-between p-5"
          >
            {portraitSrc ? (
              <img
                src={portraitSrc}
                alt="Fotografia de Rodrigo Albuquerque"
                class="absolute inset-0 w-full h-full object-cover"
              />
            ) : (
              <>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 100 125"
                  class="absolute inset-0 w-full h-full pointer-events-none opacity-30"
                  fill="none"
                  stroke="#EDEDEA"
                  stroke-width="0.4"
                >
                  <line x1="50" y1="0" x2="50" y2="125" stroke-dasharray="2 2" />
                  <line x1="0" y1="62.5" x2="100" y2="62.5" stroke-dasharray="2 2" />
                  <circle cx="50" cy="54" r="24" stroke="#0047FF" stroke-width="0.5" />
                  <circle cx="50" cy="54" r="16" />
                  <path d="M 22 125 C 22 92, 78 92, 78 125" />
                </svg>

                <div class="relative z-10 flex items-center justify-between mono text-[10px] text-[#EDEDEA]/70">
                  <span>40.6566° N, 7.9125° W</span>
                  <span>VISEU, PT</span>
                </div>

                <div class="relative z-10 my-auto text-center select-none">
                  <span class="display text-[clamp(3.25rem,6.5vw,5rem)] text-[#EDEDEA]/95">RA</span>
                </div>
              </>
            )}

            <div class="relative z-10 mt-auto self-start bg-[#EDEDEA] text-[#0E0E0E] px-2.5 py-1 border border-[#0E0E0E] mono text-[10px] font-medium -rotate-1">
              RODRIGO · FIREBOMB23
            </div>
          </div>
        </div>

        <div class="border border-[var(--line)] bg-[var(--bg)] p-4 sm:p-5 space-y-4">
          <dl class="divide-y divide-[var(--line)] text-xs sm:text-sm">
            <div class="pb-2.5 flex items-baseline justify-between gap-3">
              <dt class="mono text-[var(--muted)]">Base</dt>
              <dd class="font-medium text-[var(--ink)] text-right">Viseu, Portugal</dd>
            </div>
            <div class="py-2.5 flex items-baseline justify-between gap-3">
              <dt class="mono text-[var(--muted)]">Curso</dt>
              <dd class="font-medium text-[var(--ink)] text-right">3.º ano L-TDM · ESTGV</dd>
            </div>
            <div class="pt-2.5 flex items-baseline justify-between gap-3">
              <dt class="mono text-[var(--muted)]">Objetivo</dt>
              <dd class="font-medium text-[var(--ink)] text-right">Estágio 2026/27</dd>
            </div>
          </dl>

          <div class="grid grid-cols-3 gap-2 pt-1">
            <a
              href={PROFILE.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-center px-2 py-2 border border-[var(--ink)] bg-[var(--bg)] hover:bg-[var(--ink)] hover:text-[var(--bg)] transition-colors mono text-[11px] font-medium"
            >
              GitHub ↗
            </a>
            <a
              href={PROFILE.modrinth}
              target="_blank"
              rel="noopener noreferrer"
              class="text-center px-2 py-2 border border-[var(--ink)] bg-[var(--bg)] hover:bg-[var(--ink)] hover:text-[var(--bg)] transition-colors mono text-[11px] font-medium"
            >
              Modrinth ↗
            </a>
            <a
              href={`mailto:${PROFILE.email}`}
              class="text-center px-2 py-2 border border-[var(--ink)] bg-[var(--ink)] text-[var(--bg)] hover:bg-[var(--accent)] hover:border-[var(--accent)] transition-colors mono text-[11px] font-medium"
            >
              Email ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Center Column: Bio, Foco & 3 Tilted Polaroid Snapshots -->
      <div class="lg:col-span-4 flex flex-col justify-between gap-7">
        <div class="space-y-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="mono text-[10px] px-2 py-0.5 border border-[var(--ink)] bg-[var(--bg)] -rotate-1">
              VISEU · PORTUGAL
            </span>
            <span class="mono text-[10px] px-2 py-0.5 border border-[var(--ink)] bg-[var(--bg)] rotate-1">
              ESTGV · L-TDM
            </span>
          </div>

          <h2 class="display text-[clamp(1.75rem,3vw,2.75rem)]">
            Sou o Rodrigo.
          </h2>

          <div class="space-y-3 text-sm sm:text-base leading-relaxed text-[var(--ink)]">
            <p>
              Estou no 3.º ano de Tecnologias e Design de Multimédia na ESTGV, em Viseu. Comecei por desmontar mods de Minecraft para perceber como funcionavam e hoje gosto tanto de desenhar um ecrã limpo como de programar o servidor que está por trás.
            </p>
            <p>
              Fora das aulas criei o Infinity Nova — um mod em Java 21 com site 3D em Three.js que já passou os 715 downloads. Procuro estágio curricular para 2026/27 onde possa trabalhar em web, mobile ou 3D.
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-[var(--line)] space-y-2.5">
          <div class="mono text-[var(--muted)]">Foco</div>
          <div class="grid grid-cols-2 gap-3">
            {focusAreas.map((item) => (
              <div class="space-y-0.5">
                <div class="text-sm font-semibold text-[var(--ink)]">{item.title}</div>
                <div class="text-xs text-[var(--muted)] leading-snug">{item.desc}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- 3 Tilted Polaroid Work Snapshots with 3D tilt -->
        <div class="pt-2 px-1 grid grid-cols-3 gap-2.5 sm:gap-3 overflow-hidden sm:overflow-visible">
          {polaroids.map((shot) => (
            <a
              href={shot.label.startsWith('01') ? '#projeto-01' : shot.label.startsWith('03') ? '#projeto-03' : '#projeto-04'}
              data-tilt-card
              class:list={[
                'group block bg-[#F7F6F2] p-1.5 sm:p-2 pb-3 sm:pb-4 border border-[var(--line)] shadow-[0_10px_24px_-10px_rgba(14,14,14,0.18)] will-change-transform',
                shot.tilt,
              ]}
            >
              <div class="aspect-square bg-[#111113] overflow-hidden">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  class:list={['w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', { pixel: shot.pixel }]}
                />
              </div>
              <div class="mono text-[9px] sm:text-[10px] text-[#0E0E0E] pt-1.5 truncate">
                {shot.label}
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column: Percurso, Estudos & Full-Color Tools Grid -->
      <div class="lg:col-span-4 flex flex-col justify-between gap-7 lg:border-l lg:border-[var(--line)] lg:pl-8">
        <div class="space-y-5">
          <div class="space-y-3">
            <div class="mono text-[var(--muted)]">Percurso &amp; Projetos</div>
            <ul class="space-y-2.5">
              {careerSteps.map((step) => (
                <li class="flex items-baseline gap-3 text-sm leading-snug">
                  <span class="mono text-[var(--muted)] shrink-0 w-14">{step.year}</span>
                  <span>
                    <strong class="font-semibold">{step.title}</strong> — <span class="text-[var(--muted)]">{step.note}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-4 border-t border-[var(--line)] space-y-2">
            <div class="flex items-center justify-between mono text-[var(--muted)]">
              <span>Estudos</span>
              <span>PT · EN</span>
            </div>
            <div class="flex items-baseline gap-3 text-sm">
              <span class="mono text-[var(--muted)] shrink-0">2024—2027</span>
              <span>Licenciatura em Tecnologias e Design de Multimédia · ESTGV (IPV)</span>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-[var(--line)] space-y-3">
          <div class="mono text-[var(--muted)]">Ferramentas que uso</div>
          <div class="grid grid-cols-5 gap-2 sm:gap-2.5">
            {personalTools.map((tool) => (
              <ToolIcon name={tool} size={36} showLabel={true} />
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Live 4-Counter Strip powered by motion.js [data-m-count] -->
    <div class="border border-[var(--line)] bg-[var(--line)] grid grid-cols-2 lg:grid-cols-4 gap-[1px]">
      {counters.map((c) => (
        <div class="bg-[var(--bg)] p-5 sm:p-6 space-y-1.5">
          <div class="display text-[clamp(2rem,3.5vw,3.25rem)] text-[var(--ink)]">
            <span data-m-count>{c.num}</span>
          </div>
          <div class="text-xs text-[var(--muted)] leading-snug">{c.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
