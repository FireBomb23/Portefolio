---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ToolIcon from './ToolIcon.astro';
import { PROFILE } from '../data/portfolio';

const candidateFiles = ['rodrigo.jpg', 'rodrigo.jpeg', 'rodrigo.png', 'rodrigo.webp'];
const foundFile = candidateFiles.find((name) => existsSync(join(process.cwd(), 'public', name)));
const portraitSrc = foundFile ? `/${foundFile}` : null;

const focusAreas = [
  { title: 'Sites & APIs', desc: 'React, Astro, Django e Node.js' },
  { title: 'Apps Mobile', desc: 'Flutter e SQLite sem depender de rede' },
  { title: '3D no Browser', desc: 'Blender, Blockbench e Three.js' },
  { title: 'Design & Dados', desc: 'Protótipos em Figma e PostgreSQL' },
];

const careerSteps = [
  { year: '2026', title: 'Infinity Nova', note: 'Mod Java 21 + site 3D em Three.js (715+ downloads)' },
  { year: '2026', title: 'LabCD', note: 'App Flutter offline-first + Django REST (Lab. Catarina Domingos)' },
  { year: '2025/26', title: 'Cyrix', note: 'Portal NIS2 em React, Express e Django' },
  { year: '2025', title: 'EcoGo', note: 'Identidade, UI Figma e calculadora de CO₂ (ESTGV)' },
];

const polaroids = [
  {
    href: '#projeto-01',
    src: '/infinity-nova/assets/banner.png',
    alt: 'Banner pixel-art Infinity Nova',
    label: '01 Manopla',
    pixel: true,
    tilt: '-rotate-2',
  },
  {
    href: '#projeto-03',
    src: '/projetos/cyrix/home.png',
    alt: 'Portal Cyrix Cybersecurity',
    label: '03 Cyrix',
    pixel: false,
    tilt: 'rotate-2',
  },
  {
    href: '#projeto-04',
    src: '/infinity-nova/textures/manopla_3d.png',
    alt: 'Mapa UV Manopla 3D',
    label: '04 Mapa UV',
    pixel: true,
    tilt: '-rotate-1',
  },
  {
    href: '#projeto-04',
    src: '/infinity-nova/textures/tesseract_3d.png',
    alt: 'Mapa UV Tesseract 3D',
    label: '04 Tesseract',
    pixel: true,
    tilt: 'rotate-1',
  },
];

const counters = [
  { num: '715+', label: 'Downloads reais do mod no Modrinth e CurseForge' },
  { num: '08', label: 'Modelos 3D do jogo a correr direto no browser' },
  { num: '15', label: 'Tabelas PostgreSQL com histórico clínico no LabCD' },
  { num: '05', label: 'Projetos desenhados e programados de ponta a ponta' },
];

const personalTools = [
  'Java 21',
  'Python',
  'Django',
  'TypeScript',
  'React',
  'Flutter',
  'PostgreSQL',
  'Three.js',
  'Blender',
  'Figma',
];
---

<section id="sobre-mim" data-enter aria-labelledby="hero-nome" class="hero overflow-x-clip">
  <!-- STAGE 1A: Dark Creative Desk with Floating Artifacts & Parallax -->
  <div
    data-hero-desk
    class="dark-grid text-[#EDEDEA] relative overflow-hidden border-b-2 border-[#0E0E0E] pt-5 pb-16 sm:pb-24"
  >
    <div class="wrap space-y-10 sm:space-y-12">
      <!-- Top Editorial Meta Strip -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pb-4 border-b border-white/10 mono text-[#A8AAB5]">
        <span>3.º ANO L-TDM · ESTGV VISEU</span>
        <span class="sm:text-center text-[#EDEDEA]/90">DISPONÍVEL PARA ESTÁGIO 2026/27</span>
        <span class="sm:text-right">
          <a href={`mailto:${PROFILE.email}`} class="link text-[#EDEDEA]">{PROFILE.email}</a>
        </span>
      </div>

      <!-- 3-Zone Floating Desk Showcase (never overlaps center headline) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-12 gap-6 xl:gap-5 items-center py-2 sm:py-6">
        <!-- Left Floating Artifact Column (Order 2 on mobile, 1 on xl) -->
        <div class="order-2 xl:order-1 xl:col-span-3 space-y-6">
          <a
            href="#projeto-01"
            data-hero-float
            data-float-depth="1.2"
            class="block border border-white/20 bg-[#12131C] p-3 -rotate-2 shadow-[6px_6px_0_#FF4D1C] hover:border-[#00F0FF] transition-colors will-change-transform"
          >
            <div class="flex items-center justify-between mono text-[10px] text-[#F5B82E] pb-2">
              <span>01 · INFINITY NOVA</span>
              <span>715+ DL</span>
            </div>
            <div class="aspect-[16/9] bg-[#08090F] overflow-hidden border border-white/10">
              <img
                src="/infinity-nova/assets/banner.png"
                alt="Banner Manopla do Infinito Infinity Nova"
                class="w-full h-full object-cover pixel"
              />
            </div>
            <div class="pt-2 mono text-[10px] text-[#A8AAB5]">Manopla 3D · Java 21 + Three.js</div>
          </a>

          <a
            href="#projeto-02"
            data-hero-float
            data-float-depth="-1.0"
            class="block border border-white/20 bg-[#11131A] p-3.5 rotate-2 shadow-[6px_6px_0_#0047FF] hover:border-[#0047FF] transition-colors will-change-transform"
          >
            <div class="flex items-center justify-between mono text-[10px] text-[#93C5FD] pb-2 border-b border-white/10">
              <span>02 · STACK &amp; DADOS</span>
              <span>POSTGRE + SQLITE</span>
            </div>
            <div class="pt-2.5 space-y-1.5 mono text-[11px]">
              <div class="flex justify-between text-[#EDEDEA]">
                <span>Java 21</span>
                <span class="text-[#F5B82E]">NeoForge</span>
              </div>
              <div class="flex justify-between text-[#EDEDEA]">
                <span>Django 5.2</span>
                <span class="text-[#34D399]">REST + 2FA</span>
              </div>
              <div class="flex justify-between text-[#EDEDEA]">
                <span>Flutter</span>
                <span class="text-[#60A5FA]">Offline-first</span>
              </div>
              <div class="flex justify-between text-[#EDEDEA]">
                <span>PostgreSQL</span>
                <span class="text-[#FF4D1C]">15 tabelas</span>
              </div>
            </div>
          </a>
        </div>

        <!-- Center Construction-Grid Title Monument (Order 1 on mobile, 2 on xl) -->
        <div class="order-1 sm:col-span-2 xl:order-2 xl:col-span-6 py-4">
          <div class="border border-dashed border-white/20 bg-[#0E0F14]/85 px-5 sm:px-10 py-10 sm:py-14 relative text-center">
            <span aria-hidden="true" class="absolute -top-2.5 -left-1.5 mono text-sm text-[#FF4D1C] select-none">+</span>
            <span aria-hidden="true" class="absolute -top-2.5 -right-1.5 mono text-sm text-[#00F0FF] select-none">+</span>
            <span aria-hidden="true" class="absolute -bottom-2.5 -left-1.5 mono text-sm text-[#00F0FF] select-none">+</span>
            <span aria-hidden="true" class="absolute -bottom-2.5 -right-1.5 mono text-sm text-[#FF4D1C] select-none">+</span>

            <div class="mono text-[11px] text-[#A8AAB5] tracking-wider pb-4">
              PORTFÓLIO 2026 // DESIGN, CÓDIGO &amp; 3D
            </div>

            <h1 id="hero-nome" class="space-y-1">
              <span class="block display text-[clamp(2.5rem,7.2vw,5.75rem)] text-[#EDEDEA]">
                RODRIGO
              </span>
              <span class="inline-block bg-[#EDEDEA] text-[#0E0E0E] px-3 py-1 mono text-[11px] font-semibold -rotate-2 border-2 border-[#0E0E0E] shadow-[4px_4px_0_#FF4D1C] my-1.5">
                FIREBOMB23 · VISEU, PT
              </span>
              <span class="block display text-[clamp(1.65rem,4.1vw,3.75rem)] text-[#FF4D1C]">
                ALBUQUERQUE
              </span>
            </h1>

            <p class="text-sm sm:text-base text-[#EDEDEA]/85 pt-5 max-w-[44ch] mx-auto leading-relaxed">
              Faço sites, apps mobile e modelos 3D — do protótipo no Figma até à base de dados.
            </p>
          </div>
        </div>

        <!-- Right Floating Artifact Column (Order 3) -->
        <div class="order-3 xl:col-span-3 space-y-6">
          <a
            href="#projeto-03"
            data-hero-float
            data-float-depth="0.9"
            class="block border border-white/20 bg-[#0F172A] p-3 rotate-2 shadow-[6px_6px_0_#F59E0B] hover:border-[#F59E0B] transition-colors will-change-transform"
          >
            <div class="flex items-center justify-between mono text-[10px] text-[#FBBF24] pb-2">
              <span>03 · CYRIX NIS2</span>
              <span>ONLINE</span>
            </div>
            <div class="aspect-[16/10] bg-[#020617] overflow-hidden border border-white/10">
              <img
                src="/projetos/cyrix/home.png"
                alt="Portal Cyrix Cybersecurity NIS2"
                class="w-full h-full object-cover object-top"
              />
            </div>
            <div class="pt-2 mono text-[10px] text-[#CBD5E1]">React + Express + Django</div>
          </a>

          <a
            href="#projeto-04"
            data-hero-float
            data-float-depth="-1.25"
            class="block border border-white/20 bg-[#141416] p-3 -rotate-2 shadow-[6px_6px_0_#00F0FF] hover:border-[#00F0FF] transition-colors will-change-transform"
          >
            <div class="flex items-center justify-between mono text-[10px] text-[#00F0FF] pb-2">
              <span>04 · UV &amp; WEBGL</span>
              <span>64×64 PX</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div class="aspect-square bg-[#08090F] border border-white/10 p-1.5 flex items-center justify-center">
                <img
                  src="/infinity-nova/textures/manopla_3d.png"
                  alt="Mapa UV 64x64 da Manopla"
                  class="w-full h-full object-contain pixel"
                />
              </div>
              <div class="aspect-square bg-[#08090F] border border-white/10 p-1.5 flex items-center justify-center">
                <img
                  src="/infinity-nova/textures/tesseract_3d.png"
                  alt="Mapa UV 64x64 do Tesseract"
                  class="w-full h-full object-contain pixel"
                />
              </div>
            </div>
            <div class="pt-2 mono text-[10px] text-[#A8AAB5]">8 Modelos .geo.json no Browser</div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- STAGE 1B: Warm Graph-Paper Editorial Spread -->
  <div
    data-about-board
    class="warm-paper-grid text-[#0E0E0E] py-14 sm:py-22 border-b-2 border-[#0E0E0E]"
  >
    <div class="wrap space-y-10 sm:space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <!-- Left 4 Columns: Die-Cut Polygon Portrait Collage + 4 Fanned Polaroids -->
        <div class="lg:col-span-4 space-y-8">
          <div data-enter-media data-tilt-card class="relative mx-auto max-w-[360px] lg:max-w-none will-change-transform">
            <!-- Vibrant Vermilion Die-Cut Polygon Backing -->
            <div
              aria-hidden="true"
              class="absolute -inset-2.5 bg-[#FF4D1C] border-2 border-[#0E0E0E] -rotate-2"
              style="clip-path: polygon(3% 0%, 98% 2%, 100% 94%, 84% 100%, 0% 97%, 2% 14%);"
            ></div>

            <!-- Main Portrait Card -->
            <div
              data-photo-slot="public/rodrigo.jpg"
              class="relative aspect-[4/5] w-full bg-[#111217] text-[#EDEDEA] dark-grid border-2 border-[#0E0E0E] shadow-[8px_8px_0_#0E0E0E] overflow-hidden flex flex-col justify-between p-5"
            >
              {portraitSrc ? (
                <img
                  src={portraitSrc}
                  alt="Fotografia de Rodrigo Albuquerque"
                  class="absolute inset-0 w-full h-full object-cover"
                />
              ) : (
                <>
                  <!-- Geometric Creator Poster SVG Fallback -->
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 200 250"
                    class="absolute inset-0 w-full h-full pointer-events-none opacity-45"
                    fill="none"
                  >
                    <line x1="100" y1="0" x2="100" y2="250" stroke="#EDEDEA" stroke-width="0.6" stroke-dasharray="4 4" />
                    <line x1="0" y1="112" x2="200" y2="112" stroke="#EDEDEA" stroke-width="0.6" stroke-dasharray="4 4" />
                    <polygon points="100,26 160,60 160,136 100,170 40,136 40,60" stroke="#FF4D1C" stroke-width="1.5" />
                    <circle cx="100" cy="98" r="38" stroke="#00F0FF" stroke-width="1.2" />
                    <path d="M 38 250 C 38 188, 162 188, 162 250" stroke="#EDEDEA" stroke-width="1.4" />
                  </svg>

                  <div class="relative z-10 flex items-center justify-between mono text-[10px] text-[#EDEDEA]/80">
                    <span>40.6566° N, 7.9125° W</span>
                    <span>VISEU, PT</span>
                  </div>

                  <div class="relative z-10 my-auto text-center select-none">
                    <span class="display text-[clamp(3.75rem,7vw,5.5rem)] text-[#EDEDEA]">RA</span>
                    <div class="mono text-[10px] text-[#00F0FF] pt-1">DEV · 3D · MULTIMÉDIA</div>
                  </div>
                </>
              )}

              <div class="relative z-10 mt-auto self-start bg-[#FAF8F2] text-[#0E0E0E] px-2.5 py-1 border-2 border-[#0E0E0E] mono text-[10px] font-semibold -rotate-1">
                RODRIGO · ESTGV VISEU
              </div>
            </div>
          </div>

          <!-- 4 Fanned Polaroid Work Snapshots -->
          <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-3.5 pt-2">
            {polaroids.map((shot) => (
              <a
                href={shot.href}
                data-polaroid-card
                class:list={[
                  'group block bg-[#FAF8F2] p-2 pb-3 border-2 border-[#0E0E0E] shadow-[4px_4px_0_#0E0E0E] hover:rotate-0 hover:-translate-y-1 transition-transform duration-300',
                  shot.tilt,
                ]}
              >
                <div class="aspect-square bg-[#111217] border border-[#0E0E0E]/20 overflow-hidden">
                  <img
                    src={shot.src}
                    alt={shot.alt}
                    class:list={['w-full h-full object-cover transition-transform duration-500 group-hover:scale-105', { pixel: shot.pixel }]}
                  />
                </div>
                <div class="mono text-[11px] font-medium text-[#0E0E0E] pt-1.5">
                  {shot.label}
                </div>
              </a>
            ))}
          </div>
        </div>

        <!-- Right 8 Columns: Greeting, Bio, Colored-Year Timeline, Big Numeral Studies & Tools Bar -->
        <div class="lg:col-span-8 space-y-8">
          <div class="space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span class="mono text-[10px] font-semibold px-2.5 py-1 border-2 border-[#0E0E0E] bg-[#FAF8F2] -rotate-1">
                VISEU · PORTUGAL
              </span>
              <span class="mono text-[10px] font-semibold px-2.5 py-1 border-2 border-[#0E0E0E] bg-[#FAF8F2] rotate-1">
                ESTGV · 3.º ANO L-TDM
              </span>
            </div>

            <h2 class="display text-[clamp(2.25rem,4.8vw,4.5rem)] text-[#0E0E0E]">
              Olá! Sou o <span class="text-[#D9380D]">Rodrigo.</span>
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pt-6 border-t-2 border-[#0E0E0E]">
            <!-- Bio + Quick Facts + Action Buttons -->
            <div class="md:col-span-6 space-y-5 flex flex-col justify-between">
              <div class="space-y-3 text-sm sm:text-base leading-relaxed text-[#0E0E0E]">
                <p>
                  Estou no 3.º ano de Tecnologias e Design de Multimédia na ESTGV, em Viseu. Comecei por desmontar mods de Minecraft para perceber como funcionavam e hoje gosto tanto de desenhar um ecrã limpo como de programar o servidor que está por trás.
                </p>
                <p>
                  Fora das aulas criei o Infinity Nova — um mod em Java 21 com site 3D em Three.js que já passou os 715 downloads. Procuro estágio curricular para 2026/27 onde possa trabalhar em web, mobile ou 3D.
                </p>
              </div>

              <div class="border-2 border-[#0E0E0E] bg-[#FAF8F2] p-4 space-y-4">
                <dl class="divide-y divide-[#0E0E0E]/15 text-xs sm:text-sm">
                  <div class="pb-2 flex items-baseline justify-between gap-3">
                    <dt class="mono text-[#3F3E38]">Base</dt>
                    <dd class="font-semibold text-[#0E0E0E] text-right">Viseu, Portugal</dd>
                  </div>
                  <div class="py-2 flex items-baseline justify-between gap-3">
                    <dt class="mono text-[#3F3E38]">Curso</dt>
                    <dd class="font-semibold text-[#0E0E0E] text-right">3.º ano L-TDM · ESTGV</dd>
                  </div>
                  <div class="pt-2 flex items-baseline justify-between gap-3">
                    <dt class="mono text-[#3F3E38]">Objetivo</dt>
                    <dd class="font-semibold text-[#0E0E0E] text-right">Estágio 2026/27</dd>
                  </div>
                </dl>

                <div class="grid grid-cols-3 gap-2">
                  <a
                    href={PROFILE.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-center px-2 py-2 border-2 border-[#0E0E0E] bg-[#FAF8F2] hover:bg-[#0E0E0E] hover:text-[#FAF8F2] transition-colors mono text-[11px] font-semibold shadow-[2px_2px_0_#0E0E0E]"
                  >
                    GitHub ↗
                  </a>
                  <a
                    href={PROFILE.modrinth}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-center px-2 py-2 border-2 border-[#0E0E0E] bg-[#FAF8F2] hover:bg-[#0E0E0E] hover:text-[#FAF8F2] transition-colors mono text-[11px] font-semibold shadow-[2px_2px_0_#0E0E0E]"
                  >
                    Modrinth ↗
                  </a>
                  <a
                    href={`mailto:${PROFILE.email}`}
                    class="text-center px-2 py-2 border-2 border-[#0E0E0E] bg-[#0E0E0E] text-[#FAF8F2] hover:bg-[#D9380D] transition-colors mono text-[11px] font-semibold shadow-[2px_2px_0_#FF4D1C]"
                  >
                    Email ↗
                  </a>
                </div>
              </div>
            </div>

            <!-- Colored-Year Career Timeline + Big Numeral Studies + Focus -->
            <div class="md:col-span-6 space-y-6">
              <div class="space-y-3">
                <div class="mono text-[#3F3E38] font-medium">PERCURSO &amp; PROJETOS</div>
                <ul class="space-y-3">
                  {careerSteps.map((step) => (
                    <li class="flex items-baseline gap-3 text-sm leading-snug">
                      <span class="mono font-semibold text-[#B92E09] shrink-0 w-16">{step.year}</span>
                      <span>
                        <strong class="font-bold text-[#0E0E0E]">{step.title}</strong> —{' '}
                        <span class="text-[#3F3E38]">{step.note}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-4 border-t border-[#0E0E0E]/20 space-y-1.5">
                <div class="flex items-center justify-between mono text-[#3F3E38]">
                  <span>ESTUDOS</span>
                  <span>PT · EN</span>
                </div>
                <div class="display text-[clamp(1.75rem,3vw,2.5rem)] text-[#0E472B]">2024—2027</div>
                <div class="text-sm font-medium text-[#0E0E0E]">
                  Licenciatura em Tecnologias e Design de Multimédia · ESTGV (IPV)
                </div>
              </div>

              <div class="pt-4 border-t border-[#0E0E0E]/20 space-y-2.5">
                <div class="mono text-[#3F3E38] font-medium">FOCO</div>
                <div class="grid grid-cols-2 gap-3">
                  {focusAreas.map((item) => (
                    <div class="space-y-0.5">
                      <div class="text-sm font-bold text-[#0E0E0E]">▸ {item.title}</div>
                      <div class="text-xs text-[#3F3E38] leading-snug">{item.desc}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Full-Color Tools Bar -->
          <div class="border-2 border-[#0E0E0E] bg-[#FAF8F2] p-5 shadow-[6px_6px_0_#0E0E0E] space-y-3">
            <div class="mono text-[#3F3E38] font-medium">FERRAMENTAS QUE USO NO DIA A DIA</div>
            <div class="grid grid-cols-5 sm:grid-cols-10 gap-3">
              {personalTools.map((tool) => (
                <ToolIcon name={tool} size={38} showLabel={true} />
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Live 4-Counter Strip powered by motion.js [data-m-count] -->
      <div class="border-2 border-[#0E0E0E] bg-[#0E0E0E] grid grid-cols-2 lg:grid-cols-4 gap-[2px] shadow-[8px_8px_0_#FF4D1C]">
        {counters.map((c) => (
          <div class="bg-[#FAF8F2] p-5 sm:p-6 space-y-1.5">
            <div class="display text-[clamp(2rem,3.5vw,3.25rem)] text-[#0E0E0E]">
              <span data-m-count>{c.num}</span>
            </div>
            <div class="text-xs text-[#3F3E38] leading-snug">{c.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
