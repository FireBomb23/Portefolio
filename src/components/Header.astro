---
import BrandMark from './BrandMark.astro';
import { PROFILE } from '../data/portfolio';
---

<header class="sticky top-0 z-40 bg-[var(--bg)]/90 backdrop-blur-md hl-b no-print">
  <div class="mx-auto max-w-[1400px] px-4 sm:px-7">
    <!-- Row 1: 4-column Swiss Index Header -->
    <nav
      aria-label="Navegação principal"
      class="grid grid-cols-2 lg:grid-cols-12 items-center min-h-[52px] gap-3 py-2 text-[12px]"
    >
      <!-- Col 1: Brand -->
      <div class="lg:col-span-3 flex items-center gap-2.5">
        <a href="/" class="inline-flex items-center gap-2.5 min-h-[40px] group">
          <BrandMark size={24} class="transition-transform duration-300 group-hover:rotate-45" />
          <span class="font-semibold tracking-tight text-[var(--ink)]">{PROFILE.displayName}</span>
        </a>
      </div>

      <!-- Col 2: Work -->
      <div class="hidden lg:flex lg:col-span-3 items-center gap-5 text-[var(--ink-secondary)]">
        <a href="/#fragmentos" class="hover:text-[var(--ink)] transition-colors py-2" data-i18n="nav.fragments">Fragmentos</a>
        <a href="/#casos" class="hover:text-[var(--ink)] transition-colors py-2" data-i18n="nav.cases">Casos</a>
      </div>

      <!-- Col 3: Info -->
      <div class="hidden lg:flex lg:col-span-3 items-center gap-5 text-[var(--ink-secondary)]">
        <a href="/#sobre" class="hover:text-[var(--ink)] transition-colors py-2" data-i18n="nav.about">Sobre</a>
        <a href="/#estgv" class="hover:text-[var(--ink)] transition-colors py-2" data-i18n="nav.approach">Percurso</a>
        <a href="/#contacto" class="hover:text-[var(--ink)] transition-colors py-2" data-i18n="nav.contacts">Contactos</a>
      </div>

      <!-- Col 4: Email + Pill -->
      <div class="lg:col-span-3 flex items-center justify-end gap-3">
        <span class="hidden xl:inline font-mono-tech text-[11px] text-[var(--ink-secondary)]">
          {PROFILE.email}
        </span>
        <button
          type="button"
          id="header-copy-email"
          data-email={PROFILE.email}
          class="pill-solid !min-h-[32px] !px-3.5 text-[11px]"
        >
          Email
        </button>
        <button
          type="button"
          id="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menu"
          class="lg:hidden inline-flex items-center justify-center min-h-[40px] min-w-[40px] text-[var(--ink)]"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" d="M4 8h16M4 16h16" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Row 2: Disciplines + Theme & Language Switches -->
    <div class="hidden sm:grid grid-cols-12 items-center py-2 hl-t text-[11px] text-[var(--ink-muted)]">
      <div class="col-span-5 lg:col-span-6 flex items-center gap-4 overflow-hidden">
        <span class="whitespace-nowrap">Fullstack Web</span>
        <span class="whitespace-nowrap">Mobile Flutter</span>
        <span class="whitespace-nowrap">3D &amp; WebGL</span>
        <span class="hidden xl:inline whitespace-nowrap">Game Modding</span>
      </div>
      <div class="col-span-4 lg:col-span-3 hidden lg:flex items-center gap-4 overflow-hidden">
        <span class="whitespace-nowrap">Django</span>
        <span class="whitespace-nowrap">PostgreSQL</span>
        <span class="whitespace-nowrap">React</span>
        <span class="whitespace-nowrap">Figma</span>
      </div>
      <div class="col-span-7 lg:col-span-3 flex items-center justify-end gap-3">
        <!-- Theme Toggle (Light / Dark) -->
        <button
          type="button"
          id="theme-toggle-btn"
          aria-label="Alternar tema claro/escuro"
          class="inline-flex items-center gap-1.5 min-h-[30px] px-2.5 rounded-full hl-all text-[11px] text-[var(--ink-secondary)] hover:text-[var(--ink)] transition-colors cursor-pointer"
        >
          <span id="theme-icon" aria-hidden="true">◐</span>
          <span id="theme-label" class="font-mono-tech text-[10px]">DARK</span>
        </button>

        <!-- Language Switch (PT / EN) -->
        <div
          role="group"
          aria-label="Selecionar idioma"
          class="inline-flex items-center rounded-full hl-all p-0.5 text-[10px] font-mono-tech"
        >
          <button
            type="button"
            data-lang="pt"
            aria-pressed="true"
            class="lang-btn px-2 py-0.5 rounded-full bg-[var(--ink)] text-[var(--bg)] font-semibold cursor-pointer"
          >
            PT
          </button>
          <button
            type="button"
            data-lang="en"
            aria-pressed="false"
            class="lang-btn px-2 py-0.5 rounded-full text-[var(--ink-secondary)] hover:text-[var(--ink)] cursor-pointer"
          >
            EN
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" hidden class="lg:hidden hl-t bg-[var(--bg)] px-5 py-4 space-y-2">
    <div class="flex flex-col">
      <a href="#fragmentos" class="mobile-nav-link py-2.5 text-sm font-medium text-[var(--ink)]" data-i18n="nav.fragments">Fragmentos</a>
      <a href="#casos" class="mobile-nav-link py-2.5 text-sm font-medium text-[var(--ink)]" data-i18n="nav.cases">Casos</a>
      <a href="#sobre" class="mobile-nav-link py-2.5 text-sm font-medium text-[var(--ink)]" data-i18n="nav.about">Sobre</a>
      <a href="#estgv" class="mobile-nav-link py-2.5 text-sm font-medium text-[var(--ink)]" data-i18n="nav.approach">Percurso</a>
      <a href="#contacto" class="mobile-nav-link py-2.5 text-sm font-medium text-[var(--ink)]" data-i18n="nav.contacts">Contactos</a>
    </div>
    <div class="pt-3 hl-t flex items-center justify-between">
      <button
        type="button"
        id="mobile-theme-btn"
        class="pill-outline !min-h-[34px] text-[11px] font-mono-tech"
      >
        ◐ Tema
      </button>
      <div class="flex items-center gap-1 font-mono-tech text-[11px]">
        <button type="button" data-lang="pt" class="lang-btn-mobile px-2.5 py-1 rounded-full bg-[var(--ink)] text-[var(--bg)]">PT</button>
        <button type="button" data-lang="en" class="lang-btn-mobile px-2.5 py-1 rounded-full hl-all text-[var(--ink-secondary)]">EN</button>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  menuBtn?.addEventListener('click', () => {
    const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!expanded));
    if (mobileMenu) mobileMenu.hidden = expanded;
  });

  mobileLinks.forEach((l) => {
    l.addEventListener('click', () => {
      menuBtn?.setAttribute('aria-expanded', 'false');
      if (mobileMenu) mobileMenu.hidden = true;
    });
  });

  // Theme toggle (event-driven)
  const themeBtn = document.getElementById('theme-toggle-btn');
  const mobileThemeBtn = document.getElementById('mobile-theme-btn');
  const themeLabel = document.getElementById('theme-label');

  function syncThemeUI() {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    if (themeLabel) themeLabel.textContent = current.toUpperCase();
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('portfolio-theme', next); } catch {}
    syncThemeUI();
    window.dispatchEvent(new CustomEvent('portfolio:theme-change', { detail: { theme: next } }));
  }

  syncThemeUI();
  themeBtn?.addEventListener('click', toggleTheme);
  mobileThemeBtn?.addEventListener('click', toggleTheme);
</script>
