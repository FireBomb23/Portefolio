---
interface Props {
  initial?: 'manopla' | 'tesseract';
  instanceId?: string;
}

const { initial = 'manopla', instanceId = 'main' } = Astro.props;

const models = [
  { key: 'manopla', label: 'Manopla', icon: '/infinity-nova/textures/manopla.png' },
  { key: 'power_stone', label: 'Power Stone', icon: '/infinity-nova/textures/power_stone.png' },
  { key: 'space_stone', label: 'Space Stone', icon: '/infinity-nova/textures/space_stone.png' },
  { key: 'reality_stone', label: 'Reality Stone', icon: '/infinity-nova/textures/reality_stone.png' },
  { key: 'soul_stone', label: 'Soul Stone', icon: '/infinity-nova/textures/soul_stone.png' },
  { key: 'time_stone', label: 'Time Stone', icon: '/infinity-nova/textures/time_stone.png' },
  { key: 'mind_stone', label: 'Mind Stone', icon: '/infinity-nova/textures/mind_stone.png' },
  { key: 'tesseract', label: 'Tesseract', icon: '/infinity-nova/textures/tesseract.png' },
];
---

<div
  data-viewer-root={instanceId}
  data-initial={initial}
  class="relative w-full h-[min(78vh,760px)] min-h-[420px] select-none"
>
  <div data-viewer-stage class="absolute inset-0 cursor-grab active:cursor-grabbing"></div>

  <div class="pointer-events-none absolute inset-x-0 bottom-5 z-10">
    <div class="wrap flex items-end justify-between gap-4">
      <div
        role="group"
        aria-label="Escolher modelo"
        class="pointer-events-auto flex flex-wrap items-center gap-1.5"
      >
        {models.map((m) => (
          <button
            type="button"
            data-model-btn={m.key}
            aria-label={m.label}
            title={m.label}
            aria-pressed={m.key === initial ? 'true' : 'false'}
            class="w-11 h-11 rounded-none border border-white/15 bg-black/40 hover:border-white/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0047FF] focus-visible:outline-offset-2 flex items-center justify-center transition-colors cursor-pointer"
          >
            <img
              src={m.icon}
              alt=""
              width="24"
              height="24"
              class="w-6 h-6 object-contain pixel"
            />
          </button>
        ))}

        {initial === 'manopla' && (
          <button
            type="button"
            data-snap-btn
            aria-label="Estalar dedos (tecla G)"
            class="h-11 rounded-none border border-white/15 bg-black/40 hover:border-white/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0047FF] focus-visible:outline-offset-2 mono text-white/80 px-3 transition-colors cursor-pointer"
          >
            G · Estalar
          </button>
        )}
      </div>

      <span class="hidden sm:inline mono text-white/60">
        Arrasta para rodar · G para estalar
      </span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    if (window.__novaViewerBootstrapped) return;
    window.__novaViewerBootstrapped = true;

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var existing = document.querySelector('script[data-nova-src="' + src + '"]');
        if (existing) {
          resolve();
          return;
        }
        var s = document.createElement('script');
        s.src = src;
        s.setAttribute('data-nova-src', src);
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function bootAllViewers() {
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js')
        .then(function () {
          return loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js');
        })
        .then(function () {
          return loadScript('/infinity-nova/js/geo_model.js');
        })
        .then(function () {
          return loadScript('/infinity-nova/js/viewer3d.js');
        })
        .then(function () {
          if (typeof window.create3DViewer !== 'function') return;
          var gauntletInstances = [];

          document.querySelectorAll('[data-viewer-root]').forEach(function (root) {
            if (root.getAttribute('data-viewer-ready') === 'true') return;
            root.setAttribute('data-viewer-ready', 'true');

            var stage = root.querySelector('[data-viewer-stage]');
            var initial = root.getAttribute('data-initial') || 'manopla';
            var instance = window.create3DViewer(stage, initial, root);
            if (!instance) return;

            if (initial === 'manopla') {
              gauntletInstances.push(instance);
            }

            root.querySelectorAll('[data-model-btn]').forEach(function (btn) {
              btn.addEventListener('click', function () {
                var key = btn.getAttribute('data-model-btn');
                if (key) instance.selectModel(key);
              });
            });

            var snapBtn = root.querySelector('[data-snap-btn]');
            if (snapBtn) {
              snapBtn.addEventListener('click', function () {
                instance.playSnap();
              });
            }
          });

          if (!window.__novaKeyBound) {
            window.__novaKeyBound = true;
            window.addEventListener('keydown', function (e) {
              var tag = e.target && e.target.tagName ? e.target.tagName.toLowerCase() : '';
              if (tag === 'input' || tag === 'textarea' || (e.target && e.target.isContentEditable)) return;
              if (e.key === 'g' || e.key === 'G') {
                if (gauntletInstances.length > 0) {
                  gauntletInstances[0].playSnap();
                } else if (typeof window.playSnapAnimation === 'function') {
                  window.playSnapAnimation();
                }
              }
            });
          }
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootAllViewers);
    } else {
      bootAllViewers();
    }
  })();
</script>
