---
import { withBase } from '../utils/paths';

interface Props {
  initial?: 'manopla' | 'tesseract';
  instanceId?: string;
  compact?: boolean;
}

const { initial = 'manopla', instanceId = 'main', compact = false } = Astro.props;

const models = [
  { key: 'manopla', label: 'Manopla', icon: withBase('/infinity-nova/textures/manopla.png') },
  { key: 'power_stone', label: 'Power Stone', icon: withBase('/infinity-nova/textures/power_stone.png') },
  { key: 'space_stone', label: 'Space Stone', icon: withBase('/infinity-nova/textures/space_stone.png') },
  { key: 'reality_stone', label: 'Reality Stone', icon: withBase('/infinity-nova/textures/reality_stone.png') },
  { key: 'soul_stone', label: 'Soul Stone', icon: withBase('/infinity-nova/textures/soul_stone.png') },
  { key: 'time_stone', label: 'Time Stone', icon: withBase('/infinity-nova/textures/time_stone.png') },
  { key: 'mind_stone', label: 'Mind Stone', icon: withBase('/infinity-nova/textures/mind_stone.png') },
  { key: 'tesseract', label: 'Tesseract', icon: withBase('/infinity-nova/textures/tesseract.png') },
];
---

<div
  data-viewer-root={instanceId}
  data-initial={initial}
  class:list={[
    'relative w-full select-none',
    compact ? 'h-[460px] sm:h-[580px]' : 'h-[min(78vh,760px)] min-h-[420px]',
  ]}
>
  <div class="pointer-events-none absolute inset-x-0 top-0 z-10 px-3 sm:px-4 py-2.5 flex items-center justify-between gap-2 border-b border-white/10 bg-black/55">
    <span class="mono text-[11px] text-white/95 flex items-center gap-2 min-w-0">
      <span class="w-2 h-2 bg-[#00F0FF] shrink-0 inline-block" aria-hidden="true"></span>
      <span data-active-model-name class="truncate">
        {initial === 'tesseract' ? 'Tesseract · Cubo Cósmico' : 'Manopla do Infinito · 19 bones'}
      </span>
    </span>
    <span class="hidden sm:inline mono text-[11px] text-white/70 shrink-0">
      Arrasta para rodar · WebGL 60 fps
    </span>
  </div>

  <div data-viewer-stage class="absolute inset-0 cursor-grab active:cursor-grabbing"></div>

  <div class="pointer-events-none absolute inset-x-0 bottom-4 z-10">
    <div class:list={[compact ? 'px-4 sm:px-6' : 'wrap', 'flex items-end justify-between gap-3']}>
      <div
        role="group"
        aria-label="Escolher modelo"
        class="pointer-events-auto flex flex-wrap items-center gap-1.5"
      >
        {models.map((m) => (
          <button
            type="button"
            data-model-btn={m.key}
            data-model-title={m.label}
            aria-label={m.label}
            title={m.label}
            aria-pressed={m.key === initial ? 'true' : 'false'}
            class:list={[
              'w-11 h-11 rounded-none border hover:border-white/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0047FF] focus-visible:outline-offset-2 flex items-center justify-center transition-colors cursor-pointer',
              m.key === initial
                ? 'border-[#00F0FF] bg-white/15'
                : 'border-white/20 bg-black/60',
            ]}
          >
            <img
              src={m.icon}
              alt=""
              width="24"
              height="24"
              class="w-6 h-6 object-contain pixel"
            />
          </button>
        ))}

        {initial === 'manopla' && (
          <button
            type="button"
            data-snap-btn
            aria-label="Estalar dedos (tecla G)"
            class="h-11 rounded-none border border-white/20 bg-black/60 hover:border-white/70 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#0047FF] focus-visible:outline-offset-2 mono text-white/90 px-3 transition-colors cursor-pointer"
          >
            G · Estalar
          </button>
        )}
      </div>

      <span class:list={[compact ? 'hidden 2xl:inline' : 'hidden sm:inline', 'mono text-white/70 shrink-0']}>
        {initial === 'manopla' ? 'Clica numa joia · Tecla G' : 'Modelo 3D direto do mod'}
      </span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    if (window.__novaViewerBootstrapped) return;
    window.__novaViewerBootstrapped = true;

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var existing = document.querySelector('script[data-nova-src="' + src + '"]');
        if (existing) {
          resolve();
          return;
        }
        var s = document.createElement('script');
        s.src = src;
        s.setAttribute('data-nova-src', src);
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function bootAllViewers() {
      var base = document.documentElement.dataset.base || '';
      loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js')
        .then(function () {
          return loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js');
        })
        .then(function () {
          return loadScript(base + '/infinity-nova/js/geo_model.js');
        })
        .then(function () {
          return loadScript(base + '/infinity-nova/js/viewer3d.js');
        })
        .then(function () {
          if (typeof window.create3DViewer !== 'function') return;
          var gauntletInstances = [];

          document.querySelectorAll('[data-viewer-root]').forEach(function (root) {
            if (root.getAttribute('data-viewer-ready') === 'true') return;
            root.setAttribute('data-viewer-ready', 'true');

            var stage = root.querySelector('[data-viewer-stage]');
            var initial = root.getAttribute('data-initial') || 'manopla';
            var instance = window.create3DViewer(stage, initial, root);
            if (!instance) return;

            if (initial === 'manopla') {
              gauntletInstances.push(instance);
            }

            var activeLabel = root.querySelector('[data-active-model-name]');
            var modelButtons = root.querySelectorAll('[data-model-btn]');
            modelButtons.forEach(function (btn) {
              btn.addEventListener('click', function () {
                var key = btn.getAttribute('data-model-btn');
                if (key) instance.selectModel(key);
                modelButtons.forEach(function (other) {
                  var isSelected = other === btn;
                  other.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
                  other.classList.toggle('border-[#00F0FF]', isSelected);
                  other.classList.toggle('bg-white/15', isSelected);
                  other.classList.toggle('border-white/20', !isSelected);
                  other.classList.toggle('bg-black/60', !isSelected);
                });
                if (activeLabel) {
                  var title = btn.getAttribute('data-model-title') || key;
                  activeLabel.textContent = title + ' · .geo.json';
                }
              });
            });

            var snapBtn = root.querySelector('[data-snap-btn]');
            if (snapBtn) {
              snapBtn.addEventListener('click', function () {
                instance.playSnap();
              });
            }
          });

          if (!window.__novaKeyBound) {
            window.__novaKeyBound = true;
            window.addEventListener('keydown', function (e) {
              var tag = e.target && e.target.tagName ? e.target.tagName.toLowerCase() : '';
              if (tag === 'input' || tag === 'textarea' || (e.target && e.target.isContentEditable)) return;
              if (e.key === 'g' || e.key === 'G') {
                if (gauntletInstances.length > 0) {
                  gauntletInstances[0].playSnap();
                } else if (typeof window.playSnapAnimation === 'function') {
                  window.playSnapAnimation();
                }
              }
            });
          }
        });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootAllViewers);
    } else {
      bootAllViewers();
    }
  })();
</script>
