---
const slides = [
  {
    badge: 'MC',
    badgeBg: '#0057FF',
    count: '2',
    labelPt: 'Plataformas publicadas',
    labelEn: 'Published platforms',
    sub: 'Modrinth · CurseForge',
    href: '/projetos/infinity-nova',
  },
  {
    badge: 'FS',
    badgeBg: '#18181B',
    count: '5',
    labelPt: 'Projetos end-to-end',
    labelEn: 'End-to-end projects',
    sub: 'Web · Mobile · 3D',
    href: '#casos',
  },
  {
    badge: '3º',
    badgeBg: '#0057FF',
    count: '26/27',
    labelPt: 'Disponível Estágio DAPE',
    labelEn: 'Available Internship',
    sub: 'ESTGV · Viseu',
    href: '#estgv',
  },
];
---

<div
  id="status-widget"
  class="status-widget w-full max-w-[230px] p-3.5 flex flex-col justify-between gap-3 select-none"
  aria-label="Destaques rotativos — pausa ao passar o cursor"
>
  {slides.map((s, idx) => (
    <div
      data-widget-slide={idx}
      class={idx === 0 ? 'space-y-3' : 'hidden space-y-3'}
    >
      <div class="flex items-start justify-between gap-2">
        <span
          class="inline-flex items-center justify-center w-7 h-7 rounded-md text-[10px] font-mono-tech font-bold text-white"
          style={`background:${s.badgeBg}`}
        >
          {s.badge}
        </span>
        <span class="font-extended text-2xl font-bold leading-none text-[var(--ink)]">
          {s.count}
        </span>
      </div>

      <div class="space-y-0.5">
        <div
          class="text-xs font-medium text-[var(--ink)] leading-snug"
          data-pt={s.labelPt}
          data-en={s.labelEn}
        >
          {s.labelPt}
        </div>
        <div class="font-mono-tech text-[10px] text-[var(--ink-muted)]">
          {s.sub}
        </div>
      </div>

      <a
        href={s.href}
        class="inline-flex items-center justify-center w-full min-h-[32px] rounded-full bg-[var(--ink)] text-[var(--bg)] text-[11px] font-semibold hover:opacity-85 transition-opacity"
        data-i18n="widget.details"
      >
        Detalhes
      </a>
    </div>
  ))}

  <div class="flex items-center justify-center gap-1.5 pt-0.5">
    {slides.map((_, idx) => (
      <button
        type="button"
        data-widget-dot={idx}
        aria-label={`Slide ${idx + 1}`}
        class={`h-1.5 rounded-full transition-all cursor-pointer ${
          idx === 0 ? 'w-4 bg-[var(--ink)]' : 'w-1.5 bg-[var(--ink-muted)]/50'
        }`}
      />
    ))}
  </div>
</div>

<script>
  const widget = document.getElementById('status-widget');
  const slideEls = Array.from(document.querySelectorAll<HTMLElement>('[data-widget-slide]'));
  const dotEls = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-widget-dot]'));
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let activeIndex = 0;
  let paused = false;

  function showSlide(index: number) {
    activeIndex = index % slideEls.length;
    slideEls.forEach((el, i) => el.classList.toggle('hidden', i !== activeIndex));
    dotEls.forEach((dot, i) => {
      dot.className = `h-1.5 rounded-full transition-all cursor-pointer ${
        i === activeIndex ? 'w-4 bg-[var(--ink)]' : 'w-1.5 bg-[var(--ink-muted)]/50'
      }`;
    });
  }

  dotEls.forEach((dot, idx) => {
    dot.addEventListener('click', () => showSlide(idx));
  });

  widget?.addEventListener('pointerenter', () => { paused = true; });
  widget?.addEventListener('pointerleave', () => { paused = false; });

  if (!prefersReduced && slideEls.length > 1) {
    window.setInterval(() => {
      if (!paused) showSlide(activeIndex + 1);
    }, 5000);
  }
</script>
