---
interface Fragment {
  slug: string;
  tag: string;
  title: string;
  meta: string;
  kind: 'image' | 'graphic';
  image?: string;
  surface?: 'black' | 'white' | 'cobalt';
  metric?: string;
}

const FRAGMENTS: Fragment[] = [
  { slug: 'infinity-nova', tag: 'THREE.JS', title: 'Infinity Nova', meta: '19 bones · 103 cubes', kind: 'image', image: '/infinity-nova/assets/banner.jpg' },
  { slug: 'labcd', tag: 'FLUTTER', title: 'LabCD Offline', meta: 'SQLite · Kanban', kind: 'graphic', surface: 'white', metric: '3-TIER' },
  { slug: 'labcd', tag: '3D STL', title: 'Intraoral STL', meta: 'Max 100 MB', kind: 'image', image: '/images/labcd.jpg' },
  { slug: 'infinity-nova', tag: 'SECURITY', title: '2FA TOTP', meta: 'Fernet AES-128', kind: 'graphic', surface: 'cobalt', metric: '2FA' },
  { slug: 'cyrix', tag: 'FULLSTACK', title: 'Cyrix Web', meta: 'React + Express', kind: 'image', image: '/images/cyrix.jpg' },
  { slug: 'cg-3d-lab', tag: 'BLENDER', title: 'PBR & Rig', meta: 'Wireframe → PBR', kind: 'image', image: '/images/blender-3d.jpg' },
  { slug: 'ecogo', tag: 'UI / UX', title: 'EcoGo ESTGV', meta: 'Figma + CO₂ Calc', kind: 'image', image: '/images/ecogo.jpg' },
  { slug: 'labcd', tag: 'PL/PGSQL', title: '15 Entidades', meta: 'Triggers & Views', kind: 'graphic', surface: 'black', metric: 'SQL' },
  { slug: 'infinity-nova', tag: 'JAVA 21', title: 'NeoForge 21.1', meta: 'Modrinth · CurseForge', kind: 'graphic', surface: 'white', metric: '1.21.1' },
  { slug: 'cyrix', tag: 'UX TEST', title: 'UEQ Score', meta: 'ProjectBox Case', kind: 'graphic', surface: 'black', metric: 'UEQ' },
  { slug: 'cg-3d-lab', tag: 'WEBGL', title: 'GeckoLib 3D', meta: 'Keyframe Snap', kind: 'graphic', surface: 'cobalt', metric: '60FPS' },
  { slug: 'infinity-nova', tag: 'DJANGO 5.2', title: 'REST API', meta: 'PostgreSQL 18', kind: 'image', image: '/images/hero-visual.jpg' },
];
---

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5 sm:gap-3">
  {FRAGMENTS.map((frag) => (
    <a
      href={`/projetos/${frag.slug}`}
      class={`fragment-tile group aspect-square relative flex flex-col justify-between overflow-hidden ${
        frag.kind === 'image'
          ? 'bg-[#09090B] text-white'
          : frag.surface === 'white'
            ? 'bg-[#F5F5F7] text-[#09090B]'
            : frag.surface === 'cobalt'
              ? 'bg-[#0057FF] text-white'
              : 'bg-[#09090B] text-white'
      }`}
    >
      {frag.kind === 'image' && frag.image ? (
        <>
          <img
            src={frag.image}
            alt={frag.title}
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-black/30" />
        </>
      ) : null}

      <div class="relative z-10 p-3 flex items-center justify-between w-full font-mono-tech text-[9px] tracking-wider opacity-80">
        <span>{frag.tag}</span>
        <span aria-hidden="true">↗</span>
      </div>

      {frag.kind === 'graphic' && frag.metric && (
        <div class="relative z-10 my-auto text-center font-extended text-xl sm:text-2xl font-bold tracking-tight">
          {frag.metric}
        </div>
      )}

      <div class="relative z-10 p-3 space-y-0.5">
        <div class="text-xs font-semibold leading-tight truncate">{frag.title}</div>
        <div class="font-mono-tech text-[9px] opacity-70 truncate">{frag.meta}</div>
      </div>
    </a>
  ))}
</div>
