---
import InfinityNovaViewer3D from './InfinityNovaViewer3D.astro';
import ToolIcon from './ToolIcon.astro';
import type { Project } from '../data/portfolio';
import { withBase } from '../utils/paths';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const ecogoDistances = [3, 8, 15, 25];

function iconBucket(tech: string): string {
  const s = tech.toLowerCase();
  if (s.includes('neoforge') || s.includes('geckolib') || s.includes('blockbench')) return 'blockbench';
  if (s.includes('node') || s.includes('express') || s.includes('sequelize')) return 'node';
  if (s.includes('postgres') || s.includes('pl/pgsql')) return 'postgres';
  if (s.includes('three') || s.includes('webgl')) return 'threejs';
  return s;
}

const uniqueTools: string[] = [];
const seenBuckets = new Set<string>();
for (const tech of project.stack) {
  const b = iconBucket(tech);
  if (!seenBuckets.has(b)) {
    seenBuckets.add(b);
    uniqueTools.push(tech);
  }
}

const novaLanesDiagram = JSON.stringify({
  layout: 'lanes',
  curve: 'curve',
  types: ['gaming', 'software'],
  alt: 'Um único modelo .geo.json feito em Blockbench alimenta o mod Java 21, o visualizador Three.js e o painel Django 2FA.',
  input: { label: 'Blockbench', icon: 'ui:box', sub: '.geo.json' },
  core: { label: 'Geometria 3D', icon: 'ui:layers' },
  lanes: [
    { label: 'Mod Java 21', icon: 'java', sub: 'NeoForge 1.21.1', done: true },
    { label: 'Viewer 3D', icon: 'threejs', sub: 'Three.js WebGL', done: true },
    { label: 'Painel 2FA', icon: 'django', sub: 'Django 5.2 + TOTP', done: true },
  ],
});

const labcdSyncDiagram = JSON.stringify({
  layout: 'sync',
  size: 'band',
  types: ['software'],
  alt: 'A app Flutter guarda tudo em SQLite offline e sincroniza com a API Django REST e PostgreSQL.',
  left: {
    label: 'Flutter + SQLite',
    icon: 'flutter',
    meta: 'offline',
    rows: [
      { label: 'Pedidos locais', meta: 'sem rede' },
      { label: 'Moldes .STL', meta: 'até 100 MB' },
      { label: 'Odontograma', meta: '11–48' },
    ],
  },
  link: { label: 'Django REST', icon: 'django' },
  right: {
    label: 'PostgreSQL',
    icon: 'postgres',
    meta: '15 tabelas',
    rows: [
      { label: 'Triggers audit', meta: 'PL/pgSQL' },
      { label: 'Bancadas', meta: 'Kanban' },
      { label: 'Histórico', meta: 'protegido' },
    ],
  },
});

const cyrixBowtieDiagram = JSON.stringify({
  layout: 'bowtie',
  types: ['software'],
  alt: 'Protótipo Figma e frontend React ligados por JWT e 2FA a duas APIs independentes em Node Express e Django sobre PostgreSQL.',
  sources: [
    { label: 'Protótipo UEQ', icon: 'figma', sub: 'Figma' },
    { label: 'Portal Web', icon: 'react', sub: 'React + Vite' },
    { label: 'Vista Mobile', icon: 'ui:smartphone', sub: 'Responsivo' },
  ],
  core: { label: 'JWT + 2FA', icon: 'ui:lock' },
  targets: [
    { label: 'API Principal', icon: 'nodejs', sub: 'Express MVC' },
    { label: 'API Académica', icon: 'django', sub: 'Django' },
    { label: 'PostgreSQL', icon: 'postgres', sub: 'Base partilhada' },
  ],
});

const cgGridDiagram = JSON.stringify({
  layout: 'grid',
  types: ['tech', 'software'],
  alt: 'Modelos criados em Blender e Blockbench com UVs 64x64 seguem pelo pipeline até ao browser em Three.js WebGL.',
  group: 'Estúdio 3D',
  sources: [
    { label: 'Blender PBR', icon: 'blender' },
    { label: 'Blockbench', icon: 'ui:box' },
    { label: 'Rigging', icon: 'ui:layers' },
    { label: 'Three.js', icon: 'threejs' },
  ],
  stages: [
    { label: 'Modelação UV', icon: 'ui:cpu' },
    { label: 'Texturas 64×64', icon: 'ui:sparkles' },
    { label: 'WebGL 60 fps', icon: 'ui:globe', meta: 'online' },
  ],
});

const ecogoTimelineDiagram = JSON.stringify({
  layout: 'timeline',
  size: 'band',
  types: ['product', 'software'],
  alt: 'Quatro etapas do EcoGo: levantamento no campus, marca, protótipo Figma e calculadora em JavaScript.',
  steps: [
    { label: 'Campus ESTGV', sub: 'Eco-Escolas', icon: 'ui:search' },
    { label: 'Identidade', sub: 'Logo e cores', icon: 'ui:leaf' },
    { label: 'Protótipo', sub: 'Figma UI', icon: 'figma' },
    { label: 'Calculadora CO₂', sub: 'JS tempo real', icon: 'ui:sparkles' },
  ],
});
---

{/* ========================================================================
    PROJETO 01 — INFINITY NOVA (Deep Space · Interactive 3D + Lanes Diagram)
   ======================================================================== */}
{project.slug === 'infinity-nova' && (
  <article id={`projeto-${project.number}`} class="scroll-mt-14 world-space border-t border-white/10 overflow-x-clip">
    <div class="wrap py-20 sm:py-28 space-y-8">
      <!-- Top Split: Editorial Dossier (5) + Live Three.js 3D Arena (7) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <div data-gsap-dossier class="lg:col-span-5">
          <div class="card" style="--c-pad: 32px;">
            <div class="flex flex-wrap items-center justify-between gap-2 mono text-[11px] text-[#9496A1] pb-4 border-b border-white/10">
              <span class="text-[#F5B82E] font-medium">01 / 05 · MOD JAVA 21 &amp; 3D WEB</span>
              <span>MINECRAFT 1.21.1</span>
            </div>

            <div class="space-y-3 pt-5">
              <h2 data-gsap-title class="display text-[clamp(2.25rem,4.4vw,4rem)] text-[#F0F2F5]">
                {project.title}
              </h2>
              <p class="text-base text-[#CBD5E1] leading-snug">{project.oneLiner}</p>
            </div>

            <div class="space-y-4 pt-5 mt-5 border-t border-white/10 text-[15px] leading-relaxed text-[#E2E8F0]">
              <p>{project.about}</p>
              <p class="text-[#CBD5E1]">{project.work}</p>
            </div>

            <div class="flex flex-wrap items-center gap-2.5 pt-6">
              {uniqueTools.map((tech) => (
                <ToolIcon name={tech} size={32} />
              ))}
            </div>

            <div class="flex flex-wrap items-center gap-2.5 pt-6 mt-6 border-t border-white/10">
              {project.links.map((l) => (
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-3.5 py-2 border border-white/20 bg-black/40 hover:border-[#F5B82E] hover:text-[#F5B82E] transition-colors mono text-xs font-medium text-[#F0F2F5]"
                >
                  {l.label} ↗
                </a>
              ))}
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 lg:sticky lg:top-20">
          <div
            data-gsap-stage
            class="card"
            data-glow="edge-glow"
            data-glow-params='{"radius":20,"width":1.4,"glow":12,"bloom":0.35,"segment":0.28,"speed":380,"idle":0.25,"wash":0,"fill":1}'
            style="--c-pad: 8px;"
          >
            <div class="rounded-xl overflow-hidden bg-[#05060A]">
              <InfinityNovaViewer3D initial="manopla" instanceId="nova" compact={true} />
            </div>
          </div>
        </div>
      </div>

      <!-- Bento Feature Pair: Comet-Pulse Architecture Diagram + Lit Mesh Showcase -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <div class="card card--row lg:col-span-6 justify-between" style="--c-pad: 32px;">
          <div>
            <h3>Um ficheiro .geo.json, do jogo até ao browser</h3>
            <p>Os modelos feitos no Blockbench correm no NeoForge em Java 21 e abrem em WebGL via Three.js, geridos num painel Django com 2FA.</p>
          </div>
          <div
            class="panel"
            data-fx="gradient-mesh"
            data-fx-seed="17"
            data-fx-palette='{"bg":"#101324","surface":"#1C2240","ink":"#F0F2F5","muted":"#9496A1","accent":"#F5B82E"}'
            data-fx-params='{"speed":0,"calm":0.22,"calmX":0.5,"calmY":0.5,"tint":0.55,"relief":0.3}'
            style="--p-h: 340px; --calm-k: 0%;"
          >
            <div class="dg" data-diagram set:html={`<script type="application/json">${novaLanesDiagram}</script>`}></div>
          </div>
        </div>

        <div class="card card--row lg:col-span-6 justify-between" style="--c-pad: 32px;">
          <div>
            <h3>Arte oficial e texturas UV 64×64 originais</h3>
            <p>Banners desenhados para o Modrinth e CurseForge ao lado dos mapas UV reais da Manopla (19 bones, 103 cubos) e do Tesseract.</p>
          </div>
          <div
            class="panel"
            data-fx="gradient-mesh"
            data-fx-seed="41"
            data-fx-palette='{"bg":"#0F1221","surface":"#1B213D","ink":"#F0F2F5","muted":"#9496A1","accent":"#00F0FF"}'
            data-fx-params='{"speed":0,"calm":0.18,"calmX":0.5,"calmY":0.5,"tint":0.5,"relief":0.35}'
            style="--p-h: 340px; --calm-k: 0%;"
          >
            <div class="relative z-[2] p-5 grid grid-cols-2 gap-3 items-center h-full">
              <div class="col-span-2 media rounded-xl overflow-hidden bg-[#05060A] border border-white/10">
                <img
                  src={withBase('/infinity-nova/assets/banner_description.png')}
                  alt="Banner oficial de apresentação do Infinity Nova"
                  class="w-full h-auto object-contain pixel"
                />
              </div>
              <div class="media aspect-square rounded-xl overflow-hidden bg-[#05060A] border border-white/10 p-3 flex items-center justify-center">
                <img
                  src={withBase('/infinity-nova/textures/manopla_3d.png')}
                  alt="Textura UV 64x64 da Manopla do Infinito"
                  class="w-full h-full object-contain pixel"
                />
              </div>
              <div class="media aspect-square rounded-xl overflow-hidden bg-[#05060A] border border-white/10 p-3 flex items-center justify-center">
                <img
                  src={withBase('/infinity-nova/textures/tesseract_3d.png')}
                  alt="Textura UV 64x64 do Tesseract"
                  class="w-full h-full object-contain pixel"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
)}

{/* ========================================================================
    PROJETO 02 — LABCD (Clinical Software · Big Scene Parts Lock + Sync Diagram + Terminal Run)
   ======================================================================== */}
{project.slug === 'labcd' && (
  <article id={`projeto-${project.number}`} class="scroll-mt-14 world-light border-t border-black/10 overflow-x-clip">
    <!-- Part A: Big Scroll Scene where the App Panels Fly In and Lock into Place -->
    <div
      class="sc world-light"
      data-big-scene="parts-lock-into-the-whole"
      data-big-scene-opts='{"hold": 1}'
      style="--h: 1"
      aria-labelledby="pl-labcd-h"
    >
      <div class="sc__stage">
        <p class="pl__word" aria-hidden="true">LABCD</p>

        <div class="pl__ui labcd-ui" data-ui role="img" aria-label="Interface LabCD de gestão offline-first de próteses dentárias">
          <div class="pl__panel pl__bar">
            <span class="labcd-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <b>LabCD</b>
            <span class="labcd-tab on">Bancadas</span>
            <span class="labcd-tab">Clínicas</span>
            <span class="labcd-tab">Odontograma</span>
            <span class="ml-auto mono text-[11px] text-[#0047FF] font-medium">SQLite Offline Ativo</span>
          </div>

          <div class="pl__panel pl__side">
            <small>Fluxo</small>
            <span class="on">Produção Hoje</span>
            <span>Bancada 01 · STL</span>
            <span>Bancada 02 · CAD/CAM</span>
            <span>Bancada 03 · Controlo</span>
            <small>Sincronização</small>
            <span>Fila Pendente (0)</span>
            <span>15 Tabelas PG</span>
          </div>

          <div class="pl__panel pl__main">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="pl__title">Pedidos <span class="pl__title-word">LABCD</span></p>
              <svg viewBox="0 0 154 32" width="154" height="32" aria-hidden="true" class="shrink-0">
                {Array.from({ length: 8 }).map((_, idx) => (
                  <rect
                    x={4 + idx * 18}
                    y="4"
                    width="13"
                    height="22"
                    rx="2"
                    fill={idx === 2 || idx === 3 || idx === 6 ? '#0047FF' : 'none'}
                    stroke="#0D131A"
                    stroke-width="1.2"
                  />
                ))}
              </svg>
            </div>

            <table>
              <thead>
                <tr><th>Clínica &amp; Peça</th><th>Bancada</th><th class="n">.STL</th><th>Estado</th></tr>
              </thead>
              <tbody>
                <tr>
                  <td>#1042 · Clínica S. Mateus</td>
                  <td data-layer="1">Zircónia · B01</td>
                  <td class="n" data-layer="1">48 MB</td>
                  <td><span class="labcd-bar"><b data-layer="1" data-ink="x" style="--v:.86"></b></span></td>
                </tr>
                <tr>
                  <td class="labcd-talk" data-layer="2">#1045 · ViseuDental</td>
                  <td data-layer="1">CAD/CAM · B02</td>
                  <td class="n" data-layer="1">64 MB</td>
                  <td><span class="labcd-bar"><b data-layer="1" data-ink="x" style="--v:.55"></b></span></td>
                </tr>
                <tr>
                  <td>#1049 · Arco Superior</td>
                  <td data-layer="1">Controlo · B03</td>
                  <td class="n" data-layer="1">31 MB</td>
                  <td><span class="labcd-bar"><b data-layer="1" data-ink="x" style="--v:1"></b></span></td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="pl__panel pl__insp">
            <h4>Auditoria &amp; Regras</h4>
            <div class="labcd-note" data-layer="2">
              <b><i>ST</i>Scanner Intraoral</b>
              Molde .STL 64 MB validado antes do upload binário.
            </div>
            <div class="labcd-note labcd-trigger" data-layer="3">
              <b><i>PG</i>Trigger PL/pgSQL</b>
              Histórico clínico bloqueado contra eliminação acidental.
            </div>
          </div>
        </div>

        <div class="pl__spec">
          <div class="mono text-[11px] text-[#0047FF] font-semibold pb-2">02 / 05 · MOBILE &amp; BACKEND</div>
          <h2 id="pl-labcd-h" class="display text-[clamp(2rem,3.5vw,3rem)] text-[#0D131A]">
            {project.title}
          </h2>
          <p class="mt-3 text-sm sm:text-base text-[#35424E] leading-relaxed">{project.oneLiner}</p>
          <dl>
            <div><dt>Contexto</dt><dd>3.º ano · Laboratório Catarina Domingos</dd></div>
            <div><dt>App Mobile</dt><dd>Flutter + SQLite offline-first</dd></div>
            <div><dt>Servidor</dt><dd>Django REST + PostgreSQL (15 tabelas)</dd></div>
            <div><dt>Upload 3D</dt><dd>Validação binária .STL até 100 MB</dd></div>
          </dl>
          <div class="pt-5 flex flex-wrap items-center gap-3">
            {uniqueTools.map((tech) => (
              <ToolIcon name={tech} size={30} />
            ))}
            {project.links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto link mono text-xs font-semibold text-[#0047FF]"
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Part B: Feature Bento Cards (Sync Architecture + Live Terminal Run Fragment) -->
    <div class="wrap pb-20 pt-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        <div class="card card--row lg:col-span-6 justify-between" style="--c-pad: 32px;">
          <div>
            <h3>Sincronização bidirecional mesmo sem rede</h3>
            <p>{project.about}</p>
          </div>
          <div
            class="panel"
            data-fx="gradient-mesh"
            data-fx-seed="14"
            data-fx-palette='{"bg":"#c6d3df","surface":"#d6e0e9","ink":"#25303a","muted":"#5d6873","accent":"#0047FF"}'
            data-fx-params='{"speed":0,"calm":0.2,"calmX":0.5,"calmY":0.5,"tint":0.55,"relief":0.3}'
            style="--p-h: 310px; --calm-k: 0%;"
          >
            <div class="dg" data-diagram set:html={`<script type="application/json">${labcdSyncDiagram}</script>`}></div>
          </div>
        </div>

        <div class="card card--row lg:col-span-6 justify-between" style="--c-pad: 32px;">
          <div>
            <h3>Regras clínicas protegidas em PL/pgSQL</h3>
            <p>{project.work}</p>
          </div>
          <div
            class="panel"
            data-fx="painterly-landscape"
            data-fx-seed="8"
            data-fx-palette='{"bg":"#c6d3df","surface":"#d6e0e9","ink":"#25303a","muted":"#5d6873","accent":"#3f6a92"}'
            data-fx-params='{"blur":1,"brush":0.3,"slope":0.1,"hillY":0.35,"horizon":0.64,"calm":0.2,"calmX":0.5,"calmY":0.8,"drift":0,"side":-1}'
            style="--p-h: 310px; --calm-k: 0%;"
          >
            <div class="stage">
              <div class="at-rise fit" style="--ax:28px;--ay:34px;--fit-max:440px" data-ui-load="terminal-run" data-ui-loop></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
)}

{/* ========================================================================
    PROJETO 03 — CYRIX (Cyber Midnight · Pinned Chapters Walkthrough + Bowtie Diagram)
   ======================================================================== */}
{project.slug === 'cyrix' && (
  <article id={`projeto-${project.number}`} class="scroll-mt-14 world-navy border-t border-white/10 overflow-x-clip">
    <div class="wrap pt-20 pb-8 space-y-6">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-8 border-b border-white/10">
        <div class="space-y-3 max-w-3xl">
          <div class="flex flex-wrap items-center gap-3 mono text-[11px]">
            <span class="text-[#F59E0B] font-semibold">03 / 05 · PORTAL NIS2 &amp; BACKOFFICE</span>
            <span class="px-2.5 py-0.5 border border-[#10B981]/40 bg-[#10B981]/10 text-[#34D399]">
              ONLINE · CYRIX-MU.VERCEL.APP
            </span>
          </div>
          <h2 data-gsap-title class="display text-[clamp(2.5rem,5vw,4.5rem)] text-[#F8FAFC]">
            {project.title}
          </h2>
          <p class="text-base sm:text-lg text-[#CBD5E1] leading-snug">{project.oneLiner}</p>
        </div>

        <div class="flex flex-col lg:items-end gap-4">
          <div class="flex flex-wrap gap-2">
            {uniqueTools.map((tech) => (
              <ToolIcon name={tech} size={30} />
            ))}
          </div>
          <div class="flex flex-wrap gap-2.5">
            {project.links.map((l, idx) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'px-3.5 py-2 border transition-colors mono text-xs font-semibold',
                  idx === 0
                    ? 'border-[#F59E0B] bg-[#F59E0B] text-[#070D19] hover:bg-[#FBBF24]'
                    : 'border-white/25 bg-black/30 text-[#F8FAFC] hover:border-[#F59E0B] hover:text-[#F59E0B]',
                ]}
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll-Driven Walkthrough using design-taste-frontend pinned-chapters -->
    <div class="mo-pc" data-moment="pinned-chapters" aria-label="Navegação pelos ecrãs do portal Cyrix">
      <div class="wrap mo-pc__grid">
        <div class="mo-pc__text">
          <h2>Quatro ecrãs reais do portal público à área de cliente.</h2>
          <ol class="mo-pc__steps">
            <li class="mo-pc__step">
              <h3>01 · Entrada Pública &amp; Enquadramento</h3>
              <p>Página principal responsiva onde as empresas percebem serviços, equipa e contactos sem fricção.</p>
              <figure class="mo-pc__visual">
                <img src={withBase('/projetos/cyrix/home.png')} alt="Página inicial da Cyrix Cybersecurity" />
              </figure>
            </li>
            <li class="mo-pc__step">
              <h3>02 · Diagnóstico Interativo NIS2</h3>
              <p>Questionário por secções que avalia rapidamente o cumprimento da diretiva europeia NIS2.</p>
              <figure class="mo-pc__visual">
                <img src={withBase('/projetos/cyrix/nis2.png')} alt="Página da diretiva NIS2 com autoavaliação na Cyrix" />
              </figure>
            </li>
            <li class="mo-pc__step">
              <h3>03 · Catálogo de Serviços &amp; Testagem UX</h3>
              <p>Arquitetura validada previamente no Figma com testes reais de compreensão de ícones e questionário UEQ.</p>
              <figure class="mo-pc__visual">
                <img src={withBase('/projetos/cyrix/servicos.png')} alt="Página de Serviços da Cyrix" />
              </figure>
            </li>
            <li class="mo-pc__step">
              <h3>04 · Área Restrita JWT + 2FA</h3>
              <p>Acesso autenticado a tickets de suporte, documentos e backoffice sobre a base PostgreSQL.</p>
              <figure class="mo-pc__visual">
                <img src={withBase('/projetos/cyrix/login.png')} alt="Ecrã de acesso à Área Restrita da Cyrix" />
              </figure>
            </li>
          </ol>
        </div>

        <div class="mo-pc__visuals frame rounded-xl overflow-hidden border border-white/15 bg-[#020617]"></div>
      </div>
    </div>

    <!-- Split Bowtie Architecture Card -->
    <div class="wrap pb-20 pt-8">
      <div class="card card--split" style="--c-pad: 32px;">
        <div class="card__body space-y-4">
          <div class="mono text-[11px] text-[#F59E0B] font-semibold">ARQUITETURA EM DUPLA API</div>
          <h3 class="card__title">Express e Django a ler o mesmo PostgreSQL</h3>
          <p class="card__text">{project.work}</p>
          <p class="text-sm text-[#94A3B8] leading-relaxed">{project.about}</p>
        </div>
        <div
          class="panel"
          data-fx="gradient-mesh"
          data-fx-seed="22"
          data-fx-palette='{"bg":"#0B1324","surface":"#15223D","ink":"#F8FAFC","muted":"#94A3B8","accent":"#F59E0B"}'
          data-fx-params='{"speed":0,"calm":0.2,"calmX":0.5,"calmY":0.5,"tint":0.55,"relief":0.3}'
