---
import InfinityNovaViewer3D from './InfinityNovaViewer3D.astro';
import ToolIcon from './ToolIcon.astro';
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const swatchesMap: Record<string, string[]> = {
  'infinity-nova': ['#08090F', '#F5B82E', '#00F0FF', '#A855F7'],
  labcd: ['#D8E2EB', '#0047FF', '#0D131A', '#EDF2F7'],
  cyrix: ['#070D19', '#F59E0B', '#10B981', '#F8FAFC'],
  'cg-3d-lab': ['#141416', '#FF6B00', '#00F0FF', '#F3F3F0'],
  ecogo: ['#0D3B26', '#F4EFE6', '#6EE7B7', '#0E0E0E'],
};

const swatches = swatchesMap[project.slug] || [project.ground, project.ink, '#0047FF', '#EDEDEA'];

const labcdKanban = [
  { bench: 'Bancada 01 · STL', card: '#1042 Clínica S. Mateus', detail: 'Zircónia · STL 48 MB' },
  { bench: 'Bancada 02 · CAD/CAM', card: '#1045 ViseuDental', detail: 'Prótese Acrílica · Fresa' },
  { bench: 'Bancada 03 · Controlo', card: '#1049 Arco Superior', detail: 'Ajuste oclusal · Pronto' },
];

const ecogoDistances = [3, 8, 15, 25];

function iconBucket(tech: string): string {
  const s = tech.toLowerCase();
  if (s.includes('neoforge') || s.includes('geckolib') || s.includes('blockbench')) return 'blockbench';
  if (s.includes('node') || s.includes('express') || s.includes('sequelize')) return 'node';
  if (s.includes('postgres') || s.includes('pl/pgsql')) return 'postgres';
  if (s.includes('three') || s.includes('webgl')) return 'threejs';
  return s;
}

const uniqueTools: string[] = [];
const seenBuckets = new Set<string>();
for (const tech of project.stack) {
  const b = iconBucket(tech);
  if (!seenBuckets.has(b)) {
    seenBuckets.add(b);
    uniqueTools.push(tech);
  }
}

const novaSpecs = [
  { label: 'Geometria', value: '8 Modelos .geo.json' },
  { label: 'Rigging Manopla', value: '19 Bones · 103 Cubos' },
  { label: 'Runtime Mod', value: 'NeoForge 21.1.86+' },
  { label: 'Admin Segurança', value: 'Django 5.2 + 2FA TOTP' },
];

const cyrixScreens = [
  {
    src: '/projetos/cyrix/servicos.png',
    title: '02 · CATÁLOGO DE SERVIÇOS',
    alt: 'Página de Serviços da Cyrix',
  },
  {
    src: '/projetos/cyrix/sobre.png',
    title: '03 · EQUIPA & SOBRE NÓS',
    alt: 'Página Sobre Nós da Cyrix',
  },
  {
    src: '/projetos/cyrix/login.png',
    title: '04 · ÁREA RESTRITA JWT + 2FA',
    alt: 'Ecrã de acesso à Área Restrita da Cyrix',
  },
];
---

{/* ========================================================================
    PROJETO 01 — INFINITY NOVA (Deep Space Obsidian · Supernova Gold & Cyan)
   ======================================================================== */}
{project.slug === 'infinity-nova' && (
  <article id={`projeto-${project.number}`} class="scroll-mt-14 space-grid text-[#F0F2F5] border-t border-white/15 overflow-x-clip">
    <div class="wrap py-16 sm:py-24 space-y-12">
      <!-- Game Release Top Header -->
      <div
        data-gsap-card
        class="border border-[#F5B82E]/35 bg-[#11131F]/80 p-6 sm:p-8 flex flex-col lg:flex-row lg:items-end justify-between gap-6"
      >
        <div class="space-y-3 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2.5 mono text-[11px]">
            <span class="px-2.5 py-1 bg-[#F5B82E] text-[#08090F] font-bold">
              PROJETO 01 / 05 · MOD JAVA 21 &amp; 3D WEB
            </span>
            <span class="text-[#00F0FF]">MINECRAFT 1.21.1 · 715+ DOWNLOADS</span>
          </div>
          <h2 data-gsap-title class="display text-[clamp(2.5rem,6vw,5.5rem)] text-[#F5B82E]">
            {project.title}
          </h2>
          <p class="text-base sm:text-xl text-[#F0F2F5]/85 leading-snug">
            {project.oneLiner}
          </p>
          <div class="mono text-[11px] text-[#9496A1]">
            {project.context} · {project.role}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          {project.links.map((l) => (
            <a
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-2 border border-[#F5B82E]/60 bg-[#08090F] hover:bg-[#F5B82E] hover:text-[#08090F] transition-colors mono text-xs font-semibold text-[#F5B82E]"
            >
              {l.label} ↗
            </a>
          ))}
        </div>
      </div>

      <!-- 12-Col Main Arena: Dark Obsidian Dossier (5) + Sticky HUD 3D Arena (7) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div data-gsap-dossier class="lg:col-span-5 space-y-5">
          <div class="border border-white/10 bg-[#11131F]/90 p-6 space-y-2">
            <h3 class="mono text-[11px] text-[#F5B82E] font-semibold">01 · A IDEIA NO JOGO</h3>
            <p class="text-[15px] sm:text-base leading-[1.68] text-[#F0F2F5]/90">
              {project.about}
            </p>
          </div>

          <div class="border border-white/10 bg-[#11131F]/90 p-6 space-y-2">
            <h3 class="mono text-[11px] text-[#00F0FF] font-semibold">02 · JAVA 21, THREE.JS &amp; 2FA</h3>
            <p class="text-[15px] sm:text-base leading-[1.68] text-[#F0F2F5]/90">
              {project.work}
            </p>
          </div>

          <!-- 2x2 Technical Spec Grid -->
          <div class="grid grid-cols-2 gap-3">
            {novaSpecs.map((spec) => (
              <div class="border border-white/10 bg-[#0D0F18] p-4 space-y-1">
                <div class="mono text-[10px] text-[#9496A1]">{spec.label}</div>
                <div class="text-sm font-semibold text-[#F0F2F5]">{spec.value}</div>
              </div>
            ))}
          </div>

          <!-- Stack & Neon Swatches -->
          <div class="border border-white/15 bg-[#11131F]/90 p-4 flex flex-wrap items-center justify-between gap-6">
            <div class="space-y-2">
              <div class="mono text-[11px] text-[#9496A1]">Ferramentas usadas</div>
              <div class="flex flex-wrap gap-2">
                {uniqueTools.map((tech) => (
                  <span class="border border-white/15 bg-black/40 p-1 inline-flex">
                    <ToolIcon name={tech} size={32} />
                  </span>
                ))}
              </div>
            </div>

            <div class="space-y-2">
              <div class="mono text-[11px] text-[#9496A1]">Paleta</div>
              <div class="flex items-center gap-1.5">
                {swatches.map((hex) => (
                  <span
                    title={hex}
                    aria-label={`Cor ${hex}`}
                    class="w-6 h-6 border border-white/25 inline-block"
                    style={`background:${hex};`}
                  ></span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 lg:sticky lg:top-20">
          <div
            data-gsap-stage
            class="relative border-2 border-[#F5B82E]/60 bg-[#05060A] p-1.5 shadow-[0_0_50px_-12px_rgba(0,240,255,0.25)]"
          >
            <div class="border border-[#00F0FF]/25 overflow-hidden">
              <InfinityNovaViewer3D initial="manopla" instanceId="nova" compact={true} />
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Pixel-Art Banners & UV Texture Inspector Deck -->
      <div data-gsap-gallery class="space-y-4 pt-2">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {project.gallery.slice(0, 3).map((item) => (
            <div
              class:list={[
                'media border border-[#F5B82E]/30 bg-[#05060A] p-4 sm:p-8 flex items-center justify-center',
                item.span === 'full' ? 'md:col-span-2' : 'aspect-[16/10]',
              ]}
            >
              <img
                src={item.src}
                alt={item.alt}
                class:list={[
                  item.span === 'full' ? 'w-full h-auto object-contain' : 'w-full h-full object-contain',
                  { pixel: item.pixelated },
                ]}
              />
            </div>
          ))}
        </div>

        <!-- Dedicated 64x64 UV Inspector Row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {project.gallery.slice(3).map((item, idx) => (
            <div class="border border-[#00F0FF]/25 bg-[#0D0F18] p-5 space-y-4">
              <div class="flex items-center justify-between mono text-[11px]">
                <span class="text-[#00F0FF]">
                  {idx === 0 ? 'UV MAP 01 · MANOPLA 64×64 PX' : 'UV MAP 02 · TESSERACT 64×64 PX'}
                </span>
                <span class="text-[#9496A1]">BEDROCK / GECKOLIB</span>
              </div>
              <div class="media aspect-[16/10] bg-[#05060A] border border-white/10 p-6 flex items-center justify-center">
                <img
                  src={item.src}
                  alt={item.alt}
                  class="w-full h-full object-contain pixel"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </article>
)}

{/* ========================================================================
    PROJETO 02 — LABCD (Clinical Blueprint Slate · Cobalt & Offline Sync)
   ======================================================================== */}
{project.slug === 'labcd' && (
  <article id={`projeto-${project.number}`} class="scroll-mt-14 blueprint-grid text-[#0D131A] border-t-2 border-[#0D131A] overflow-x-clip">
    <div class="wrap py-16 sm:py-24 space-y-10">
      <!-- Clinical Blueprint Specification Header -->
      <div
        data-gsap-card
        class="border-2 border-[#0D131A] bg-[#EDF2F7] p-6 sm:p-8 shadow-[8px_8px_0_#0D131A] grid grid-cols-1 lg:grid-cols-12 gap-6 items-end"
      >
        <div class="lg:col-span-8 space-y-3">
          <div class="flex flex-wrap items-center gap-2.5 mono text-[11px]">
            <span class="px-2.5 py-1 bg-[#0047FF] text-[#FFFFFF] font-semibold">
              PROJETO 02 / 05 · MOBILE FLUTTER &amp; POSTGRESQL
            </span>
            <span class="text-[#0D131A] font-medium">MODO OFFLINE-FIRST · 15 TABELAS</span>
          </div>
          <h2 data-gsap-title class="display text-[clamp(2.5rem,5.5vw,5rem)] text-[#0D131A]">
            {project.title}
          </h2>
          <p class="text-base sm:text-lg text-[#35424E] leading-snug max-w-3xl">
            {project.oneLiner}
          </p>
        </div>

        <div class="lg:col-span-4 flex flex-col lg:items-end gap-3">
          <div class="mono text-[11px] text-[#35424E] lg:text-right">
            {project.context} · {project.role}
          </div>
          <div class="flex flex-wrap gap-2">
            {project.links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-2 border-2 border-[#0D131A] bg-[#FFFFFF] hover:bg-[#0D131A] hover:text-[#FFFFFF] transition-colors mono text-xs font-semibold shadow-[3px_3px_0_#0047FF]"
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Reversed 12-Col Workbench: Left Sticky Interactive Stage (7) + Right Hard-Shadow Datasheet (5) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div class="lg:col-span-7 lg:sticky lg:top-20">
          <div
            data-gsap-stage
            class="border-2 border-[#0D131A] bg-[#EDF2F7] p-5 sm:p-7 shadow-[10px_10px_0_#0047FF] space-y-6"
          >
            <!-- App Window Header -->
            <div class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b-2 border-[#0D131A]/15">
              <span class="mono font-semibold text-[#0D131A]">
                LabCD · Produção Protética · Modo Offline Ativo — SQLite Local
              </span>
              <span class="inline-flex items-center gap-1.5" aria-hidden="true">
                <span class="w-2.5 h-2.5 border border-[#0D131A]"></span>
                <span class="w-2.5 h-2.5 border border-[#0D131A]"></span>
                <span class="w-2.5 h-2.5 bg-[#0047FF]"></span>
              </span>
            </div>

            <!-- 3-Column Prosthetic Kanban -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              {labcdKanban.map((col) => (
                <div class="border-2 border-[#0D131A] bg-[#FFFFFF] p-4 space-y-2 shadow-[3px_3px_0_#0D131A]">
                  <div class="mono text-[11px] text-[#0047FF] font-semibold">{col.bench}</div>
                  <div class="text-sm font-bold text-[#0D131A]">{col.card}</div>
                  <div class="mono text-[11px] text-[#35424E]">{col.detail}</div>
                </div>
              ))}
            </div>

            <!-- Architectural Odontograma SVG -->
            <div class="border-2 border-[#0D131A] bg-[#FFFFFF] p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="mono text-[11px] text-[#0047FF] font-semibold">Odontograma &amp; Ficheiro .STL</div>
                <div class="text-sm font-semibold text-[#0D131A]">Dentes 11–28 / 31–48 · Validação binária até 100 MB</div>
              </div>
              <svg viewBox="0 0 220 56" width="220" height="56" aria-hidden="true" class="shrink-0">
                {Array.from({ length: 12 }).map((_, idx) => {
                  const x = 8 + idx * 17;
                  const active = idx === 3 || idx === 4 || idx === 8;
                  return (
                    <rect
                      x={x}
                      y={6}
                      width="13"
                      height="18"
                      rx="2"
                      fill={active ? '#0047FF' : 'none'}
                      stroke="#0D131A"
                      stroke-width="1.2"
                    />
                  );
                })}
                {Array.from({ length: 12 }).map((_, idx) => {
                  const x = 8 + idx * 17;
                  const active = idx === 7;
                  return (
                    <rect
                      x={x}
                      y={30}
                      width="13"
                      height="18"
                      rx="2"
                      fill={active ? '#0D131A' : 'none'}
                      stroke="#0D131A"
                      stroke-width="1.2"
                    />
                  );
                })}
              </svg>
            </div>

            <!-- Pulsing Data-Lane Architecture Diagram -->
            <div class="pt-2 space-y-2.5">
              <div class="mono text-[11px] text-[#35424E] font-semibold">SINCRONIZAÇÃO OFFLINE-FIRST</div>
              <div class="grid grid-cols-1 sm:grid-cols-5 gap-2 items-center">
                <div class="border-2 border-[#0D131A] bg-[#FFFFFF] px-3 py-2.5 text-center mono text-[11px] font-semibold">
                  Flutter + SQLite
                </div>
                <div class="pulse-lane hidden sm:block"><div class="pulse-dot"></div></div>
                <div class="border-2 border-[#0D131A] bg-[#FFFFFF] px-3 py-2.5 text-center mono text-[11px] font-semibold">
                  Django REST API
                </div>
                <div class="pulse-lane hidden sm:block"><div class="pulse-dot" style="animation-delay: 0.9s;"></div></div>
                <div class="border-2 border-[#0D131A] bg-[#0D131A] text-[#FFFFFF] px-3 py-2.5 text-center mono text-[11px] font-semibold">
                  PostgreSQL · 15 Tabelas
                </div>
              </div>
            </div>
          </div>
        </div>

        <div data-gsap-dossier class="lg:col-span-5 space-y-5">
          <div class="border-2 border-[#0D131A] bg-[#EDF2F7] p-6 shadow-[6px_6px_0_#0D131A] space-y-2">
            <h3 class="mono text-[11px] text-[#0047FF] font-semibold">01 · O PROBLEMA NAS BANCADAS</h3>
            <p class="text-[15px] sm:text-base leading-[1.68] text-[#0D131A]">
              {project.about}
            </p>
          </div>

          <div class="border-2 border-[#0D131A] bg-[#EDF2F7] p-6 shadow-[6px_6px_0_#0D131A] space-y-2">
            <h3 class="mono text-[11px] text-[#0D131A] font-semibold">02 · SQLITE OFFLINE &amp; TRIGGERS PL/PGSQL</h3>
            <p class="text-[15px] sm:text-base leading-[1.68] text-[#0D131A]">
              {project.work}
            </p>
          </div>

          <ul class="border-2 border-[#0D131A] bg-[#FFFFFF] divide-y-2 divide-[#0D131A]/15">
            {project.details.map((d, i) => (
              <li class="p-3.5 text-sm leading-snug flex items-baseline gap-3">
                <span class="mono text-xs font-bold text-[#0047FF] shrink-0">0{i + 1}</span>
                <span>{d}</span>
              </li>
            ))}
          </ul>

          <div class="border-2 border-[#0D131A] bg-[#EDF2F7] p-4 flex flex-wrap items-center justify-between gap-6">
            <div class="space-y-2">
              <div class="mono text-[11px] text-[#35424E] font-semibold">Ferramentas usadas</div>
              <div class="flex flex-wrap gap-2">
                {uniqueTools.map((tech) => (
                  <ToolIcon name={tech} size={34} />
                ))}
              </div>
            </div>

            <div class="space-y-2">
              <div class="mono text-[11px] text-[#35424E] font-semibold">Paleta</div>
              <div class="flex items-center gap-1.5">
                {swatches.map((hex) => (
                  <span
                    title={hex}
                    aria-label={`Cor ${hex}`}
                    class="w-6 h-6 border-2 border-[#0D131A] inline-block"
                    style={`background:${hex};`}
                  ></span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
)}

{/* ========================================================================
    PROJETO 03 — CYRIX (Cyber Defense Midnight Navy · Amber & Emerald)
   ======================================================================== */}
{project.slug === 'cyrix' && (
  <article id={`projeto-${project.number}`} class="scroll-mt-14 navy-grid text-[#F8FAFC] border-t border-white/15 overflow-x-clip">
    <div class="wrap py-16 sm:py-24 space-y-12">
      <!-- Tactical Command Header -->
      <div
        data-gsap-card
        class="border border-white/15 bg-[#0F172A]/85 p-6 sm:p-8 flex flex-col lg:flex-row lg:items-end justify-between gap-6"
      >
        <div class="space-y-3 max-w-3xl">
          <div class="flex flex-wrap items-center gap-3 mono text-[11px]">
            <span class="px-2.5 py-1 bg-[#F59E0B] text-[#070D19] font-bold">
              PROJETO 03 / 05 · PORTAL NIS2 &amp; BACKOFFICE
            </span>
            <span class="inline-flex items-center gap-2 px-2.5 py-1 border border-[#10B981]/50 bg-[#10B981]/10 text-[#34D399]">
              <span class="w-2 h-2 bg-[#10B981] inline-block" aria-hidden="true"></span>
              ONLINE · CYRIX-MU.VERCEL.APP
            </span>
          </div>
          <h2 data-gsap-title class="display text-[clamp(2.5rem,5.5vw,5.25rem)] text-[#F8FAFC]">
            {project.title}
          </h2>
          <p class="text-base sm:text-xl text-[#CBD5E1] leading-snug">
            {project.oneLiner}
          </p>
          <div class="mono text-[11px] text-[#94A3B8]">
            {project.context} · {project.role}
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          {project.links.map((l, idx) => (
            <a
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                'px-3.5 py-2 border transition-colors mono text-xs font-semibold',
                idx === 0
                  ? 'border-[#F59E0B] bg-[#F59E0B] text-[#070D19] hover:bg-[#FBBF24]'
                  : 'border-white/30 bg-[#070D19] text-[#F8FAFC] hover:border-[#F59E0B] hover:text-[#F59E0B]',
              ]}
            >
              {l.label} ↗
            </a>
          ))}
        </div>
      </div>

      <!-- 12-Col Command Split: Amber-Accented Dossier (5) + Sticky Browser + Mobile Overlay (7) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <div data-gsap-dossier class="lg:col-span-5 space-y-5">
          <div class="bg-[#0F172A] border border-white/10 border-l-4 border-l-[#F59E0B] p-6 space-y-2">
            <h3 class="mono text-[11px] text-[#F59E0B] font-semibold">01 · SEGURANÇA &amp; DIRETIVA NIS2</h3>
            <p class="text-[15px] sm:text-base leading-[1.68] text-[#F8FAFC]/90">
              {project.about}
            </p>
          </div>

          <div class="bg-[#0F172A] border border-white/10 border-l-4 border-l-[#10B981] p-6 space-y-2">
            <h3 class="mono text-[11px] text-[#34D399] font-semibold">02 · EXPRESS + DJANGO NA MESMA BD</h3>
            <p class="text-[15px] sm:text-base leading-[1.68] text-[#F8FAFC]/90">
              {project.work}
            </p>
          </div>

          <ul class="border border-white/15 bg-[#0B1221] divide-y divide-white/10">
            {project.details.map((d) => (
              <li class="p-3.5 text-sm leading-snug flex items-baseline gap-2.5 text-[#E2E8F0]">
                <span class="mono text-[#F59E0B] shrink-0">+</span>
                <span>{d}</span>
              </li>
            ))}
          </ul>

          <div class="border border-white/15 bg-[#0F172A] p-4 flex flex-wrap items-center justify-between gap-6">
            <div class="space-y-2">
              <div class="mono text-[11px] text-[#94A3B8]">Ferramentas usadas</div>
              <div class="flex flex-wrap gap-2">
                {uniqueTools.map((tech) => (
                  <span class="border border-white/15 bg-black/30 p-1 inline-flex">
                    <ToolIcon name={tech} size={32} />
                  </span>
                ))}
              </div>
            </div>

            <div class="space-y-2">
              <div class="mono text-[11px] text-[#94A3B8]">Paleta</div>
              <div class="flex items-center gap-1.5">
                {swatches.map((hex) => (
                  <span
                    title={hex}
                    aria-label={`Cor ${hex}`}
                    class="w-6 h-6 border border-white/25 inline-block"
                    style={`background:${hex};`}
                  ></span>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 lg:sticky lg:top-20">
