---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className = '' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <rect width="100" height="100" rx="20" fill="#141417" stroke="rgba(244,243,238,0.14)" stroke-width="2" />
  <circle cx="50" cy="50" r="32" stroke="#F4F3EE" stroke-width="1.5" stroke-opacity="0.22" />
  <path
    d="M50 18 L54 46 L82 50 L54 54 L50 82 L46 54 L18 50 L46 46 Z"
    fill="#F4F3EE"
  />
  <circle cx="50" cy="50" r="5" fill="#FF4F17" />
</svg>
