---
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const thumb = project.thumb;
---

{thumb ? (
  <div
    class="media relative w-full aspect-[16/10] sm:aspect-[16/8] overflow-hidden"
    style={`background:${project.ground}; color:${project.ink};`}
  >
    <img
      src={thumb.src}
      alt={thumb.alt}
      class:list={[
        'w-full h-full',
        thumb.contain ? 'object-contain p-6 sm:p-10' : 'object-cover object-top',
        { pixel: thumb.pixelated },
      ]}
    />
  </div>
) : (
  <div
    class="relative w-full aspect-[16/10] sm:aspect-[16/8] flex items-end p-6 sm:p-10 overflow-hidden"
    style={`background:${project.ground}; color:${project.ink};`}
  >
    <span class="display text-[clamp(3rem,10vw,10rem)]">
      {project.title}
    </span>
  </div>
)}
