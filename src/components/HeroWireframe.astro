---
---

<div class="relative w-full h-[260px] sm:h-[320px] lg:h-[360px] flex items-center justify-center select-none">
  <canvas
    id="hero-3d-canvas"
    class="w-full h-full cursor-grab active:cursor-grabbing"
    aria-label="Geometria 3D interativa em wireframe"
  ></canvas>
</div>

<script>
  const canvas = document.getElementById('hero-3d-canvas') as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let isDark = (document.documentElement.getAttribute('data-theme') || 'dark') === 'dark';

    window.addEventListener('portfolio:theme-change', (e: Event) => {
      const detail = (e as CustomEvent).detail;
      isDark = detail?.theme !== 'light';
      draw();
    });

    const phi = (1 + Math.sqrt(5)) / 2;
    const rawVerts: [number, number, number][] = [
      [-1,  phi, 0], [ 1,  phi, 0], [-1, -phi, 0], [ 1, -phi, 0],
      [ 0, -1,  phi], [ 0,  1,  phi], [ 0, -1, -phi], [ 0,  1, -phi],
      [ phi, 0, -1], [ phi, 0,  1], [-phi, 0, -1], [-phi, 0,  1],
    ];

    const verts = rawVerts.map(([x, y, z]) => {
      const len = Math.hypot(x, y, z);
      return [x / len, y / len, z / len] as [number, number, number];
    });

    const edges: [number, number][] = [];
    for (let i = 0; i < verts.length; i++) {
      for (let j = i + 1; j < verts.length; j++) {
        const d = Math.hypot(
          verts[i][0] - verts[j][0],
          verts[i][1] - verts[j][1],
          verts[i][2] - verts[j][2]
        );
        if (d < 1.15) edges.push([i, j]);
      }
    }

    const innerVerts: [number, number, number][] = [
      [0.45, 0, 0], [-0.45, 0, 0],
      [0, 0.45, 0], [0, -0.45, 0],
      [0, 0, 0.45], [0, 0, -0.45],
    ];
    const innerEdges: [number, number][] = [
      [0,2],[0,3],[0,4],[0,5],
      [1,2],[1,3],[1,4],[1,5],
      [2,4],[4,3],[3,5],[5,2],
    ];

    let rotX = 0.35;
    let rotY = 0.55;
    let isDragging = false;
    let lastX = 0;
    let lastY = 0;

    function resize() {
      if (!canvas || !ctx) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function project(v: [number, number, number], cx: number, cy: number, scale: number) {
      const cosX = Math.cos(rotX), sinX = Math.sin(rotX);
      const cosY = Math.cos(rotY), sinY = Math.sin(rotY);
      const x1 = v[0] * cosY - v[2] * sinY;
      const z1 = v[0] * sinY + v[2] * cosY;
      const y2 = v[1] * cosX - z1 * sinX;
      const z2 = v[1] * sinX + z1 * cosX;
      const fov = 3.2;
      const p = fov / (fov + z2);
      return { x: cx + x1 * scale * p, y: cy + y2 * scale * p, z: z2 };
    }

    function draw() {
      if (!canvas || !ctx) return;
      const rect = canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;
      const cx = w / 2;
      const cy = h / 2;
      const scale = Math.min(w, h) * 0.4;

      ctx.clearRect(0, 0, w, h);

      const baseRGB = isDark ? '255, 255, 255' : '9, 9, 11';

      // Outer orbit
      ctx.beginPath();
      ctx.ellipse(cx, cy, scale * 1.25, scale * 0.38, -0.32, 0, Math.PI * 2);
      ctx.strokeStyle = `rgba(${baseRGB}, 0.1)`;
      ctx.lineWidth = 1;
      ctx.stroke();

      // Icosahedron
      const pOuter = verts.map((v) => project(v, cx, cy, scale));
      edges.forEach(([a, b]) => {
        const pa = pOuter[a];
        const pb = pOuter[b];
        const avgZ = (pa.z + pb.z) / 2;
        const alpha = Math.max(0.08, Math.min(0.65, 0.36 - avgZ * 0.28));
        ctx.beginPath();
        ctx.moveTo(pa.x, pa.y);
        ctx.lineTo(pb.x, pb.y);
        ctx.strokeStyle = `rgba(${baseRGB}, ${alpha.toFixed(3)})`;
        ctx.lineWidth = 1.1;
        ctx.stroke();
      });

      // Inner cobalt octahedron
      const pInner = innerVerts.map((v) => project(v, cx, cy, scale));
      innerEdges.forEach(([a, b]) => {
        const pa = pInner[a];
        const pb = pInner[b];
        const avgZ = (pa.z + pb.z) / 2;
        const alpha = Math.max(0.25, Math.min(0.95, 0.65 - avgZ * 0.3));
        ctx.beginPath();
        ctx.moveTo(pa.x, pa.y);
        ctx.lineTo(pb.x, pb.y);
        ctx.strokeStyle = `rgba(0, 87, 255, ${alpha.toFixed(3)})`;
        ctx.lineWidth = 1.25;
        ctx.stroke();
      });

      pOuter.forEach((p, idx) => {
        const accent = idx === 0 || idx === 5;
        ctx.beginPath();
        ctx.arc(p.x, p.y, accent ? 3 : 1.5, 0, Math.PI * 2);
        ctx.fillStyle = accent ? '#0057FF' : `rgba(${baseRGB}, 0.7)`;
        ctx.fill();
      });
    }

    function tick() {
      if (!prefersReduced && !isDragging) {
        rotX += 0.0018;
        rotY += 0.0035;
      }
      draw();
      requestAnimationFrame(tick);
    }

    canvas.addEventListener('pointerdown', (e) => {
      isDragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      rotY += (e.clientX - lastX) * 0.008;
      rotX += (e.clientY - lastY) * 0.008;
      lastX = e.clientX;
      lastY = e.clientY;
      draw();
    });
    canvas.addEventListener('pointerup', () => { isDragging = false; });

    window.addEventListener('resize', () => { resize(); draw(); });
    resize();
    tick();
  }
</script>
