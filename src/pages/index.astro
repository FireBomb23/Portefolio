---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutMeSpread from '../components/AboutMeSpread.astro';
import ProjectSpread from '../components/ProjectSpread.astro';
import { PROFILE, PROJECTS } from '../data/portfolio';

const marqueePhrase =
  'PROJETOS SELECIONADOS · SCROLL CONTÍNUO · WEB FULLSTACK · MOBILE FLUTTER · 3D WEBGL · JAVA MODDING · ';
---

<Layout>
  <Header />

  <main id="conteudo-principal">
    <!-- 1. Parte Pessoal -->
    <AboutMeSpread />

    <!-- 2. Transição Animada & Índice de Pastas -->
    <section id="projetos" aria-labelledby="projetos-capitulo" class="scroll-mt-14 dark-grid text-[#EDEDEA] border-t border-b border-white/10">
      <!-- Marquee contínuo -->
      <div aria-hidden="true" class="border-b border-white/10 py-3.5 overflow-hidden select-none">
        <div class="marquee-track mono text-[#EDEDEA]/80">
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
        </div>
      </div>

      <!-- Cabeçalho de Capítulo -->
      <div class="wrap pt-14 sm:pt-20 pb-10 space-y-4 reveal">
        <div class="mono text-[#EDEDEA]/60">0{PROJECTS.length} PROJETOS</div>
        <h2 id="projetos-capitulo" class="display text-[clamp(2.25rem,6vw,5.5rem)] max-w-[18ch]">
          Projetos — Sem cliques, basta fazer scroll
        </h2>
      </div>

      <!-- Separadores tipo pastas do portfolio -->
      <div class="wrap pt-4">
        <nav aria-label="Índice dos projetos" class="flex flex-wrap gap-1 border-b border-white/10">
          {PROJECTS.map((p, idx) => (
            <a
              href={`#projeto-${p.number}`}
              data-folder-tab={p.number}
              class:list={['folder-tab mono', { 'is-active': idx === 0 }]}
            >
              <span>{p.number}</span>
              <span>{p.title}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- 3. Todos os Projetos em Scroll Contínuo -->
    <div>
      {PROJECTS.map((project) => (
        <ProjectSpread project={project} />
      ))}
    </div>

    <!-- 4. Contacto -->
    <section id="contacto" aria-labelledby="contacto-titulo" class="scroll-mt-14 bg-[#0E0E0E] text-[#EDEDEA] border-t border-white/10">
      <div class="wrap py-24 space-y-8 reveal">
        <div id="contacto-titulo" class="mono text-[#9A9A94]">Contacto</div>

        <div>
          <a
            href={`mailto:${PROFILE.email}`}
            class="link display text-[clamp(1.75rem,6vw,6rem)] break-all sm:break-normal inline-block"
          >
            {PROFILE.email}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-6 mono">
          <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">GitHub ↗</a>
          <a href={PROFILE.modrinth} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">Modrinth ↗</a>
          <a href={PROFILE.curseforge} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">CurseForge ↗</a>
        </div>

        <div class="mono text-[#9A9A94]">Viseu, Portugal</div>
      </div>
    </section>
  </main>

  <Footer />

  <script is:inline>
    (function () {
      document.documentElement.classList.add('js-ready');

      var reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        var revealObserver = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );

        reveals.forEach(function (el) {
          var rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight) {
            el.classList.add('is-visible');
          } else {
            revealObserver.observe(el);
          }
        });
      } else {
        reveals.forEach(function (el) {
          el.classList.add('is-visible');
        });
      }

      var progressBar = document.getElementById('scroll-progress');
      var folderTabs = document.querySelectorAll('[data-folder-tab]');
      var navProjects = document.querySelectorAll('[data-nav-project]');
      var articles = Array.from(document.querySelectorAll('article[id^="projeto-"]'));

      function setActiveProject(num) {
        folderTabs.forEach(function (tab) {
          tab.classList.toggle('is-active', tab.getAttribute('data-folder-tab') === num);
        });
        navProjects.forEach(function (link) {
          var isMatch = link.getAttribute('data-nav-project') === num;
          link.style.color = isMatch ? 'var(--accent)' : '';
          link.style.fontWeight = isMatch ? '600' : '';
        });
      }

      function onScroll() {
        var doc = document.documentElement;
        var max = doc.scrollHeight - window.innerHeight;
        if (progressBar && max > 0) {
          var pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
          progressBar.style.width = pct.toFixed(2) + '%';
        }

        var marker = window.innerHeight * 0.35;
        var current = null;
        for (var i = 0; i < articles.length; i++) {
          var r = articles[i].getBoundingClientRect();
          if (r.top <= marker) {
            current = articles[i].id.replace('projeto-', '');
          }
        }
        if (current) setActiveProject(current);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    })();
  </script>
</Layout>
