---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutMeSpread from '../components/AboutMeSpread.astro';
import ProjectSpread from '../components/ProjectSpread.astro';
import { PROFILE, PROJECTS } from '../data/portfolio';

const marqueePhrase =
  'PROJETOS SELECIONADOS · SCROLL CONTÍNUO · WEB FULLSTACK · MOBILE FLUTTER · 3D WEBGL · JAVA MODDING · ';
---

<Layout>
  <Header />

  <main id="conteudo-principal">
    <!-- 1. Parte Pessoal (hero + data-enter + counters + 3D tilt) -->
    <AboutMeSpread />

    <!-- 2. Momento 1: word-highlight scrubbed to scroll -->
    <section
      class="paper-grid border-t border-[var(--line)] py-20 sm:py-28"
      data-moment="word-highlight"
      aria-label="Abordagem"
    >
      <div class="wrap space-y-4">
        <div class="mono text-[var(--muted)]">COMO TRABALHO</div>
        <p class="mo-wh__text">
          Desenho a interface no <strong>Figma</strong>, modelo os objetos em <strong>3D</strong> e programo a <strong>API</strong> e a <strong>base de dados</strong> — gosto de perceber e construir o sistema inteiro, sem depender de <strong>templates</strong>.
        </p>
      </div>
    </section>

    <!-- 3. Big Scene: letter-bar-floods-the-ground (sticky 2-screen zoom transitioning paper -> dark) -->
    <section
      class="sc"
      data-big-scene="letter-bar-floods-the-ground"
      data-big-scene-opts='{"hold": 1}'
      style="--h: 1"
      aria-labelledby="lbf-h"
    >
      <div class="sc__stage">
        <h2 class="lbf__line" id="lbf-h">DO CÓD<span class="lbf__pivot">I</span>GO AO 3D</h2>
        <div class="lbf__ground">
          <div class="lbf__next">
            <h2>05 Projetos — Basta fazer scroll</h2>
            <p>Da Manopla do Infinito em Java e Three.js ao portal Cyrix, LabCD e EcoGo.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Marquee & Índice em Separadores de Pasta -->
    <section
      id="projetos"
      aria-label="Índice dos projetos"
      class="scroll-mt-14 dark-grid text-[#EDEDEA] border-t border-b border-white/10"
    >
      <div aria-hidden="true" class="border-b border-white/10 py-3.5 overflow-hidden select-none">
        <div class="marquee-track mono text-[#EDEDEA]/80">
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
        </div>
      </div>

      <div class="wrap pt-6">
        <nav aria-label="Separadores dos projetos" class="flex flex-wrap gap-1 border-b border-white/10">
          {PROJECTS.map((p, idx) => (
            <a
              href={`#projeto-${p.number}`}
              data-folder-tab={p.number}
              class:list={['folder-tab mono', { 'is-active': idx === 0 }]}
            >
              <span>{p.number}</span>
              <span>{p.title}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- 5. Todos os Projetos em Scroll Contínuo -->
    <div>
      {PROJECTS.map((project) => (
        <ProjectSpread project={project} />
      ))}
    </div>

    <!-- 6. Momento 2: letters-assemble antes do contacto -->
    <section
      class="paper-grid border-t border-[var(--line)] py-20 sm:py-28"
      data-moment="letters-assemble"
      data-moment-opts='{"spread": 1.1}'
      aria-label="Chamada para contacto"
    >
      <div class="wrap">
        <h2 class="mo-la__type">VAMOS CONVERSAR</h2>
        <p class="mo-la__sub">
          Disponível para estágio curricular em 2026/27 — web fullstack, mobile ou 3D.
        </p>
      </div>
    </section>

    <!-- 7. Contacto -->
    <section id="contacto" aria-labelledby="contacto-titulo" class="scroll-mt-14 bg-[#0E0E0E] text-[#EDEDEA] border-t border-white/10">
      <div class="wrap py-24 space-y-8">
        <div id="contacto-titulo" class="mono text-[#9A9A94]">Contacto</div>

        <div>
          <a
            href={`mailto:${PROFILE.email}`}
            class="link display text-[clamp(1.75rem,6vw,6rem)] break-all sm:break-normal inline-block"
          >
            {PROFILE.email}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-6 mono">
          <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">GitHub ↗</a>
          <a href={PROFILE.modrinth} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">Modrinth ↗</a>
          <a href={PROFILE.curseforge} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">CurseForge ↗</a>
        </div>

        <div class="mono text-[#9A9A94]">Viseu, Portugal</div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reducedMotion = document.documentElement.dataset.motion === 'off';

    if (!reducedMotion) {
      document.querySelectorAll<HTMLElement>('[data-gsap-stage]').forEach((stage) => {
        gsap.fromTo(
          stage,
          { y: 48, scale: 0.94, clipPath: 'inset(6% 4% 6% 4%)' },
          {
            y: 0,
            scale: 1,
            clipPath: 'inset(0% 0% 0% 0%)',
            ease: 'power2.out',
            scrollTrigger: {
              trigger: stage,
              start: 'top 92%',
              end: 'top 38%',
              scrub: 0.5,
            },
          }
        );
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-title]').forEach((title) => {
        gsap.from(title, {
          y: 40,
          skewY: 2,
          opacity: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: title,
            start: 'top 88%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-gallery]').forEach((grid) => {
        const items = Array.from(grid.children);
        if (!items.length) return;
        gsap.from(items, {
          y: 32,
          opacity: 0,
          stagger: 0.1,
          duration: 0.6,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: grid,
            start: 'top 88%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-tilt-card]').forEach((card) => {
        card.addEventListener('pointermove', (e: PointerEvent) => {
          if (e.pointerType === 'touch') return;
          const r = card.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const nx = (e.clientX - r.left) / r.width - 0.5;
          const ny = (e.clientY - r.top) / r.height - 0.5;
          gsap.to(card, {
            rotateY: nx * 14,
            rotateX: -ny * 14,
            duration: 0.35,
            ease: 'power2.out',
            transformPerspective: 800,
          });
        });

        card.addEventListener('pointerleave', () => {
          gsap.to(card, {
            rotateX: 0,
            rotateY: 0,
            duration: 0.45,
            ease: 'power2.out',
            clearProps: 'transform',
          });
        });
      });
    }

    // Re-sync ScrollTrigger after design-taste-frontend scenes.js expands sticky scenes
    const rootObserver = new MutationObserver(() => {
      if (document.documentElement.hasAttribute('data-scenes-ready')) {
        ScrollTrigger.refresh();
      }
    });
    rootObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-scenes-ready'],
    });
    window.addEventListener('load', () => ScrollTrigger.refresh());
    setTimeout(() => ScrollTrigger.refresh(), 600);

    // Scroll progress bar & active folder tab highlighter
    const progressBar = document.getElementById('scroll-progress');
    const folderTabs = document.querySelectorAll<HTMLElement>('[data-folder-tab]');
    const navProjects = document.querySelectorAll<HTMLElement>('[data-nav-project]');
    const articles = Array.from(document.querySelectorAll<HTMLElement>('article[id^="projeto-"]'));

    function setActiveProject(num: string) {
      folderTabs.forEach((tab) => {
        tab.classList.toggle('is-active', tab.getAttribute('data-folder-tab') === num);
      });
      navProjects.forEach((link) => {
        const isMatch = link.getAttribute('data-nav-project') === num;
        link.style.color = isMatch ? 'var(--accent)' : '';
        link.style.fontWeight = isMatch ? '600' : '';
      });
    }

    function onScroll() {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (progressBar && max > 0) {
        const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
        progressBar.style.width = pct.toFixed(2) + '%';
      }

      const marker = window.innerHeight * 0.35;
      let current: string | null = null;
      for (let i = 0; i < articles.length; i++) {
        const r = articles[i].getBoundingClientRect();
        if (r.top <= marker) {
          current = articles[i].id.replace('projeto-', '');
        }
      }
      if (current) setActiveProject(current);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Layout>
