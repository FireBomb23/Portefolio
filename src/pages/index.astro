---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutMeSpread from '../components/AboutMeSpread.astro';
import ProjectSpread from '../components/ProjectSpread.astro';
import { PROFILE, PROJECTS } from '../data/portfolio';

const marqueePhrase =
  'RODRIGO ALBUQUERQUE · VISEU · WEB FULLSTACK · MOBILE FLUTTER · 3D NO BROWSER · JAVA 21 · ';

const tabColors: Record<string, string> = {
  '01': '#F5B82E',
  '02': '#0047FF',
  '03': '#F59E0B',
  '04': '#FF6B00',
  '05': '#6EE7B7',
};
---

<Layout>
  <Header />

  <main id="conteudo-principal">
    <!-- 1. Parte Pessoal (hero + data-enter + counters + 3D tilt) -->
    <AboutMeSpread />

    <!-- 2. Momento 1: word-highlight scrubbed to scroll -->
    <section
      class="paper-grid border-t border-[var(--line)] py-20 sm:py-28"
      data-moment="word-highlight"
      aria-label="Como trabalho"
    >
      <div class="wrap">
        <p class="mo-wh__text">
          Não gosto de ficar só pelo protótipo. Desenho o ecrã no <strong>Figma</strong>, fecho o modelo no <strong>Blender</strong> ou no <strong>Blockbench</strong>, e depois escrevo o código — da <strong>base de dados</strong> ao que corre no <strong>browser</strong>.
        </p>
      </div>
    </section>

    <!-- 3. Big Scene: letter-bar-floods-the-ground (sticky 2-screen zoom transitioning paper -> dark) -->
    <section
      class="sc"
      data-big-scene="letter-bar-floods-the-ground"
      data-big-scene-opts='{"hold": 1}'
      style="--h: 1"
      aria-labelledby="lbf-h"
    >
      <div class="sc__stage">
        <h2 class="lbf__line" id="lbf-h">DO CÓD<span class="lbf__pivot">I</span>GO AO 3D</h2>
        <div class="lbf__ground">
          <div class="lbf__next">
            <h2>5 projetos. Sem cliques obrigatórios.</h2>
            <p>Continua a descer — podes rodar as peças 3D, testar a calculadora da ESTGV e ver os ecrãs reais de cada trabalho.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Marquee & Índice em Separadores de Pasta -->
    <section
      id="projetos"
      aria-label="Índice dos projetos"
      class="scroll-mt-14 dark-grid text-[#EDEDEA] border-t border-b border-white/10"
    >
      <div aria-hidden="true" class="border-b border-white/10 py-3.5 overflow-hidden select-none">
        <div class="marquee-track mono text-[#EDEDEA]/80">
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
        </div>
      </div>

      <div class="wrap pt-6">
        <nav aria-label="Separadores dos projetos" class="flex flex-wrap gap-1 border-b border-white/10">
          {PROJECTS.map((p, idx) => (
            <a
              href={`#projeto-${p.number}`}
              data-folder-tab={p.number}
              class:list={['folder-tab mono', { 'is-active': idx === 0 }]}
            >
              <span
                aria-hidden="true"
                class="w-2 h-2 inline-block shrink-0"
                style={`background:${tabColors[p.number] || '#0047FF'};`}
              ></span>
              <span>{p.number}</span>
              <span>{p.title}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- 5. Todos os Projetos em Scroll Contínuo -->
    <div>
      {PROJECTS.map((project) => (
        <ProjectSpread project={project} />
      ))}
    </div>

    <!-- 6. Momento 2: letters-assemble antes do contacto -->
    <section
      class="paper-grid border-t border-[var(--line)] py-20 sm:py-28"
      data-moment="letters-assemble"
      data-moment-opts='{"spread": 1.1}'
      aria-label="Chamada para contacto"
    >
      <div class="wrap">
        <h2 class="mo-la__type">VAMOS CONVERSAR</h2>
        <p class="mo-la__sub">
          Procuro estágio curricular para 2026/27 em web, mobile ou 3D. Se gostaste do que viste, manda-me um email.
        </p>
      </div>
    </section>

    <!-- 7. Contacto -->
    <section id="contacto" aria-labelledby="contacto-titulo" class="scroll-mt-14 bg-[#0E0E0E] text-[#EDEDEA] border-t border-white/10">
      <div class="wrap py-20 sm:py-24 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end">
        <div class="lg:col-span-7 space-y-6">
          <div id="contacto-titulo" class="mono text-[#A8A8A0]">
            ESTÁGIO CURRICULAR 2026/27 · VISEU / REMOTO
          </div>

          <p class="text-base sm:text-lg text-[#EDEDEA]/85 leading-relaxed max-w-[54ch]">
            Respondo rápido por email. Também podes ver o código no GitHub ou descarregar o mod no Modrinth e no CurseForge.
          </p>

          <div>
            <a
              href={`mailto:${PROFILE.email}`}
              class="link display text-[clamp(1.15rem,3vw,2.75rem)] inline-block max-w-full text-[#EDEDEA]"
            >
              {PROFILE.email}
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="border border-white/15 divide-y divide-white/15 bg-white/[0.02]">
            <a
              href={PROFILE.github}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 p-4 sm:p-5 hover:bg-white/[0.06] transition-colors"
            >
              <div>
                <div class="text-sm sm:text-base font-semibold text-[#EDEDEA]">GitHub</div>
                <div class="mono text-[11px] text-[#A8A8A0]">@FireBomb23 · Repositórios e código</div>
              </div>
              <span class="mono text-[#EDEDEA]/80 group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <a
              href={PROFILE.modrinth}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 p-4 sm:p-5 hover:bg-white/[0.06] transition-colors"
            >
              <div>
                <div class="text-sm sm:text-base font-semibold text-[#EDEDEA]">Modrinth</div>
                <div class="mono text-[11px] text-[#A8A8A0]">Infinity Nova · 715+ downloads</div>
              </div>
              <span class="mono text-[#EDEDEA]/80 group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <a
              href={PROFILE.curseforge}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 p-4 sm:p-5 hover:bg-white/[0.06] transition-colors"
            >
              <div>
                <div class="text-sm sm:text-base font-semibold text-[#EDEDEA]">CurseForge</div>
                <div class="mono text-[11px] text-[#A8A8A0]">Infinity Nova · Modpack &amp; releases</div>
              </div>
              <span class="mono text-[#EDEDEA]/80 group-hover:translate-x-1 transition-transform">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reducedMotion = document.documentElement.dataset.motion === 'off';

    if (!reducedMotion) {
      const heroDesk = document.querySelector<HTMLElement>('[data-hero-desk]');
      const heroFloats = document.querySelectorAll<HTMLElement>('[data-hero-float]');

      if (heroFloats.length > 0) {
        gsap.from(heroFloats, {
          scale: 0.78,
          opacity: 0,
          y: 36,
          stagger: 0.08,
          duration: 0.85,
          ease: 'back.out(1.35)',
        });

        heroFloats.forEach((card) => {
          const depth = parseFloat(card.getAttribute('data-float-depth') || '1');
          if (heroDesk) {
            gsap.to(card, {
              y: -36 * depth,
              ease: 'none',
              scrollTrigger: {
                trigger: heroDesk,
                start: 'top top',
                end: 'bottom top',
                scrub: 0.5,
              },
            });
          }
        });

        if (heroDesk) {
          heroDesk.addEventListener('pointermove', (e: PointerEvent) => {
            if (e.pointerType === 'touch') return;
            const r = heroDesk.getBoundingClientRect();
            if (!r.width || !r.height) return;
            const nx = (e.clientX - r.left) / r.width - 0.5;
            const ny = (e.clientY - r.top) / r.height - 0.5;
            heroFloats.forEach((card) => {
              const depth = parseFloat(card.getAttribute('data-float-depth') || '1');
              gsap.to(card, {
                x: nx * 28 * depth,
                rotateY: nx * 8 * depth,
                rotateX: -ny * 7 * depth,
                duration: 0.45,
                ease: 'power2.out',
                transformPerspective: 900,
              });
            });
          });

          heroDesk.addEventListener('pointerleave', () => {
            heroFloats.forEach((card) => {
              gsap.to(card, {
                x: 0,
                rotateX: 0,
                rotateY: 0,
                duration: 0.6,
                ease: 'power3.out',
              });
            });
          });
        }
      }

      const polaroidCards = document.querySelectorAll<HTMLElement>('[data-polaroid-card]');
      if (polaroidCards.length > 0) {
        gsap.from(polaroidCards, {
          y: 30,
          opacity: 0,
          scale: 0.92,
          stagger: 0.08,
          duration: 0.6,
          ease: 'back.out(1.4)',
          scrollTrigger: {
            trigger: polaroidCards[0],
            start: 'top 90%',
            once: true,
          },
        });
      }

      document.querySelectorAll<HTMLElement>('[data-gsap-card]').forEach((card) => {
        gsap.from(card, {
          y: 32,
          opacity: 0,
          duration: 0.65,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 90%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-dossier]').forEach((dossier) => {
        const blocks = Array.from(dossier.children);
        if (!blocks.length) return;
        gsap.from(blocks, {
          y: 26,
          opacity: 0,
          stagger: 0.08,
          duration: 0.55,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: dossier,
            start: 'top 88%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-stage]').forEach((stage) => {
        gsap.fromTo(
          stage,
          { y: 48, scale: 0.94, clipPath: 'inset(6% 4% 6% 4%)' },
          {
            y: 0,
            scale: 1,
            clipPath: 'inset(0% 0% 0% 0%)',
            ease: 'power2.out',
            scrollTrigger: {
              trigger: stage,
              start: 'top 92%',
              end: 'top 38%',
              scrub: 0.5,
            },
          }
        );
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-title]').forEach((title) => {
        gsap.from(title, {
          y: 40,
          skewY: 2,
          opacity: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: title,
            start: 'top 88%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-gallery]').forEach((grid) => {
        const items = Array.from(grid.children);
        if (!items.length) return;
        gsap.from(items, {
          y: 32,
          opacity: 0,
          stagger: 0.1,
          duration: 0.6,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: grid,
            start: 'top 88%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-tilt-card]').forEach((card) => {
        card.addEventListener('pointermove', (e: PointerEvent) => {
          if (e.pointerType === 'touch') return;
          const r = card.getBoundingClientRect();
          if (!r.width || !r.height) return;
          const nx = (e.clientX - r.left) / r.width - 0.5;
          const ny = (e.clientY - r.top) / r.height - 0.5;
          gsap.to(card, {
            rotateY: nx * 14,
            rotateX: -ny * 14,
            duration: 0.35,
            ease: 'power2.out',
            transformPerspective: 800,
          });
        });

        card.addEventListener('pointerleave', () => {
          gsap.to(card, {
            rotateX: 0,
            rotateY: 0,
            duration: 0.45,
            ease: 'power2.out',
            clearProps: 'transform',
          });
        });
      });
    }

    // Re-sync ScrollTrigger after design-taste-frontend scenes.js expands sticky scenes
    const rootObserver = new MutationObserver(() => {
      if (document.documentElement.hasAttribute('data-scenes-ready')) {
        ScrollTrigger.refresh();
      }
    });
    rootObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-scenes-ready'],
    });
    window.addEventListener('load', () => ScrollTrigger.refresh());
    setTimeout(() => ScrollTrigger.refresh(), 600);

    // Scroll progress bar & active folder tab highlighter
    const progressBar = document.getElementById('scroll-progress');
    const folderTabs = document.querySelectorAll<HTMLElement>('[data-folder-tab]');
    const navProjects = document.querySelectorAll<HTMLElement>('[data-nav-project]');
    const articles = Array.from(document.querySelectorAll<HTMLElement>('article[id^="projeto-"]'));

    function setActiveProject(num: string) {
      folderTabs.forEach((tab) => {
        tab.classList.toggle('is-active', tab.getAttribute('data-folder-tab') === num);
      });
      navProjects.forEach((link) => {
        const isMatch = link.getAttribute('data-nav-project') === num;
        link.style.color = isMatch ? 'var(--accent)' : '';
        link.style.fontWeight = isMatch ? '600' : '';
      });
    }

    function onScroll() {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (progressBar && max > 0) {
        const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
        progressBar.style.width = pct.toFixed(2) + '%';
      }

      const marker = window.innerHeight * 0.35;
      let current: string | null = null;
      for (let i = 0; i < articles.length; i++) {
        const r = articles[i].getBoundingClientRect();
        if (r.top <= marker) {
          current = articles[i].id.replace('projeto-', '');
        }
      }
      if (current) setActiveProject(current);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Layout>
