---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import { PROFILE, PROJECTS, USES, TIMELINE } from '../data/portfolio';
---

<Layout>
  <Header />

  <main id="conteudo-principal">
    <!-- Hero -->
    <section class="enter wrap min-h-[calc(100svh-56px)] flex flex-col justify-between py-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pb-4 border-b border-[var(--line)] mono text-[var(--muted)]">
        <span>3.º ano · ESTGV, Viseu</span>
        <span>À procura de estágio 2026/27</span>
        <span class="sm:text-right">
          <a href={`mailto:${PROFILE.email}`} class="link text-[var(--ink)]">{PROFILE.email}</a>
        </span>
      </div>

      <div class="pt-16 pb-4">
        <h1 class="display text-[clamp(2.25rem,10.5vw,13rem)]">
          Rodrigo<br />Albuquerque
        </h1>
        <p class="max-w-[52ch] text-lg md:text-xl mt-8 leading-snug text-[var(--ink)]">
          Estudo Tecnologias e Design de Multimédia na ESTGV. Faço sites, apps e mods de Minecraft, e gosto de perceber cada parte — da base de dados ao modelo 3D.
        </p>
      </div>
    </section>

    <!-- Projetos -->
    <section id="projetos" aria-labelledby="projetos-titulo" class="scroll-mt-14 wrap pt-16 pb-20">
      <div class="border-t border-[var(--line)] pt-8 pb-8 flex items-baseline justify-between">
        <h2 id="projetos-titulo" class="display text-[clamp(2rem,4vw,3.5rem)]">
          Projetos
        </h2>
        <span class="mono text-[var(--muted)]">0{PROJECTS.length}</span>
      </div>

      <div>
        {PROJECTS.map((project) => (
          <a href={`/projetos/${project.slug}`} class="group block border-t border-[var(--line)] py-8">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-6 items-baseline">
              <span class="mono text-[var(--muted)] md:col-span-1">{project.number}</span>

              <h3 class="display text-[clamp(2rem,5vw,4.5rem)] md:col-span-5 text-[var(--ink)] group-hover:text-[var(--accent)] transition-colors">
                {project.title}<span aria-hidden="true" class="inline-block ml-2 transition-transform duration-200 group-hover:translate-x-1">→</span>
              </h3>

              <p class="text-base text-[var(--muted)] md:col-span-4 leading-snug">
                {project.oneLiner}
              </p>

              <span class="mono text-[var(--muted)] md:col-span-2 md:text-right">
                {project.kind} · {project.year}
              </span>
            </div>

            <div class="mt-6">
              <ProjectMedia project={project} />
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Sobre -->
    <section id="sobre" aria-labelledby="sobre-titulo" class="scroll-mt-14 wrap py-20 border-t border-[var(--line)]">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
        <div class="md:col-span-3">
          <h2 id="sobre-titulo" class="display text-[clamp(2rem,4vw,3.5rem)]">
            Sobre
          </h2>
        </div>

        <div class="md:col-span-8 md:col-start-5 space-y-12">
          <p class="text-xl md:text-2xl leading-snug">
            Estou no 3.º ano de Tecnologias e Design de Multimédia na ESTGV, em Viseu. O curso mistura design e programação, e eu gosto das duas partes: tanto desenho os ecrãs no Figma como escrevo a API e a base de dados por trás. O projeto de que mais gosto é o Infinity Nova, porque fiz tudo sozinho — código, modelos, texturas e site. Procuro estágio para 2026/27 em desenvolvimento web, mobile ou 3D.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-10 pt-10 border-t border-[var(--line)]">
            <div class="space-y-3">
              <h3 class="mono text-[var(--muted)]">Uso</h3>
              <p class="text-base leading-relaxed">{USES}</p>
            </div>

            <div class="space-y-3">
              <h3 class="mono text-[var(--muted)]">Percurso</h3>
              <div class="space-y-5">
                {TIMELINE.map((t) => (
                  <div class="space-y-1">
                    <div class="mono text-[var(--muted)]">{t.period} · {t.place}</div>
                    <div class="text-base font-medium">{t.title}</div>
                    <p class="text-sm text-[var(--muted)] leading-snug">{t.description}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" aria-labelledby="contacto-titulo" class="scroll-mt-14 bg-[#0E0E0E] text-[#EDEDEA]">
      <div class="wrap py-24 space-y-8">
        <div id="contacto-titulo" class="mono text-[#9A9A94]">Contacto</div>

        <div>
          <a
            href={`mailto:${PROFILE.email}`}
            class="link display text-[clamp(1.75rem,6vw,6rem)] break-all sm:break-normal inline-block"
          >
            {PROFILE.email}
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-6 mono">
          <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">GitHub ↗</a>
          <a href={PROFILE.modrinth} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">Modrinth ↗</a>
          <a href={PROFILE.curseforge} target="_blank" rel="noopener noreferrer" class="link text-[#EDEDEA]">CurseForge ↗</a>
        </div>

        <div class="mono text-[#9A9A94]">Viseu, Portugal</div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
