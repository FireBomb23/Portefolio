---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AboutMeSpread from '../components/AboutMeSpread.astro';
import ProjectSpread from '../components/ProjectSpread.astro';
import SceneTransition from '../components/SceneTransition.astro';
import { PROFILE, PROJECTS } from '../data/portfolio';

const marqueePhrase =
  'RODRIGO ALBUQUERQUE · VISEU · WEB FULLSTACK · MOBILE FLUTTER · 3D NO BROWSER · JAVA 21 · ';

const tabColors: Record<string, string> = {
  '01': '#F5B82E',
  '02': '#0047FF',
  '03': '#F59E0B',
  '04': '#FF6B00',
  '05': '#6EE7B7',
};

const PROJECT_TRANSITIONS: Record<string, {
  id: string;
  kind: 'horizon-slit' | 'shutter-split' | 'laser-scanline' | 'iris-viewport' | 'canopy-rise';
  fromBg: string;
  toBg: string;
  accent: string;
  fromInk?: string;
  fromMuted?: string;
  toInk?: string;
  toMuted?: string;
  fromLabel: string;
  toLabel: string;
  stepNum: string;
  headline: string;
  subline: string;
  tags: string[];
}> = {
  '01': {
    id: 'portal-01-02',
    kind: 'shutter-split',
    fromBg: '#08090F',
    toBg: '#F3F3F1',
    accent: '#0047FF',
    fromInk: '#F0F2F5',
    fromMuted: '#9496A1',
    toInk: '#0D131A',
    toMuted: '#4A5568',
    fromLabel: '01 · INFINITY NOVA (JAVA 21 & WEBGL)',
    toLabel: '02 · LABCD (FLUTTER & POSTGRESQL)',
    stepNum: '01 → 02',
    headline: 'DO UNIVERSO 3D PARA A CLÍNICA REAL.',
    subline: 'Saímos do mod em Java 21 e do palco Three.js para entrar num laboratório de próteses dentárias com aplicação offline-first e regras clínicas em PL/pgSQL.',
    tags: ['Flutter Offline', 'SQLite ↔ Django REST', '15 Tabelas PostgreSQL'],
  },
  '02': {
    id: 'portal-02-03',
    kind: 'laser-scanline',
    fromBg: '#F3F3F1',
    toBg: '#070D19',
    accent: '#F59E0B',
    fromInk: '#0D131A',
    fromMuted: '#4A5568',
    toInk: '#F8FAFC',
    toMuted: '#94A3B8',
    fromLabel: '02 · LABCD (MOBILE & CLÍNICA)',
    toLabel: '03 · CYRIX (PORTAL NIS2 & 2FA)',
    stepNum: '02 → 03',
    headline: 'DA BANCADA CLÍNICA À CIBERSEGURANÇA.',
    subline: 'O varrimento tático muda o palco para a diretiva europeia NIS2: diagnóstico interativo, catálogo de serviços e área de cliente protegida por JWT e 2FA.',
    tags: ['React + TypeScript', 'Express + Django Dual-API', 'Autenticação 2FA'],
  },
  '03': {
    id: 'portal-03-04',
    kind: 'iris-viewport',
    fromBg: '#070D19',
    toBg: '#111215',
    accent: '#FF6B00',
    fromInk: '#F8FAFC',
    fromMuted: '#94A3B8',
    toInk: '#F3F3F0',
    toMuted: '#9A9B96',
    fromLabel: '03 · CYRIX (CIBERSEGURANÇA NIS2)',
    toLabel: '04 · COMPUTAÇÃO GRÁFICA (BLENDER & 3D)',
    stepNum: '03 → 04',
    headline: 'DO BACKOFFICE DE SEGURANÇA AO ESTÚDIO 3D.',
    subline: 'A lente abre para o pipeline de Computação Gráfica: modelação com blueprints no Blender, geometria low-poly em Blockbench e texturas UV 64×64 a 60 fps.',
    tags: ['Blender PBR', 'Blockbench .geo.json', 'Three.js 60fps'],
  },
  '04': {
    id: 'portal-04-05',
    kind: 'canopy-rise',
    fromBg: '#111215',
    toBg: '#0B251A',
    accent: '#6EE7B7',
    fromInk: '#F3F3F0',
    fromMuted: '#9A9B96',
    toInk: '#F4EFE6',
    toMuted: '#A7F3D0',
    fromLabel: '04 · COMPUTAÇÃO GRÁFICA (ESTÚDIO 3D)',
    toLabel: '05 · ECOGO (CAMPUS ESTGV VISEU)',
    stepNum: '04 → 05',
    headline: 'DO ESTÚDIO VIRTUAL PARA O CAMPUS DE VISEU.',
    subline: 'Subimos até ao programa Eco-Escolas da ESTGV: identidade visual de raiz, protótipo mobile no Figma e calculadora de emissões de CO₂ em tempo real.',
    tags: ['Identidade & UI Figma', 'Eco-Escolas ESTGV', 'Simulador CO₂ JS'],
  },
};
---

<Layout>
  <Header />

  <main id="conteudo-principal">
    <!-- 1. Sobre Mim: Live WebGL Shader Hero + Radial Hub Diagram + Light Editorial Bento -->
    <AboutMeSpread />

    <!-- 2. Big Scene 1: Manopla cai por entre tipografia gigante ao fazer scroll -->
    <section
      class="sc world-light border-b border-black/10"
      data-big-scene="object-through-giant-type"
      data-big-scene-opts='{"hold": 1}'
      style="--h: 1"
      aria-label="Da ideia à engenharia"
    >
      <div class="sc__stage">
        <blockquote class="ott__quote">
          <p class="ott__line"><span class="ott__half">DO FIGMA</span> <span class="ott__half">AO 3D</span></p>
          <p class="ott__line"><span class="ott__half">DO JAVA</span> <span class="ott__half">À WEB</span></p>
          <p class="ott__line"><span class="ott__half">DA API</span> <span class="ott__half">AOS DADOS</span></p>
          <p class="ott__line"><span class="ott__half">TUDO DE</span> <span class="ott__half">RAIZ</span></p>
        </blockquote>
        <div class="ott__object" data-move>
          <img
            class="ott__img pixel"
            src="/infinity-nova/textures/manopla.png"
            alt="Manopla do Infinito em pixel art"
            width="320"
            height="320"
          />
        </div>
        <p class="ott__credit">Rodrigo Albuquerque · ESTGV Viseu</p>
      </div>
    </section>

    <!-- 3. Momento 1: word-highlight scrubbed to scroll -->
    <section
      class="world-light py-20 sm:py-28 border-b border-black/10"
      data-moment="word-highlight"
      aria-label="Como trabalho"
    >
      <div class="wrap">
        <p class="mo-wh__text">
          Não gosto de ficar só pelo protótipo. Desenho o ecrã no <strong>Figma</strong>, fecho o modelo no <strong>Blender</strong> ou no <strong>Blockbench</strong>, e depois escrevo o código — da <strong>base de dados</strong> ao que corre no <strong>browser</strong>.
        </p>
      </div>
    </section>

    <!-- 4. Big Scene 2: letter-bar-floods-the-ground transitioning paper -> dark projects -->
    <section
      class="sc"
      data-big-scene="letter-bar-floods-the-ground"
      data-big-scene-opts='{"hold": 1}'
      style="--h: 1"
      aria-labelledby="lbf-h"
    >
      <div class="sc__stage">
        <h2 class="lbf__line" id="lbf-h">DO CÓD<span class="lbf__pivot">I</span>GO AO 3D</h2>
        <div class="lbf__ground">
          <div class="lbf__next">
            <h2>5 projetos. Sem cliques obrigatórios.</h2>
            <p>Continua a descer — podes rodar as peças 3D, ver a app offline a montar-se no ecrã e testar a calculadora da ESTGV.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Marquee & Índice em Separadores de Pasta -->
    <section
      id="projetos"
      aria-label="Índice dos projetos"
      class="scroll-mt-14 bg-[#08090F] text-[#EDEDEA] border-t border-b border-white/10"
    >
      <div aria-hidden="true" class="border-b border-white/10 py-3.5 overflow-hidden select-none">
        <div class="marquee-track mono text-[#EDEDEA]/80">
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
          <span class="pr-4">{marqueePhrase}{marqueePhrase}</span>
        </div>
      </div>

      <div class="wrap pt-6">
        <nav aria-label="Separadores dos projetos" class="flex flex-wrap gap-1 border-b border-white/10">
          {PROJECTS.map((p, idx) => (
            <a
              href={`#projeto-${p.number}`}
              data-folder-tab={p.number}
              class:list={['folder-tab mono', { 'is-active': idx === 0 }]}
            >
              <span
                aria-hidden="true"
                class="w-2 h-2 inline-block shrink-0"
                style={`background:${tabColors[p.number] || '#0047FF'};`}
              ></span>
              <span>{p.number}</span>
              <span>{p.title}</span>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <!-- 6. Todos os Projetos com Arquitetura, Mundo Próprio e Transições entre Cenas -->
    <div>
      {PROJECTS.map((project) => (
        <>
          <ProjectSpread project={project} />
          {PROJECT_TRANSITIONS[project.number] && (
            <SceneTransition {...PROJECT_TRANSITIONS[project.number]} />
          )}
        </>
      ))}
    </div>

    <!-- 7. Momento 2: letters-assemble antes do contacto -->
    <section
      class="world-light border-t border-black/10 py-20 sm:py-28"
      data-moment="letters-assemble"
      data-moment-opts='{"spread": 1.1}'
      aria-label="Chamada para contacto"
    >
      <div class="wrap">
        <h2 class="mo-la__type">VAMOS CONVERSAR</h2>
        <p class="mo-la__sub">
          Procuro estágio curricular para 2026/27 em web, mobile ou 3D. Se gostaste do que viste, manda-me um email.
        </p>
      </div>
    </section>

    <!-- 8. Contacto -->
    <section id="contacto" aria-labelledby="contacto-titulo" class="scroll-mt-14 bg-[#070709] text-[#F2F2EF] border-t border-white/10">
      <div class="wrap py-20 sm:py-24 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end">
        <div class="lg:col-span-7 space-y-6">
          <div id="contacto-titulo" class="mono text-[#9A9B9F]">
            ESTÁGIO CURRICULAR 2026/27 · VISEU / REMOTO
          </div>

          <p class="text-base sm:text-lg text-[#F2F2EF]/85 leading-relaxed max-w-[54ch]">
            Respondo rápido por email. Também podes ver o código no GitHub ou descarregar o mod no Modrinth e no CurseForge.
          </p>

          <div>
            <a
              href={`mailto:${PROFILE.email}`}
              class="link display text-[clamp(1.15rem,3vw,2.75rem)] inline-block max-w-full text-[#F2F2EF]"
            >
              {PROFILE.email}
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="border border-white/15 divide-y divide-white/15 bg-white/[0.02]">
            <a
              href={PROFILE.github}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 p-4 sm:p-5 hover:bg-white/[0.06] transition-colors"
            >
              <div>
                <div class="text-sm sm:text-base font-semibold text-[#F2F2EF]">GitHub</div>
                <div class="mono text-[11px] text-[#9A9B9F]">@FireBomb23 · Repositórios e código</div>
              </div>
              <span class="mono text-[#F2F2EF]/80 group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <a
              href={PROFILE.modrinth}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 p-4 sm:p-5 hover:bg-white/[0.06] transition-colors"
            >
              <div>
                <div class="text-sm sm:text-base font-semibold text-[#F2F2EF]">Modrinth</div>
                <div class="mono text-[11px] text-[#9A9B9F]">Infinity Nova · 715+ downloads</div>
              </div>
              <span class="mono text-[#F2F2EF]/80 group-hover:translate-x-1 transition-transform">↗</span>
            </a>

            <a
              href={PROFILE.curseforge}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center justify-between gap-4 p-4 sm:p-5 hover:bg-white/[0.06] transition-colors"
            >
              <div>
                <div class="text-sm sm:text-base font-semibold text-[#F2F2EF]">CurseForge</div>
                <div class="mono text-[11px] text-[#9A9B9F]">Infinity Nova · Modpack &amp; releases</div>
              </div>
              <span class="mono text-[#F2F2EF]/80 group-hover:translate-x-1 transition-transform">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const reducedMotion = document.documentElement.dataset.motion === 'off';

    if (!reducedMotion) {
      document.querySelectorAll<HTMLElement>('[data-gsap-stage]').forEach((stage) => {
        gsap.fromTo(
          stage,
          { y: 36, scale: 0.96 },
          {
            y: 0,
            scale: 1,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: stage,
              start: 'top 92%',
              end: 'top 42%',
              scrub: 0.5,
            },
          }
        );
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-title]').forEach((title) => {
        gsap.from(title, {
          y: 32,
          opacity: 0,
          duration: 0.65,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: title,
            start: 'top 90%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-gsap-dossier]').forEach((dossier) => {
        gsap.from(dossier, {
          y: 28,
          opacity: 0,
          duration: 0.65,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: dossier,
            start: 'top 88%',
            once: true,
          },
        });
      });

      document.querySelectorAll<HTMLElement>('[data-scene-portal]').forEach((portal) => {
        ScrollTrigger.create({
          trigger: portal,
          start: 'top 90%',
          end: 'top 25%',
          scrub: 0.35,
          onUpdate: (self) => {
            const p = 0.04 + self.progress * 0.96;
            portal.style.setProperty('--st-p', p.toFixed(4));
          },
        });

        const targets = portal.querySelectorAll<HTMLElement>('.scene-portal__content');
        if (targets.length) {
          gsap.fromTo(
            targets,
            { y: 24, opacity: 0.35 },
            {
              y: 0,
              opacity: 1,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: portal,
                start: 'top 88%',
                end: 'top 42%',
                scrub: 0.35,
              },
            }
          );
        }
      });
    }

    const rootObserver = new MutationObserver(() => {
      if (document.documentElement.hasAttribute('data-scenes-ready')) {
        ScrollTrigger.refresh();
      }
    });
    rootObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-scenes-ready', 'data-moments-ready'],
    });
    window.addEventListener('load', () => ScrollTrigger.refresh());
    setTimeout(() => ScrollTrigger.refresh(), 900);

    const progressBar = document.getElementById('scroll-progress');
    const folderTabs = document.querySelectorAll<HTMLElement>('[data-folder-tab]');
    const navProjects = document.querySelectorAll<HTMLElement>('[data-nav-project]');
    const articles = Array.from(document.querySelectorAll<HTMLElement>('article[id^="projeto-"]'));

    function setActiveProject(num: string) {
      folderTabs.forEach((tab) => {
        tab.classList.toggle('is-active', tab.getAttribute('data-folder-tab') === num);
      });
      navProjects.forEach((link) => {
        const isMatch = link.getAttribute('data-nav-project') === num;
        link.style.color = isMatch ? 'var(--accent)' : '';
        link.style.fontWeight = isMatch ? '600' : '';
      });
    }

    function onScroll() {
      const doc = document.documentElement;
      const max = doc.scrollHeight - window.innerHeight;
      if (progressBar && max > 0) {
        const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
        progressBar.style.width = pct.toFixed(2) + '%';
      }

      const marker = window.innerHeight * 0.35;
      let current: string | null = null;
      for (let i = 0; i < articles.length; i++) {
        const r = articles[i].getBoundingClientRect();
        if (r.top <= marker) {
          current = articles[i].id.replace('projeto-', '');
        }
      }
      if (current) setActiveProject(current);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</Layout>
