    function setLang(lang: 'pt' | 'en') {
      document.documentElement.lang = lang === 'pt' ? 'pt-PT' : 'en';
      const table = dict[lang];
      document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
        const key = el.dataset.i18n;
        if (key && table[key]) el.textContent = table[key];
      });
      document.querySelectorAll<HTMLButtonElement>('.lang-btn, .lang-btn-mobile').forEach((b) => {
        const active = b.dataset.lang === lang;
        b.setAttribute('aria-pressed', String(active));
        b.className = b.classList.contains('lang-btn')
          ? `lang-btn px-2 py-0.5 rounded-full cursor-pointer ${active ? 'bg-[var(--ink)] text-[var(--bg)] font-semibold' : 'text-[var(--ink-secondary)] hover:text-[var(--ink)]'}`
          : `lang-btn-mobile px-2.5 py-1 rounded-full ${active ? 'bg-[var(--ink)] text-[var(--bg)]' : 'hl-all text-[var(--ink-secondary)]'}`;
      });
    }

    document.querySelectorAll<HTMLButtonElement>('.lang-btn, .lang-btn-mobile').forEach((b) => {
      b.addEventListener('click', () => {
        const l = b.dataset.lang === 'en' ? 'en' : 'pt';
        setLang(l);
      });
    });
  </script>
