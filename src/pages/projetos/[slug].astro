---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InfinityNovaViewer3D from '../../components/InfinityNovaViewer3D.astro';
import { PROFILE, PROJECTS } from '../../data/portfolio';
import type { Project } from '../../data/portfolio';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return PROJECTS.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      nextProject: PROJECTS[(index + 1) % PROJECTS.length],
    },
  }));
}

interface Props {
  project: Project;
  nextProject: Project;
}

const { project, nextProject } = Astro.props;
---

<Layout
  title={`${project.title} — ${PROFILE.displayName}`}
  description={project.oneLiner}
>
  <Header />

  <main id="conteudo-principal">
    <!-- Cabeçalho do projeto -->
    <section class="wrap pt-10 pb-12">
      <a href={withBase('/#projetos')} class="link mono text-[var(--ink)] inline-block">
        ← Projetos
      </a>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-4 items-baseline">
        <span class="mono text-[var(--muted)] md:col-span-1">{project.number}</span>
        <h1 class="display text-[clamp(2.25rem,9vw,9rem)] md:col-span-11">
          {project.title}
        </h1>
      </div>

      <dl class="mt-12 pt-6 border-t border-[var(--line)] grid grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="space-y-1">
          <dt class="mono text-[var(--muted)]">Ano</dt>
          <dd class="text-sm">{project.year}</dd>
        </div>
        <div class="space-y-1">
          <dt class="mono text-[var(--muted)]">Contexto</dt>
          <dd class="text-sm">{project.context}</dd>
        </div>
        <div class="space-y-1">
          <dt class="mono text-[var(--muted)]">Papel</dt>
          <dd class="text-sm">{project.role}</dd>
        </div>
        <div class="space-y-1">
          <dt class="mono text-[var(--muted)]">Tecnologias</dt>
          <dd class="text-sm">{project.stack.join(', ')}</dd>
        </div>
      </dl>
    </section>

    <!-- Capa -->
    <section style={`background:${project.ground}; color:${project.ink};`}>
      {project.cover.type === 'viewer' && (
        <InfinityNovaViewer3D initial={project.cover.model} />
      )}

      {project.cover.type === 'image' && (
        <div class="wrap py-12">
          <div class="media">
            <img
              src={withBase(project.cover.src)}
              alt={project.cover.alt}
              class:list={['w-full h-auto', { pixel: project.cover.pixelated }]}
            />
          </div>
        </div>
      )}

      {project.cover.type === 'type' && (
        <div class="wrap min-h-[60vh] flex items-end py-10">
          <span class="display text-[clamp(2.5rem,10vw,11rem)]">
            {project.title}
          </span>
        </div>
      )}
    </section>

    <!-- Texto editorial -->
    <section class="wrap py-20 divide-y divide-[var(--line)]">
      <div class="pb-12 grid grid-cols-1 md:grid-cols-12 gap-6">
        <h2 class="mono text-[var(--muted)] md:col-span-3">O que é</h2>
        <p class="md:col-span-8 md:col-start-5 text-[clamp(1.25rem,2vw,1.75rem)] leading-snug">
          {project.about}
        </p>
      </div>

      <div class="py-12 grid grid-cols-1 md:grid-cols-12 gap-6">
        <h2 class="mono text-[var(--muted)] md:col-span-3">O que fiz</h2>
        <p class="md:col-span-8 md:col-start-5 text-[clamp(1.25rem,2vw,1.75rem)] leading-snug">
          {project.work}
        </p>
      </div>

      <div class="py-12 grid grid-cols-1 md:grid-cols-12 gap-6">
        <h2 class="mono text-[var(--muted)] md:col-span-3">Detalhes</h2>
        <ul class="md:col-span-8 md:col-start-5 divide-y divide-[var(--line)] border-t border-b border-[var(--line)]">
          {project.details.map((item) => (
            <li class="py-4 text-base leading-snug">{item}</li>
          ))}
        </ul>
      </div>

      {project.links.length > 0 && (
        <div class="pt-12 grid grid-cols-1 md:grid-cols-12 gap-6">
          <h2 class="mono text-[var(--muted)] md:col-span-3">Links</h2>
          <div class="md:col-span-8 md:col-start-5 flex flex-wrap items-center gap-6 mono">
            {project.links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link text-[var(--ink)]"
              >
                {l.label} ↗
              </a>
            ))}
          </div>
        </div>
      )}
    </section>

    <!-- Galeria -->
    {project.gallery.length > 0 && (
      <section aria-label="Galeria do projeto" class="wrap pb-20">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {project.gallery.map((item) => (
            <div
              class:list={[
                'media',
                item.span === 'full' ? 'md:col-span-2' : 'aspect-[16/10]',
                item.contain ? 'p-6 sm:p-10 flex items-center justify-center' : '',
              ]}
              style={`background:${project.ground};`}
            >
              <img
                src={withBase(item.src)}
                alt={item.alt}
                loading="lazy"
                class:list={[
                  item.contain
                    ? item.span === 'full'
                      ? 'w-full h-auto object-contain'
                      : 'w-full h-full object-contain'
                    : 'w-full h-full object-cover object-top',
                  { pixel: item.pixelated },
                ]}
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Seguinte -->
    <a href={withBase(`/projetos/${nextProject.slug}`)} class="group block border-t border-[var(--line)]">
      <div class="wrap py-16 space-y-4">
        <div class="mono text-[var(--muted)]">Seguinte</div>
        <div class="display text-[clamp(2.5rem,7vw,7rem)] transition-transform duration-300 group-hover:translate-x-2">
          {nextProject.number} {nextProject.title} →
        </div>
      </div>
    </a>
  </main>

  <Footer />
</Layout>
